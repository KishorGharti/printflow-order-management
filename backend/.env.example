# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Auth ─────────────────────────────────────────────────
# Signs every login token. Use a long random value (at least 16 characters), e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out once. The old default printghar-secret-2026 is refused in production.
API_SECRET_KEY=change-me-to-a-random-secret

# Developer console sign-in (the only account that can open /developer).
DEVELOPER_EMAIL=
DEVELOPER_PASSWORD=

# ─── WhatsApp (Meta Cloud API) ────────────────────────────
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_VERSION=v19.0
# Token you type into Meta when connecting the webhook (any long random text)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
