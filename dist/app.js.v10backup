                      ]),
                      h("p", { className: "font-black text-base mt-3 truncate" }, storageService.getCustomerById(o.customerId)?.businessName || o.customerName),
                      h("p", { className: "text-xs text-rose-100 mt-1 line-clamp-2" }, o.items.map(i => i.productName).join(' • ')),
                      h("div", { className: "mt-3 flex items-center justify-between text-[11px] font-bold text-rose-100" }, [
                        h("span", {}, `${storageService.displayDate(o.dueDate)} · ${o.dueTime || '17:00'} NPT`),
