              h("th", { className: "p-2.5 text-center w-16" }, "Action")
            ])),
            h("tbody", { className: "divide-y divide-slate-100 font-medium" }, pagedExpenses.length ? pagedExpenses.map((exp, index) => {
              const status = exp.paymentStatus || (Number(exp.outstandingAmount || 0) <= 0 ? 'Paid' : Number(exp.paidAmount || 0) > 0 ? 'Partial' : 'Unpaid');
              const statusBadge = status === 'Paid' ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : status === 'Partial' ? 'border-amber-200 bg-amber-50 text-amber-700' : 'border-rose-200 bg-rose-50 text-rose-700';
              return h("tr", { key: exp.id, className: "hover:bg-slate-50 transition-colors" }, [
                h("td", { className: "p-2.5 text-center text-slate-400 font-mono" }, pageStartIndex + index + 1),
                h("td", { className: "p-2.5 font-bold text-slate-700 whitespace-nowrap" }, storageService.formatDateForMode(exp.date, settings.dateMode)),
                h("td", { className: "p-2.5 font-mono font-bold text-indigo-600 whitespace-nowrap" }, h("button", { type: "button", onClick: () => setFinancialExpenseDetails(exp), className: "hover:underline cursor-pointer" }, exp.expenseNumber || expenseNumber(exp))),
                h("td", { className: "p-2.5 font-bold text-slate-900 max-w-[150px] truncate" }, exp.vendor || '—'),
                h("td", { className: "p-2.5 text-slate-600" }, exp.category || '—'),
                h("td", { className: "p-2.5 text-slate-600 max-w-[180px] truncate" }, exp.title || exp.notes || '—'),
                h("td", { className: "p-2.5" }, h("span", { className: "inline-flex rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 text-[9px] font-black text-slate-700" }, exp.paymentMethod || 'Cash')),
                h("td", { className: "p-2.5 text-right font-mono font-black text-slate-900" }, storageService.formatCurrency(exp.amount)),
                h("td", { className: "p-2.5 text-right font-mono font-bold text-emerald-600" }, storageService.formatCurrency(exp.paidAmount || 0)),
                h("td", { className: `p-2.5 text-right font-mono font-bold ${Number(exp.outstandingAmount || 0) > 0 ? 'text-rose-600' : 'text-slate-400'}` }, storageService.formatCurrency(exp.outstandingAmount || 0)),
                h("td", { className: "p-2.5 text-center" }, h("span", { className: `inline-flex rounded-md border px-2 py-0.5 text-[9px] font-black ${statusBadge}` }, status)),
                h("td", { className: "p-2.5 text-slate-600 max-w-[100px] truncate" }, exp.paidBy || '—'),
                h("td", { className: "p-2.5 text-center" }, exp.receipt?.id
                  ? h("button", { type: "button", onClick: () => openExpenseReceipt(exp.receipt, exp.expenseNumber), className: "inline-flex items-center gap-1 rounded-lg border border-indigo-200 bg-indigo-50 px-2 py-1 text-[10px] font-black text-indigo-700 hover:bg-indigo-100 cursor-pointer", title: "View receipt" }, [h(Icon, { name: "receipt", className: "w-3 h-3" }), "View"])
                  : h("span", { className: "text-slate-300" }, "—")),
                h("td", { className: "p-2.5 text-center w-14 min-w-[56px] pr-3 relative whitespace-nowrap" }, h("div", { className: "inline-block text-left" }, [
                  h("button", {
                    type: "button",
                    onClick: (e) => { e.stopPropagation(); setFinancialExpenseActionMenu(cur => cur === exp.id ? null : exp.id); },
                    className: "inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 hover:border-slate-300 text-slate-500 hover:text-slate-800 shadow-2xs transition-colors cursor-pointer",
                    title: "Actions"
                  }, h(Icon, { name: "moreHorizontal", className: "w-4 h-4" })),
                  financialExpenseActionMenu === exp.id && h("div", {
                    className: "absolute right-2 top-8 z-30 w-44 rounded-xl border border-slate-200 bg-white p-1.5 shadow-xl animate-fade-in text-xs font-semibold text-slate-700 text-left",
                    onClick: (e) => e.stopPropagation()
                  }, [
                    h("button", { type: "button", onClick: () => { setFinancialExpenseDetails(exp); setFinancialExpenseActionMenu(null); }, className: "w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-indigo-50 hover:text-indigo-600 flex items-center gap-2 cursor-pointer" }, [h(Icon, { name: "eye", className: "w-3.5 h-3.5 text-indigo-600" }), "View Details"]),
                    h("button", { type: "button", onClick: () => { setEditingExpense(exp); setExpenseCategoryDraft(exp.category || 'Material Stock'); setIsExpenseModalOpen(true); setFinancialExpenseActionMenu(null); }, className: "w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-slate-50 flex items-center gap-2 cursor-pointer" }, [h(Icon, { name: "edit", className: "w-3.5 h-3.5 text-slate-500" }), "Edit Expense"]),
                    Number(exp.outstandingAmount || 0) > 0 && h("button", { type: "button", onClick: () => { openExpensePayment(exp); setFinancialExpenseActionMenu(null); }, className: "w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-emerald-50 text-emerald-700 font-bold flex items-center gap-2 cursor-pointer" }, [h(Icon, { name: "creditCard", className: "w-3.5 h-3.5 text-emerald-600" }), "Pay Credit"]),
                    Boolean(exp.receipt?.id) && h("button", { type: "button", onClick: () => { openExpenseReceipt(exp.receipt, exp.expenseNumber); setFinancialExpenseActionMenu(null); }, className: "w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-indigo-50 text-indigo-700 flex items-center gap-2 cursor-pointer" }, [h(Icon, { name: "receipt", className: "w-3.5 h-3.5 text-indigo-600" }), "View Receipt"]),
                    h("button", {
                      type: "button",
                      onClick: () => {
                        setFinancialExpenseActionMenu(null);
                        if (exp.linkedPurchaseId) {
                          alert(`This expense is linked to stock purchase ${exp.linkedPurchaseId} and cannot be deleted independently from its stock purchase.`);
                          return;
                        }
                        if (confirm(`Delete expense "${exp.title || exp.expenseNumber}"?`)) {
                          storageService.deleteExpense(exp.id);
                          refresh();
                        }
                      },
                      className: "w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-rose-50 text-rose-600 flex items-center gap-2 cursor-pointer"
                    }, [h(Icon, { name: "trash", className: "w-3.5 h-3.5 text-rose-500" }), "Delete"])
                  ])
                ]))
              ]);
            }) : h("tr", {}, h("td", { colSpan: 14, className: "p-8 text-center text-slate-400" }, "No shop expenses recorded yet.")))
          ])),

          // Mobile Compact Rows
          h("div", { className: "md:hidden divide-y divide-slate-100" }, pagedExpenses.length ? pagedExpenses.map((exp) => {
            const status = exp.paymentStatus || (Number(exp.outstandingAmount || 0) <= 0 ? 'Paid' : Number(exp.paidAmount || 0) > 0 ? 'Partial' : 'Unpaid');
            const statusBadge = status === 'Paid' ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : status === 'Partial' ? 'border-amber-200 bg-amber-50 text-amber-700' : 'border-rose-200 bg-rose-50 text-rose-700';
            return h("div", {
              key: exp.id,
              onClick: () => setFinancialExpenseDetails(exp),
              className: "p-3.5 hover:bg-slate-50 transition-colors cursor-pointer space-y-1.5"
            }, [
              h("div", { className: "flex items-center justify-between gap-2" }, [
                h("span", { className: "font-mono text-xs font-black text-indigo-600" }, exp.expenseNumber || expenseNumber(exp)),
                h("span", { className: "text-[10px] font-bold text-slate-500" }, storageService.formatDateForMode(exp.date, settings.dateMode))
              ]),
              h("div", { className: "flex items-center justify-between gap-2" }, [
                h("span", { className: "text-xs font-bold text-slate-900 truncate" }, exp.vendor || exp.title || '—'),
                h("span", { className: `rounded-md border px-2 py-0.5 text-[9px] font-black ${statusBadge}` }, status)
              ]),
              h("div", { className: "flex items-center justify-between gap-2 text-xs pt-0.5" }, [
                h("span", { className: "text-[10px] text-slate-500" }, `Total: ${storageService.formatCurrency(exp.amount)}`),
                h("span", { className: `font-mono font-black ${Number(exp.outstandingAmount || 0) > 0 ? 'text-rose-600' : 'text-slate-400'}` }, `Due: ${storageService.formatCurrency(exp.outstandingAmount || 0)}`)
              ])
            ]);
          }) : h("div", { className: "p-8 text-center text-slate-400 text-xs" }, "No shop expenses recorded yet.")),

          // Standard application pagination
          renderAppPagination({ totalRecords: filteredExpenses.length, pageSize: recordsPerPage, setPageSize: setFinancialExpensePageSize, currentPage: curPage, totalPages: pagesCount, setPage: setFinancialExpensePage })
        ])
      ]);
    };

    // Profile Tab — Enterprise Business Control Center
    // Profile Tab — Topic-Wise Settings Navigation UI
    const renderProfile = () => {
      const todayReport = storageService.getDailyOperationsData(todayStr);
      const todayRev = todayReport.bookedRevenue || todayReport.paidIncome || 0;
      const activeClientsCount = customers.filter(c => !c.isProfileAccount).length;

      // Real team role distribution
      const roleCounts = team.reduce((acc, member) => {
        const role = member.jobTitle?.trim() || 'Team Member';
        acc[role] = (acc[role] || 0) + 1;
        return acc;
      }, {});
      const roleList = Object.entries(roleCounts);

      const topics = [
        { id: 'business-profile', title: 'Business Profile', desc: 'Manage your business information and contact details.', icon: 'profile', badge: settings.shopName || 'Print Ghar' },
        { id: 'financial', title: 'Financial Settings', desc: 'View your financial summary and manage ledger settings.', icon: 'wallet', badge: storageService.formatCurrency(totalIncome) },
        { id: 'numbering', title: 'Invoice & Job Numbering', desc: 'Configure how invoice and job numbers are generated.', icon: 'receipt', badge: `${settings.invoicePrefix || 'INV-'} / ${settings.jobPrefix || 'JOB-'}` },
        { id: 'whatsapp', title: 'WhatsApp Settings', desc: 'Manage WhatsApp message sending and templates.', icon: 'whatsapp', badge: settings.whatsappNotificationsEnabled !== false ? 'Connected' : 'Disabled' },
        { id: 'team', title: 'Team Management', desc: 'Manage team members, roles and permissions.', icon: 'customers', badge: `${team.length} Members` },
        { id: 'branding', title: 'Branding & Theme', desc: 'Customize store branding and appearance.', icon: 'sparkles', badge: settings.appearance === 'dark' ? 'Dark Mode' : 'Light Mode' },
        { id: 'date-appearance', title: 'Date & Appearance', desc: 'Set date format, time zone, currency and language.', icon: 'calendar', badge: settings.dateMode === 'BS' ? 'BS (नेपाली मिति)' : 'AD (Gregorian)' },
        { id: 'reports-archive', title: 'Reports & Archive', desc: 'View daily reports and manage archived data.', icon: 'clock', badge: `${todayReport.dayOrders.length} Orders Today` },
        { id: 'data-safety', title: 'Backup & Data Safety', desc: 'Download a local records backup or restore a previous backup.', icon: 'download', badge: settings.lastDataBackupAt ? 'Backup Ready' : 'Backup Needed' }
      ];

      const currentTopicObj = topics.find(t => t.id === profileTopic);

      const showFeedback = (msg) => {
        setProfileFeedbackMsg(msg);
        setTimeout(() => setProfileFeedbackMsg(''), 3000);
      };

      const backupStorageKeys = [
        STORAGE_KEYS.CUSTOMERS, STORAGE_KEYS.PRODUCTS, STORAGE_KEYS.PRICING, STORAGE_KEYS.ORDERS,
        STORAGE_KEYS.SETTINGS, STORAGE_KEYS.EXPENSES, STORAGE_KEYS.TEAM, STORAGE_KEYS.STOCK,
        STORAGE_KEYS.STOCK_TRANSACTIONS, STORAGE_KEYS.VENDORS, STORAGE_KEYS.DEMO_REMOVED
      ];
      const downloadLocalDataBackup = () => {
        const exportedAt = new Date().toISOString();
        const data = {};
        backupStorageKeys.forEach(key => {
          const raw = localStorage.getItem(key);
          if (raw === null) return;
          try { data[key] = JSON.parse(raw); } catch (_) { data[key] = raw; }
        });
        const payload = {
          app: 'print-ghar-order-manager-backup',
          version: 1,
          exportedAt,
          note: 'Business records backup. Large design/reference attachment blobs stored in IndexedDB are not included.',
          data
        };
        const blob = new Blob([JSON.stringify(payload, null, 2)], { type:'application/json' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        const datePart = getKathmanduDateKey(new Date());
        link.href = url;
        link.download = `Print-Ghar-Records-Backup-${datePart}.json`;
        document.body.appendChild(link); link.click(); link.remove();
        setTimeout(() => URL.revokeObjectURL(url), 500);
        storageService.saveSettings({ ...settings, lastDataBackupAt:exportedAt });
        setSettings(storageService.getSettings());
        showFeedback('✓ Records backup downloaded. Keep the JSON file in a safe location.');
      };
      const restoreLocalDataBackup = () => {
        const picker = document.createElement('input');
        picker.type = 'file'; picker.accept = '.json,application/json';
        picker.onchange = async () => {
          const file = picker.files && picker.files[0];
          if (!file) return;
          try {
            const payload = JSON.parse(await file.text());
            if (payload?.app !== 'print-ghar-order-manager-backup' || !payload?.data || typeof payload.data !== 'object') {
              alert('This file is not a valid Print Ghar records backup.'); return;
            }
            const available = backupStorageKeys.filter(key => Object.prototype.hasOwnProperty.call(payload.data, key));
            if (!available.length) { alert('The backup does not contain restorable Print Ghar records.'); return; }
            if (!confirm(`Restore ${available.length} data sections from this backup? Current browser records in those sections will be replaced.`)) return;
            available.forEach(key => localStorage.setItem(key, JSON.stringify(payload.data[key])));
            alert('Backup restored successfully. Print Ghar will reload now.');
            window.location.reload();
          } catch (error) {
            alert(error?.message || 'Unable to read this backup file.');
          }
        };
        picker.click();
      };

      // 1. MAIN SETTINGS LANDING PAGE (Topic List)
      if (!profileTopic) {
        return h("div", { className: "profile-landing-page space-y-6 max-w-5xl mx-auto animate-fade-in p-2 sm:p-4 lg:p-6" }, [
          // PAGE HEADER
          h("div", { className: "flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2" }, [
            h("div", {}, [
              h("h1", { className: "text-2xl sm:text-3xl font-black tracking-tight text-slate-900" }, "Profile & Business Settings"),
              h("p", { className: "text-xs sm:text-sm font-medium text-slate-500 mt-1" }, "Manage your business information, system settings and preferences.")
            ]),
            h("div", { className: "flex items-center gap-2.5" }, [
              h("button", {
                type: "button",
                onClick: () => setIsShortcutsOpen(true),
                className: "inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-slate-200 bg-white text-xs font-bold text-slate-700 hover:bg-slate-50 hover:border-slate-300 shadow-2xs transition-all cursor-pointer"
              }, [
                h(Icon, { name: "keyboard", className: "w-4 h-4 text-slate-500" }),
                "Keyboard Shortcuts"
              ])
            ])
          ]),

          // QUICK SHOP SUMMARY BAR
          h("div", { className: "bg-white rounded-2xl border border-slate-200 p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xs" }, [
            h("div", { className: "flex items-center gap-3.5" }, [
              h("div", { className: "w-12 h-12 rounded-xl bg-indigo-600 text-white font-black text-xl flex items-center justify-center shadow-xs shrink-0 overflow-hidden" }, [
                settings.shopLogo ? h("img", { src: settings.shopLogo, alt: "Logo", className: "w-full h-full object-contain" }) : "PG"
              ]),
              h("div", {}, [
                h("div", { className: "flex items-center gap-2" }, [
                  h("h3", { className: "text-base font-extrabold text-slate-900" }, settings.shopName || "Print Ghar"),
                  h("span", { className: "inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200" }, [
                    h("span", { className: "w-1.5 h-1.5 rounded-full bg-emerald-500" }),
                    "Active"
                  ])
                ]),
                h("p", { className: "text-xs font-semibold text-slate-500 mt-0.5" }, `${settings.businessCategory || 'Wholesale Printing Platform'} • Owner: ${settings.ownerName || 'Rabin Bista'}`)
              ])
            ]),
            h("div", { className: "flex items-center gap-4 text-xs font-bold text-slate-600 border-t sm:border-t-0 border-slate-100 pt-3 sm:pt-0" }, [
              h("div", { className: "text-center sm:text-right" }, [
                h("div", { className: "text-[10px] uppercase font-bold text-slate-400" }, "Team"),
                h("div", { className: "font-black text-slate-900" }, `${team.length} Members`)
              ]),
              h("div", { className: "h-6 w-px bg-slate-200 hidden sm:block" }),
              h("div", { className: "text-center sm:text-right" }, [
                h("div", { className: "text-[10px] uppercase font-bold text-slate-400" }, "Orders"),
                h("div", { className: "font-black text-slate-900" }, `${orders.length} Total`)
              ]),
              h("div", { className: "h-6 w-px bg-slate-200 hidden sm:block" }),
              h("div", { className: "text-center sm:text-right" }, [
                h("div", { className: "text-[10px] uppercase font-bold text-slate-400" }, "Clients"),
                h("div", { className: "font-black text-slate-900" }, `${activeClientsCount} Active`)
              ])
            ])
          ]),

          // TOPIC LIST
          h("div", { className: "space-y-3" }, [
            h("div", { className: "text-xs font-black uppercase tracking-wider text-slate-400 px-1" }, "Settings Categories"),
            h("div", { className: "grid grid-cols-1 gap-3" }, topics.map((t) => {
              return h("div", {
                key: t.id,
                role: "button",
                tabIndex: 0,
                onClick: () => { setProfileTopic(t.id); window.scrollTo({ top: 0, behavior: 'smooth' }); },
                onKeyDown: (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setProfileTopic(t.id); window.scrollTo({ top: 0, behavior: 'smooth' }); } },
                className: "group bg-white rounded-2xl border border-slate-200 hover:border-indigo-300 hover:shadow-md p-4 sm:p-5 flex items-center justify-between gap-4 transition-all duration-150 cursor-pointer shadow-2xs"
              }, [
                h("div", { className: "flex items-center gap-4 min-w-0" }, [
                  h("div", { className: "w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white flex items-center justify-center shrink-0 transition-colors shadow-2xs" }, [
                    h(Icon, { name: t.icon, className: "w-5 h-5" })
                  ]),
                  h("div", { className: "min-w-0" }, [
                    h("div", { className: "flex items-center gap-2.5 flex-wrap" }, [
                      h("h3", { className: "text-sm sm:text-base font-black text-slate-900 group-hover:text-indigo-600 transition-colors" }, t.title),
                      t.badge && h("span", { className: "inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600 group-hover:bg-indigo-50 group-hover:text-indigo-700 transition-colors truncate max-w-[180px]" }, t.badge)
                    ]),
                    h("p", { className: "text-xs font-medium text-slate-500 mt-0.5 truncate" }, t.desc)
                  ])
                ]),
                h("div", { className: "flex items-center gap-2 shrink-0 text-slate-400 group-hover:text-indigo-600 transition-colors pl-2" }, [
                  h("span", { className: "text-xs font-bold hidden sm:inline text-slate-400 group-hover:text-indigo-600" }, "Configure"),
                  h("span", { className: "text-base font-black group-hover:translate-x-1 transition-transform" }, "→")
                ])
              ]);
            }))
          ])
        ]);
      }

      // 2. DEDICATED TOPIC PAGES (Inner View)
      return h("div", { className: `profile-topic-page ${profileTopic === 'financial' ? 'max-w-[1720px] w-full px-2 sm:px-4 lg:px-6' : 'max-w-7xl p-2 sm:p-4 lg:p-6'} mx-auto animate-fade-in space-y-6` }, [
        // BREADCRUMB & BACK NAVIGATION BAR
        profileTopic !== 'financial' && profileTopic !== 'team' && h("div", { className: "space-y-3 pb-2 border-b border-slate-200" }, [
          h("div", { className: "flex items-center justify-between gap-4" }, [
            h("button", {
              type: "button",
              onClick: () => { setProfileTopic(null); window.scrollTo({ top: 0, behavior: 'smooth' }); },
              className: "inline-flex items-center gap-2 text-xs font-black text-indigo-600 hover:text-indigo-800 bg-indigo-50 hover:bg-indigo-100 px-3.5 py-2 rounded-xl transition-all cursor-pointer shadow-2xs"
            }, [
              h(Icon, { name: "chevronLeft", className: "w-4 h-4" }),
              "Back to Profile & Business"
            ]),
            h("div", { className: "flex items-center gap-2 text-xs font-semibold text-slate-400" }, [
              h("span", {}, "Settings"),
              h("span", {}, "/"),
              h("span", { className: "text-slate-600" }, "Profile & Business"),
              h("span", {}, "/"),
              h("span", { className: "font-black text-indigo-600" }, currentTopicObj?.title || "Topic")
            ])
          ]),
          h("div", { className: "flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 pt-1" }, [
            h("div", {}, [
              h("h1", { className: "text-2xl font-black text-slate-900 flex items-center gap-2.5" }, [
                currentTopicObj?.icon && h(Icon, { name: currentTopicObj.icon, className: "w-6 h-6 text-indigo-600" }),
                currentTopicObj?.title
              ]),
              h("p", { className: "text-xs font-medium text-slate-500 mt-0.5" }, currentTopicObj?.desc)
            ])
          ])
        ]),

        // FEEDBACK TOAST / ALERT
        profileFeedbackMsg && h("div", { className: "p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-black flex items-center gap-2 animate-fade-in" }, [
          h(Icon, { name: "check", className: "w-4 h-4 text-emerald-600" }),
          profileFeedbackMsg
        ]),

        // MAIN CONTENT AREA
        h("div", { className: "grid grid-cols-1 gap-6 items-start" }, [
          h("div", { className: "space-y-6" }, [

            // ==========================================
            // TOPIC 1: BUSINESS PROFILE
            // ==========================================
            profileTopic === 'business-profile' && h("div", { className: "space-y-6" }, [
              h("form", {
                onSubmit: (e) => {
                  e.preventDefault();
                  const f = e.currentTarget;
                  storageService.saveSettings({
                    ...settings,
                    shopName: f.shopName.value.trim() || 'Print Ghar',
                    ownerName: f.ownerName.value.trim() || 'Rabin Bista',
                    businessCategory: f.businessCategory.value.trim() || 'Wholesale Printing Platform',
                    shopPhone: f.shopPhone.value.replace(/\D/g, '') || '9800000000',
                    shopEmail: f.shopEmail.value.trim() || 'hello@printghar.com',
                    shopAddress: f.shopAddress.value.trim() || 'Kathmandu, Nepal'
                  });
                  setSettings(storageService.getSettings());
                  refresh();
                  showFeedback("✓ Business Profile updated successfully!");
                },
                className: "bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-6"
              }, [
                h("div", { className: "flex items-center justify-between border-b border-slate-100 pb-4" }, [
                  h("div", {}, [
                    h("h3", { className: "text-base font-black text-slate-900" }, "Business Details & Contact"),
                    h("p", { className: "text-xs text-slate-500 mt-0.5" }, "These details appear on customer invoices, WhatsApp messages and receipts.")
                  ]),
                  h("span", { className: "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200" }, [
                    h("span", { className: "w-2 h-2 rounded-full bg-emerald-500" }),
                    "Active"
                  ])
                ]),

                h("div", { className: "flex flex-col sm:flex-row sm:items-center gap-4 p-4 rounded-xl bg-slate-50 border border-slate-100" }, [
                  h("div", { className: "w-16 h-16 rounded-2xl bg-indigo-600 text-white font-black text-2xl flex items-center justify-center shadow-md ring-4 ring-indigo-50 shrink-0 overflow-hidden" }, [
                    settings.shopLogo ? h("img", { src: settings.shopLogo, alt: "Logo", className: "w-full h-full object-contain" }) : "PG"
                  ]),
                  h("div", { className: "space-y-1" }, [
                    h("h4", { className: "text-lg font-black text-slate-900" }, settings.shopName || "Print Ghar"),
                    h("p", { className: "text-xs font-medium text-slate-500" }, "To customize or change the store logo, visit the Branding & Theme section."),
                    h("button", {
                      type: "button",
                      onClick: () => setProfileTopic('branding'),
                      className: "text-xs font-bold text-indigo-600 hover:underline cursor-pointer"
                    }, "Change logo in Branding →")
                  ])
                ]),

                h("div", { className: "grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs" }, [
                  h("div", {}, [
                    h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Business Name *"),
                    h("input", { name: "shopName", required: true, defaultValue: settings.shopName || 'Print Ghar', className: "w-full p-2.5 border border-slate-200 rounded-xl text-sm font-bold focus:ring-2 focus:ring-indigo-500 focus:outline-none" })
                  ]),
                  h("div", {}, [
                    h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Business Type / Category *"),
                    h("input", { name: "businessCategory", required: true, defaultValue: settings.businessCategory || 'Wholesale Printing Platform', className: "w-full p-2.5 border border-slate-200 rounded-xl text-sm font-semibold focus:ring-2 focus:ring-indigo-500 focus:outline-none" })
                  ]),
                  h("div", {}, [
                    h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Owner Name *"),
                    h("input", { name: "ownerName", required: true, defaultValue: settings.ownerName || 'Rabin Bista', className: "w-full p-2.5 border border-slate-200 rounded-xl text-sm font-bold focus:ring-2 focus:ring-indigo-500 focus:outline-none" })
                  ]),
                  h("div", {}, [
                    h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Phone Number *"),
                    h("input", { name: "shopPhone", type: "tel", inputMode: "numeric", pattern: "[0-9]*", onInput: e => { e.currentTarget.value = e.currentTarget.value.replace(/\D/g, ''); }, required: true, defaultValue: settings.shopPhone || '9800000000', className: "w-full p-2.5 border border-slate-200 rounded-xl text-sm font-mono focus:ring-2 focus:ring-indigo-500 focus:outline-none" })
                  ]),
                  h("div", {}, [
                    h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Email Address"),
                    h("input", { name: "shopEmail", type: "email", defaultValue: settings.shopEmail || 'hello@printghar.com', className: "w-full p-2.5 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" })
                  ]),
                  h("div", {}, [
                    h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Address"),
                    h("input", { name: "shopAddress", defaultValue: settings.shopAddress || 'Kathmandu, Nepal', className: "w-full p-2.5 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" })
                  ])
                ]),

                h("div", { className: "flex justify-end pt-3 border-t border-slate-100" }, [
                  h("button", {
                    type: "submit",
                    className: "px-6 py-2.5 rounded-xl bg-indigo-600 text-xs font-black text-white hover:bg-indigo-700 shadow-sm transition-all cursor-pointer"
                  }, "Save Changes")
                ])
              ]),

              // BUSINESS METRICS CARD
              h("div", { className: "bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-4" }, [
                h("h3", { className: "text-base font-black text-slate-900" }, "Business Summary Metrics"),
                h("div", { className: "grid grid-cols-2 sm:grid-cols-4 gap-3.5" }, [
                  h("div", { className: "p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1" }, [
                    h("span", { className: "text-[10px] font-bold uppercase tracking-wider text-slate-400 block" }, "Team Members"),
                    h("span", { className: "text-xl font-black text-slate-900 block" }, `${team.length}`)
                  ]),
                  h("div", { className: "p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1" }, [
                    h("span", { className: "text-[10px] font-bold uppercase tracking-wider text-slate-400 block" }, "Total Orders"),
                    h("span", { className: "text-xl font-black text-slate-900 block" }, `${orders.length}`)
                  ]),
                  h("div", { className: "p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1" }, [
                    h("span", { className: "text-[10px] font-bold uppercase tracking-wider text-slate-400 block" }, "Active Clients"),
                    h("span", { className: "text-xl font-black text-slate-900 block" }, `${activeClientsCount}`)
                  ]),
                  h("div", { className: "p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-1" }, [
                    h("span", { className: "text-[10px] font-bold uppercase tracking-wider text-slate-400 block" }, "Master Products"),
                    h("span", { className: "text-xl font-black text-slate-900 block" }, `${masterProducts.length}`)
                  ])
                ])
              ])
            ]),

            // ==========================================
            // TOPIC 2: FINANCIAL SETTINGS
            // ==========================================
            profileTopic === 'financial' && (() => {
              const ledgerData = storageService.getFinancialLedgerData({
                month: financialLedgerMonth,
                search: financialSearch,
                typeFilter: financialTypeFilter,
                designerFilter: financialDesignerFilter,
                dateMode: settings.dateMode
              });

              const availableMonths = (() => {
                const set = new Set();
                ledgerData.allEntries.forEach(entry => { if (entry.monthKey) set.add(entry.monthKey); });
                const todayKey = getKathmanduDateKey();
                const curr = settings.dateMode === 'BS' ? storageService.getADandBSDate(todayKey).bsFormatted.slice(0, 7) : todayKey.slice(0, 7);
                set.add(curr);
                return Array.from(set).sort().reverse();
              })();

              const formatMonthName = (monthKey) => {
                if (!monthKey) return 'All Months';
                const parts = monthKey.split('-');
                if (parts.length !== 2) return monthKey;
                const year = parts[0];
                const m = parseInt(parts[1], 10);
                if (settings.dateMode === 'BS') {
                  const bsNames = ['Baisakh', 'Jestha', 'Ashadh', 'Shrawan', 'Bhadra', 'Ashwin', 'Kartik', 'Mangsir', 'Poush', 'Magh', 'Falgun', 'Chaitra'];
                  return `${bsNames[m - 1] || 'Month ' + m} ${year} (${monthKey})`;
                } else {
                  const adNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
                  return `${adNames[m - 1] || 'Month ' + m} ${year}`;
                }
              };

              const entryMatchesFinancialRange = entry => {
                if (financialDateRange === 'ALL') return true;
                if (entry.type === 'opening') return financialDateRange === 'FIRST_HALF';
                const day = Number(String(entry.monthKey === financialLedgerMonth ? (settings.dateMode === 'BS' ? storageService.getADandBSDate(entry.date).bsFormatted : entry.date) : entry.date).slice(8, 10));
                return financialDateRange === 'FIRST_HALF' ? day <= 15 : day >= 16;
              };
              const dateFilteredEntries = ledgerData.visibleEntries.filter(entryMatchesFinancialRange);
              const recordsPerPage = Number(financialPageSize) || 50;
              const totalLedgerPages = Math.max(1, Math.ceil(dateFilteredEntries.length / recordsPerPage));
              const currentLedgerPage = Math.min(financialPage, totalLedgerPages);
              const pageStart = (currentLedgerPage - 1) * recordsPerPage;
              const pagedLedgerEntries = dateFilteredEntries.slice(pageStart, pageStart + recordsPerPage);
              const generatePaginationPages = (cur, total) => {
                if (total <= 1) return [];
                if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
                if (cur <= 3) return [1, 2, 3, 4, '...', total];
                if (cur >= total - 2) return [1, '...', total - 3, total - 2, total - 1, total];
                return [1, '...', cur - 1, cur, cur + 1, '...', total];
              };

              const renderTableFooter = ({ totalRecords, pageSize, setPageSize, currentPage, totalPages, setPage }) => {
                if (Number(totalRecords || 0) < 20) return null;
                const start = (currentPage - 1) * pageSize;
                const isSinglePage = totalPages <= 1;
                const pages = generatePaginationPages(currentPage, totalPages);

                return h("div", { className: "flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-t border-slate-200 bg-slate-50/70 px-4 py-2.5 text-xs select-none" }, [
                  // Left: Showing X-Y of Z records + [20 per page ▼]
                  h("div", { className: "flex items-center gap-3" }, [
                    h("span", { className: "text-[11px] font-bold text-slate-500 whitespace-nowrap" },
                      totalRecords > 0
                        ? `Showing ${start + 1}–${Math.min(start + pageSize, totalRecords)} of ${totalRecords} records`
                        : "Showing 0 of 0 records"
                    ),
                    h("select", {
                      value: pageSize,
                      onChange: (e) => {
                        setPageSize(Number(e.target.value));
                        setPage(1);
                      },
                      className: "px-2 py-1 border border-slate-200 rounded-lg text-[11px] font-bold bg-white text-slate-700 shadow-2xs focus:outline-none cursor-pointer"
                    }, [
                      h("option", { value: 20 }, "20 per page"),
                      h("option", { value: 50 }, "50 per page"),
                      h("option", { value: 100 }, "100 per page")
                    ])
                  ]),

                  // Right: Pagination controls
                  isSinglePage
                    ? h("div", { className: "flex items-center gap-1" }, [
                        h("button", {
                          type: "button",
                          disabled: true,
                          className: "rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold text-slate-300 opacity-40 cursor-not-allowed select-none"
                        }, "←"),
                        h("span", { className: "px-2.5 py-1 text-xs font-bold text-slate-500 select-none" }, "1 / 1"),
                        h("button", {
                          type: "button",
                          disabled: true,
                          className: "rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold text-slate-300 opacity-40 cursor-not-allowed select-none"
                        }, "→")
                      ])
                    : h("div", { className: "flex items-center gap-1" }, [
                        h("button", {
                          type: "button",
                          disabled: currentPage === 1,
                          onClick: () => setPage(p => Math.max(1, p - 1)),
                          className: `rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-bold shadow-2xs transition-colors select-none ${
                            currentPage === 1
                              ? 'bg-slate-50 text-slate-300 opacity-40 cursor-not-allowed'
                              : 'bg-white text-slate-600 hover:bg-slate-50 cursor-pointer'
                          }`
                        }, "←"),
                        ...pages.map((p, idx) => {
                          if (p === '...') {
                            return h("span", { key: `ellipsis-${idx}`, className: "px-1.5 text-xs font-bold text-slate-400 select-none" }, "…");
                          }
                          const isCurrent = p === currentPage;
                          return h("button", {
                            key: p,
                            type: "button",
                            onClick: () => setPage(p),
                            className: `h-7 min-w-7 px-2 rounded-lg text-xs font-black shadow-2xs transition-colors cursor-pointer select-none ${
                              isCurrent
                                ? 'bg-indigo-600 text-white shadow-2xs'
                                : 'border border-slate-200 bg-white text-slate-600 hover:bg-slate-50'
                            }`
                          }, p);
                        }),
                        h("button", {
                          type: "button",
                          disabled: currentPage === totalPages,
                          onClick: () => setPage(p => Math.min(totalPages, p + 1)),
                          className: `rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-bold shadow-2xs transition-colors select-none ${
                            currentPage === totalPages
                              ? 'bg-slate-50 text-slate-300 opacity-40 cursor-not-allowed'
                              : 'bg-white text-slate-600 hover:bg-slate-50 cursor-pointer'
                          }`
                        }, "→")
                      ])
                ]);
              };

              const formatMoneyNPR = (val) => {
                if (val === undefined || val === null || val === '—' || val === '') return '—';
                const num = Number(val);
                if (isNaN(num)) return '—';
                return num.toLocaleString('en-IN', { maximumFractionDigits: 2 });
              };

              const renderTypeBadge = (type) => {
                if (type === 'opening') return h("span", { className: "inline-flex items-center px-1.5 py-0.5 rounded text-[9.5px] font-bold bg-slate-100 text-slate-700 border border-slate-200 whitespace-nowrap" }, "Opening");
                if (type === 'job') return h("span", { className: "inline-flex items-center px-1.5 py-0.5 rounded text-[9.5px] font-bold bg-blue-50 text-blue-700 border border-blue-200 whitespace-nowrap" }, "Job");
                if (type === 'expense') return h("span", { className: "inline-flex items-center px-1.5 py-0.5 rounded text-[9.5px] font-bold bg-rose-50 text-rose-700 border border-rose-200 whitespace-nowrap" }, "Expense");
                if (type === 'stocking') return h("span", { className: "inline-flex items-center px-1.5 py-0.5 rounded text-[9.5px] font-bold bg-purple-50 text-purple-700 border border-purple-200 whitespace-nowrap" }, "Stocking");
                if (type === 'payment') return h("span", { className: "inline-flex items-center px-1.5 py-0.5 rounded text-[9.5px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 whitespace-nowrap" }, "Credit Received");
                if (type === 'credit-paid') return h("span", { className: "inline-flex items-center px-1.5 py-0.5 rounded text-[9.5px] font-bold bg-orange-50 text-orange-700 border border-orange-200 whitespace-nowrap" }, "Credit Payment");
                return h("span", { className: "inline-flex items-center px-1.5 py-0.5 rounded text-[9.5px] font-bold bg-slate-50 text-slate-700 border border-slate-200 whitespace-nowrap" }, type);
              };

              const renderPaymentBadge = (method) => {
                if (!method || method === '—') return h("span", { className: "text-slate-400 font-medium text-[11px]" }, "—");
                const m = String(method).toLowerCase();
                if (m === 'cash' || m === 'pay') return h("span", { className: "inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 whitespace-nowrap" }, "Cash");
                if (m === 'online') return h("span", { className: "inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-blue-50 text-blue-700 border border-blue-200 whitespace-nowrap" }, "Online");
                if (m === 'credit') return h("span", { className: "inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-50 text-amber-800 border border-amber-200 whitespace-nowrap" }, "Credit");
                if (m === 'bank') return h("span", { className: "inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-violet-50 text-violet-700 border border-violet-200 whitespace-nowrap" }, "Bank");
                if (m === 'partial') return h("span", { className: "inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-purple-50 text-purple-700 border border-purple-200 whitespace-nowrap" }, "Partial");
                return h("span", { className: "inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-slate-50 text-slate-700 border border-slate-200 whitespace-nowrap" }, method);
              };

              const renderStatusBadge = (status) => {
                if (!status || status === '—') return h("span", { className: "text-slate-400 font-medium text-[11px]" }, "—");
                const s = String(status).toLowerCase();
                if (s === 'paid') return h("span", { className: "inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 whitespace-nowrap" }, "Paid");
                if (s === 'unpaid' || s === 'credit') return h("span", { className: "inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-rose-50 text-rose-700 border border-rose-200 whitespace-nowrap" }, "Unpaid");
                if (s === 'partial') return h("span", { className: "inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-orange-50 text-orange-700 border border-orange-200 whitespace-nowrap" }, "Partial");
                return h("span", { className: "inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-slate-50 text-slate-700 border border-slate-200 whitespace-nowrap" }, status);
              };

              const renderAllTransactionsTable = () => {
                const dash = () => h("span", { className:"text-slate-300 font-normal" }, "—");
                const totalOf = getter => dateFilteredEntries.reduce((sum, entry) => sum + Number(getter(entry) || 0), 0);
                const toggleJobProducts = entryId => setExpandedFinancialJobs(current => current.includes(entryId) ? current.filter(id => id !== entryId) : [...current, entryId]);
                const actionFor = entry => {
                  if (entry.receipt) return h("button", { type:"button", onClick:()=>openExpenseReceipt(entry.receipt,`Receipt: ${entry.jobNo}`), className:"inline-flex h-7 w-7 items-center justify-center rounded-lg border border-indigo-200 bg-indigo-50 text-indigo-700 hover:bg-indigo-100 cursor-pointer", title:"View receipt" }, h(Icon,{name:"fileText",className:"h-3.5 w-3.5"}));
                  if (entry.type === 'job') return h("button", { type:"button", onClick:()=>{const job=orders.find(order=>order.orderNumber===entry.jobNo);if(job)setSelectedOrder(job);}, className:"inline-flex h-7 w-7 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 hover:border-indigo-300 hover:text-indigo-700 cursor-pointer", title:"Open job" }, h(Icon,{name:"eye",className:"h-3.5 w-3.5"}));
                  if (['expense','stocking','credit-paid'].includes(entry.type)) return h("button", { type:"button", onClick:()=>{const exp=expenses.find(item=>item.id===entry.sourceId||item.linkedPurchaseId===entry.jobNo);if(exp)setFinancialExpenseDetails(exp);}, className:"inline-flex h-7 w-7 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 hover:border-indigo-300 hover:text-indigo-700 cursor-pointer", title:"View details" }, h(Icon,{name:"moreHorizontal",className:"h-3.5 w-3.5"}));
                  return dash();
                };
                const bodyRows = pagedLedgerEntries.flatMap((entry,entryIndex) => {
                  const jobItems = entry.type === 'job' && Array.isArray(entry.items) ? entry.items : [];
                  const hasMultipleProducts = jobItems.length > 1;
                  const productsExpanded = hasMultipleProducts && expandedFinancialJobs.includes(entry.id);
                  const itemRows = jobItems.length ? (hasMultipleProducts && !productsExpanded ? [null] : jobItems) : [null];
                  const rowSpan = itemRows.length;
                  const isOpening = entry.type === 'opening';
                  const credit = Number(entry.billedAmount || entry.drAmount || 0);
                  const received = Number(entry.crAmount || 0);
                  const receivingOutstanding = entry.type === 'job' ? Number(entry.outstandingCredit || 0) : 0;
                  const payingOutstanding = ['expense','stocking','credit-paid'].includes(entry.type) ? Number(entry.outstandingCredit || 0) : 0;
                  const commonCell = (content,classes="",extra={}) => h("td", { rowSpan, className:`px-2 py-3 align-top ${classes}`, ...extra }, content);
                  return itemRows.map((item,itemIndex) => {
                    const first = itemIndex === 0;
                    const quantity = item ? Number(item.quantity || 0) : Number(entry.pcs || entry.quantity || 0);
                    const unit = item ? (item.unit || 'pcs') : (entry.unit || (entry.type === 'job' ? 'pcs' : ''));
                    const itemAmount = item ? Number(item.lineTotal ?? (Number(item.quantity || 0) * Number(item.unitPrice || item.price || 0))) : Number(entry.amount || 0);
                    const itemDetails = item ? `${itemIndex + 1}. ${item.productName || 'Print Item'}${item.itemDescription ? ` — ${item.itemDescription}` : ''}` : (entry.details || '—');
                    const productPreview = jobItems.slice(0, 2).map(product => product.productName || 'Print Item').join(' • ');
                    const productDetails = hasMultipleProducts && !productsExpanded ? h("button", {
                      type:"button",
                      onClick:()=>toggleJobProducts(entry.id),
                      "aria-expanded":"false",
                      "aria-label":`Show all ${jobItems.length} products for ${entry.jobNo}`,
                      className:"group flex w-full items-center justify-between gap-2 rounded-lg border border-indigo-200 bg-indigo-50/80 px-2.5 py-2 text-left transition-colors hover:border-indigo-400 hover:bg-indigo-100 cursor-pointer"
                    }, [
                      h("span", { className:"min-w-0" }, [
                        h("span", { className:"block font-black text-slate-900" }, `${jobItems.length} products in this job`),
                        h("span", { className:"mt-0.5 block truncate text-[9px] font-semibold text-slate-500" }, `${productPreview}${jobItems.length > 2 ? ` +${jobItems.length - 2} more` : ''}`)
                      ]),
                      h("span", { className:"inline-flex shrink-0 items-center gap-1 rounded-full bg-white px-2 py-1 text-[9px] font-black text-indigo-700 shadow-sm" }, ["View all", h(Icon,{name:"chevronDown",className:"h-3 w-3"})])
                    ]) : h("div", { className:"space-y-1.5" }, [
                      hasMultipleProducts && first ? h("button", {
                        type:"button",
                        onClick:()=>toggleJobProducts(entry.id),
                        "aria-expanded":"true",
                        "aria-label":`Hide products for ${entry.jobNo}`,
                        className:"inline-flex items-center gap-1 rounded-full border border-indigo-200 bg-indigo-50 px-2 py-1 text-[9px] font-black text-indigo-700 hover:bg-indigo-100 cursor-pointer"
                      }, ["Hide products", h(Icon,{name:"chevronDown",className:"h-3 w-3 rotate-180"})]) : null,
                      h("span", { className:"block" }, itemDetails)
                    ]);
                    const metadata = first ? [
                      commonCell(pageStart+entryIndex+1,"text-center font-mono text-slate-500"),
                      commonCell(storageService.formatDateForMode(entry.date,settings.dateMode),"font-semibold text-slate-700 whitespace-nowrap"),
                      commonCell(isOpening?dash():entry.jobNo,"font-mono font-bold text-indigo-700 whitespace-nowrap"),
                      commonCell(renderTypeBadge(entry.type),"text-center"),
                      commonCell(isOpening?dash():renderPaymentBadge(entry.payment),"text-center"),
                      commonCell(isOpening?dash():renderStatusBadge(entry.status),"text-center"),
                      commonCell(isOpening?dash():(entry.partyName||'—'),"font-bold text-slate-900")
                    ] : [];
                    const financial = first ? [
                      commonCell(credit>0?formatMoneyNPR(credit):dash(),"text-right font-mono font-black text-[#9C0006] whitespace-nowrap"),
                      commonCell(received>0?formatMoneyNPR(received):dash(),"text-right font-mono font-black text-[#006100] whitespace-nowrap"),
                      commonCell(receivingOutstanding>0?h("span",{className:"inline-flex rounded-md bg-[#FFC7CE] px-1.5 py-1 text-[#9C0006]"},formatMoneyNPR(receivingOutstanding)):dash(),"text-right font-mono font-black whitespace-nowrap"),
                      commonCell(payingOutstanding>0?h("span",{className:"inline-flex rounded-md bg-[#FFEB9C] px-1.5 py-1 text-[#9C6500]"},formatMoneyNPR(payingOutstanding)):dash(),"text-right font-mono font-black whitespace-nowrap"),
                      commonCell(formatMoneyNPR(entry.cashRunningBalance),`text-right font-mono font-black whitespace-nowrap ${Number(entry.cashRunningBalance||0)>=0?'text-emerald-700':'text-rose-700'}`),
                      commonCell(formatMoneyNPR(entry.bankRunningBalance),`text-right font-mono font-black whitespace-nowrap ${Number(entry.bankRunningBalance||0)>=0?'text-indigo-700':'text-rose-700'}`),
                      commonCell(isOpening?dash():(entry.designer||'—'),"font-semibold text-slate-600"),
                      commonCell(isOpening?dash():(entry.printing||'—'),"font-semibold text-slate-600"),
                      commonCell(isOpening?dash():(entry.mistakeBy||'—'),"font-semibold text-slate-600"),
                      commonCell(actionFor(entry),"text-center")
                    ] : [];
                    return h("tr", { key:`${entry.id}-${itemIndex}`, className:`${itemIndex===rowSpan-1?'border-b-2 border-slate-200':''} ${entryIndex%2===1?'bg-slate-50/55':'bg-white'} ${hasMultipleProducts?'border-l-2 border-l-indigo-300':''} hover:bg-indigo-50/65 transition-colors` }, [
                      ...metadata,
                      h("td", { className:"px-3 py-3 align-top font-semibold leading-4 text-slate-700" }, productDetails),
                      h("td", { className:"px-2 py-3 align-top text-right font-mono font-semibold text-slate-700 whitespace-nowrap" }, hasMultipleProducts&&!productsExpanded?`${jobItems.length} lines`:quantity>0?`${quantity.toLocaleString('en-IN')} ${unit}`:dash()),
                      h("td", { className:"px-2 py-3 align-top text-right font-mono font-bold text-slate-900 whitespace-nowrap" }, itemAmount>0?formatMoneyNPR(itemAmount):dash()),
                      ...financial
                    ]);
                  });
                });
                const headerMain = [
                  ["S.N.",2],[`Date (${settings.dateMode || 'AD'})`,2],["Invoice / Ref",2],["Transaction",2],["Payment Method",2],["Status",2],["Party / Vendor",2],["Products / Details",2],["Qty / Unit",2],["Amount",2],["Billed / Outflow",2],["Money In",2]
                ];
                return h("div", { className:"financial-desktop-ledger all-transactions-ledger bg-white" }, [
                  h("table", { className:"min-w-[1776px] table-fixed border-collapse text-[10px]" }, [
                    h("colgroup", {}, [34,86,80,130,95,65,110,190,80,80,86,80,90,80,90,90,70,80,90,70].map((width,index)=>h("col",{key:index,style:{width:`${width}px`}}))),
                    h("thead", { className:"sticky top-0 z-10 bg-slate-50 text-slate-600 shadow-[0_1px_0_rgba(148,163,184,.45)]" }, [
                      h("tr", { className:"border-b border-slate-300" }, [
                        ...headerMain.map(([label,rowSpan])=>h("th",{key:label,rowSpan,className:`px-2 py-3 text-center font-black whitespace-normal ${label==='Products / Details'||label==='Party / Vendor'?'text-left':''}`},label)),
                        h("th", { colSpan:2, className:"px-2 pt-3 pb-1 text-center font-black" }, "Credit Outstanding"),
                        h("th", { colSpan:2, className:"px-2 pt-3 pb-1 text-center font-black border-l border-slate-300" }, "Running Balance"),
                        ...[["Designer",2],["Printed by",2],["Mistake by",2],["Action",2]].map(([label,rowSpan])=>h("th",{key:label,rowSpan,className:"px-2 py-3 text-center font-black align-middle"},label==='Printed by'?h("span",{className:"inline-block leading-tight"},["Printed",h("br",{}),"By"]):label==='Mistake by'?h("span",{className:"inline-block leading-tight"},["Mistake",h("br",{}),"By"]):label))
                      ]),
                      h("tr", { className:"border-b border-slate-300" }, [
                        h("th", { className:"border-l border-slate-300 px-1 pb-2 pt-1 text-center text-[9px] font-black text-[#9C0006]" }, "Receivable"),
                        h("th", { className:"border-x border-slate-300 px-1 pb-2 pt-1 text-center text-[9px] font-black text-[#9C6500]" }, "Payable"),
                        h("th", { className:"border-l border-slate-300 px-1 pb-2 pt-1 text-center text-[9px] font-black text-emerald-700 bg-emerald-50/60" }, "Cash"),
                        h("th", { className:"border-x border-slate-300 px-1 pb-2 pt-1 text-center text-[9px] font-black text-indigo-700 bg-indigo-50/60" }, "Bank")
                      ])
                    ]),
                    h("tbody", { className:"bg-white" }, bodyRows.length?bodyRows:h("tr",{},h("td",{colSpan:20,className:"py-12 text-center font-semibold text-slate-400"},"No transactions found for the selected criteria."))),
                    h("tfoot", { className:"bg-black/10 font-black text-slate-950" }, h("tr", { className:"border-t-4 border-double border-slate-600 font-black" }, [
                      h("td", { colSpan:9, className:"px-3 py-3 text-center font-black uppercase tracking-wider" }, "Total"),
                      h("td", { className:"px-2 py-3 text-right font-mono font-black" }, formatMoneyNPR(totalOf(entry=>entry.amount))),
                      h("td", { className:"px-2 py-3 text-right font-mono font-black text-[#9C0006]" }, formatMoneyNPR(totalOf(entry=>entry.billedAmount||entry.drAmount))),
                      h("td", { className:"px-2 py-3 text-right font-mono font-black text-[#006100]" }, formatMoneyNPR(totalOf(entry=>entry.crAmount))),
                      h("td", { className:"px-2 py-3 text-right font-mono font-black text-[#9C0006]" }, formatMoneyNPR(totalOf(entry=>entry.type==='job'?entry.outstandingCredit:0))),
                      h("td", { className:"px-2 py-3 text-right font-mono font-black text-[#9C6500]" }, formatMoneyNPR(totalOf(entry=>['expense','stocking','credit-paid'].includes(entry.type)?entry.outstandingCredit:0))),
                      h("td", { className:"px-2 py-3 text-right font-mono font-black text-emerald-800" }, dateFilteredEntries.length?formatMoneyNPR(dateFilteredEntries[dateFilteredEntries.length-1].cashRunningBalance):formatMoneyNPR(ledgerData.periodOpeningCashBalance||0)),
                      h("td", { className:"px-2 py-3 text-right font-mono font-black text-indigo-800" }, dateFilteredEntries.length?formatMoneyNPR(dateFilteredEntries[dateFilteredEntries.length-1].bankRunningBalance):formatMoneyNPR(ledgerData.periodOpeningBankBalance||0)),
                      h("td", { colSpan:4 }, "")
                    ]))
                  ])
                ]);
              };

              const showFinancialOutstanding = financialTypeFilter !== 'PAYMENT';
              const showBilledOutflow = financialTypeFilter !== 'PAYMENT';

              const expenseEntries = ledgerData.periodEntries.filter(entry => entry.type === 'expense');
              const periodExpenseObjects = expenseEntries.map(entry => {
                const exp = expenses.find(e => e.id === entry.sourceId);
                return exp || {
                  id: entry.sourceId || entry.id,
                  expenseNumber: entry.jobNo,
                  date: entry.date,
                  vendor: entry.partyName,
                  category: entry.category,
                  title: entry.details,
                  notes: entry.notes,
                  paymentMethod: entry.payment,
                  paymentStatus: entry.status || 'Paid',
                  amount: entry.grossAmount || 0,
                  paidAmount: entry.status === 'Credit' ? 0 : (entry.grossAmount || 0),
                  outstandingAmount: entry.status === 'Credit' ? (entry.grossAmount || 0) : 0,
                  paidBy: entry.paidBy
                };
              });
              const totalExpensesAmount = periodExpenseObjects.reduce((sum, e) => sum + Number(e.amount || 0), 0);
              const paidExpensesAmount = periodExpenseObjects.reduce((sum, e) => sum + Number(e.paidAmount || 0), 0);
              const outstandingCreditAmount = periodExpenseObjects.reduce((sum, e) => sum + Number(e.outstandingAmount || 0), 0);
              const expenseCategories = Array.from(new Set(periodExpenseObjects.map(e => e.category).filter(Boolean))).sort();
              const expenseMethods = ['Cash', 'Online', 'Bank', 'Credit'];

              const filteredExpenseEntries = periodExpenseObjects.filter(exp => {
                const query = financialExpenseSearch.trim().toLowerCase();
                if (query && ![exp.expenseNumber, exp.vendor, exp.title, exp.category, exp.notes, exp.paidBy].some(value => String(value || '').toLowerCase().includes(query))) return false;
                if (financialExpenseCategory !== 'ALL' && exp.category !== financialExpenseCategory) return false;
                if (financialExpenseStatus !== 'ALL' && exp.paymentStatus !== financialExpenseStatus) return false;
                if (financialExpenseMethod !== 'ALL' && exp.paymentMethod !== financialExpenseMethod) return false;
                if (!entryMatchesFinancialRange(exp)) return false;
                return true;
              });
              const expenseRecordsPerPage = Number(financialExpensePageSize) || 50;
              const expensePages = Math.max(1, Math.ceil(filteredExpenseEntries.length / expenseRecordsPerPage));
              const currentExpensePage = Math.min(financialExpensePage, expensePages);
              const expenseStart = (currentExpensePage - 1) * expenseRecordsPerPage;
              const pagedExpenseEntries = filteredExpenseEntries.slice(expenseStart, expenseStart + expenseRecordsPerPage);

              const stockingEntries = ledgerData.periodEntries.filter(entry => entry.type === 'stocking');
              const stockingVendors = Array.from(new Set(stockingEntries.map(entry => entry.partyName).filter(Boolean))).sort();
              const stockingTypes = Array.from(new Set(stockingEntries.map(entry => entry.category).filter(Boolean))).sort();
              const filteredStockingEntries = stockingEntries.filter(entry => {
                const query = financialStockSearch.trim().toLowerCase();
                if (query && ![entry.jobNo, entry.partyName, entry.details, entry.category, entry.notes].some(value => String(value || '').toLowerCase().includes(query))) return false;
                if (financialStockVendor !== 'ALL' && entry.partyName !== financialStockVendor) return false;
                if (financialStockType !== 'ALL' && entry.category !== financialStockType) return false;
                if (!entryMatchesFinancialRange(entry)) return false;
                return true;
              });
              const stockingRecordsPerPage = Number(financialStockPageSize) || 50;
              const stockingPages = Math.max(1, Math.ceil(filteredStockingEntries.length / stockingRecordsPerPage));
              const currentStockingPage = Math.min(financialStockPage, stockingPages);
              const stockingStart = (currentStockingPage - 1) * stockingRecordsPerPage;
              const pagedStockingEntries = filteredStockingEntries.slice(stockingStart, stockingStart + stockingRecordsPerPage);

              return h("div", { className: "space-y-6" }, [
                // Header: Title & Month Selector
                h("div", { className: "flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-200 pb-5" }, [
                  h("div", {}, [
                    h("div", { className: "mb-2 flex items-center gap-1.5 text-[11px] font-bold text-slate-400" }, [
                      h("button", { type: "button", onClick: () => setProfileTopic(null), className: "hover:text-indigo-600 cursor-pointer" }, "Settings"),
                      h("span", {}, ">"),
                      h("span", { className: "text-slate-600" }, "Financial Settings")
                    ]),
                    h("h1", { className: "text-2xl font-black tracking-tight text-slate-950" }, "Financial Settings"),
                    h("p", { className: "text-xs text-slate-500 mt-1" }, "Track your income, expenses and manage your business ledger.")
                  ]),
                  h("label", { className: "block" }, [
                    h("span", { className: "mb-1 block text-[9px] font-black uppercase tracking-wider text-slate-400" }, "Ledger month"),
                    h("select", {
                      value: financialLedgerMonth,
                      onChange: (e) => setFinancialLedgerMonth(e.target.value),
                      className: "min-w-[180px] px-3 py-2.5 border border-slate-200 rounded-xl text-xs font-black bg-white text-slate-800 shadow-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none cursor-pointer"
                    }, [
                      ...availableMonths.map(m => h("option", { key: m, value: m }, formatMonthName(m)))
                    ])
                  ])
                ]),

                // ── 6 MONTHLY SUMMARY KPI CARDS (Only visible when NOT on Summary tab) ──
                financialSubTab !== 'summary' && (() => {
                  const pJobs = ledgerData.periodEntries.filter(e => e.type === 'job');
                  const pExps = ledgerData.periodEntries.filter(e => e.type === 'expense');
                  const pStock = ledgerData.periodEntries.filter(e => e.type === 'stocking');
                  const bsIncome = pJobs.reduce((s, e) => s + Number(e.orderTotal ?? (Number(e.crAmount || 0) + Number(e.outstandingCredit || 0))), 0);
                  const bsExpenses = pExps.reduce((s, e) => s + Number(e.drAmount || 0), 0);
                  const bsStock = pStock.reduce((s, e) => s + Number(e.drAmount || 0), 0);
                  const bsCredRec = pJobs.reduce((s, e) => s + Number(e.outstandingCredit || 0), 0);
                  const bsCredPay = [...pExps, ...pStock].reduce((s, e) => s + Number(e.outstandingCredit || 0), 0);
                  const bsClosing = ledgerData.currentBalance;

                  return h("div", { className: "grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 animate-fade-in" }, [
                    { label: 'TOTAL INCOME', value: bsIncome, subtext: `${pJobs.length} job${pJobs.length !== 1 ? 's' : ''}`, border: 'border-emerald-200', bg: 'bg-emerald-50/40', dot: 'bg-emerald-500', text: 'text-emerald-700' },
                    { label: 'TOTAL EXPENSES', value: bsExpenses, subtext: 'operating costs', border: 'border-rose-200', bg: 'bg-rose-50/40', dot: 'bg-rose-500', text: 'text-rose-700' },
                    { label: 'STOCK PURCHASES', value: bsStock, subtext: 'materials & inventory', border: 'border-purple-200', bg: 'bg-purple-50/40', dot: 'bg-purple-500', text: 'text-purple-700' },
                    { label: 'CREDIT TO RECEIVE', value: bsCredRec, subtext: 'customer Udaro due', border: 'border-amber-200', bg: 'bg-amber-50/40', dot: 'bg-amber-500', text: 'text-amber-700' },
                    { label: 'CREDIT TO PAY', value: bsCredPay, subtext: 'supplier outstanding', border: 'border-orange-200', bg: 'bg-orange-50/40', dot: 'bg-orange-500', text: 'text-orange-700' },
                    { label: 'CLOSING BALANCE', value: bsClosing, subtext: 'net position', border: 'border-indigo-200', bg: 'bg-indigo-50/40', dot: 'bg-indigo-500', text: 'text-indigo-700' }
                  ].map(c => h("div", { key: c.label, className: `p-3.5 rounded-2xl border ${c.border} ${c.bg} shadow-2xs relative` }, [
                    h("div", { className: "flex items-center justify-between gap-1" }, [
                      h("span", { className: "text-[9px] font-black uppercase tracking-wider text-slate-500 truncate" }, c.label),
                      h("span", { className: `w-2 h-2 rounded-full ${c.dot} shrink-0` })
                    ]),
                    h("div", { className: `mt-1.5 font-mono text-base font-black truncate ${c.text}` }, storageService.formatCurrency(c.value)),
                    h("p", { className: "text-[10px] text-slate-400 font-medium truncate mt-0.5" }, c.subtext)
                  ])));
                })(),

                // ── 7 TRANSACTION TABS (Summary moved to last) ────────────────────
                h("div", { role: "tablist", "aria-label": "Financial transaction views", className: "flex items-center gap-1 overflow-x-auto" }, (() => {
                  const txTabs = [
                    { id: 'ledger',    typeVal: 'ALL',         label: 'All Transactions' },
                    { id: 'ledger',    typeVal: 'JOB',         label: 'Jobs (Income)' },
                    { id: 'expenses',  typeVal: 'EXPENSE',     label: 'Expenses' },
                    { id: 'stocking',  typeVal: 'STOCKING',    label: 'Stocking / Purchase' },
                    { id: 'ledger',    typeVal: 'PAYMENT',     label: 'Credit Receipts' },
                    { id: 'ledger',    typeVal: 'CREDIT_PAID', label: 'Credit Payments' },
                    { id: 'summary',   typeVal: 'SUMMARY',     label: 'Summary' }
                  ];
                  return txTabs.map((tab, i) => {
                    const isActive = financialSubTab === tab.id && (tab.id !== 'ledger' || financialTypeFilter === tab.typeVal);
                    return h("button", {
                      key: `tx-${i}`,
                      type: "button",
                      role: "tab",
                      "aria-selected": isActive,
                      onClick: () => {
                        setFinancialSubTab(tab.id);
                        if (tab.id === 'ledger') setFinancialTypeFilter(tab.typeVal);
                        else if (tab.id === 'expenses') {
                          setFinancialTypeFilter('EXPENSE');
                          setFinancialExpenseCategory('ALL');
                          setFinancialExpenseStatus('ALL');
                          setFinancialExpenseMethod('ALL');
                        } else if (tab.id === 'stocking') {
                          setFinancialTypeFilter('STOCKING');
                          setFinancialStockVendor('ALL');
                          setFinancialStockType('ALL');
                        }
                        setFinancialPage(1);
                      },
                      className: `px-3.5 py-2 rounded-xl text-xs font-black whitespace-nowrap transition-all cursor-pointer ${
                        isActive
                          ? 'bg-indigo-600 text-white shadow-xs'
                          : 'bg-white hover:bg-slate-50 text-slate-600 border border-slate-200'
                      }`
                    }, tab.label);
                  });
                })()),

                // ── SUMMARY SUB-TAB (Comprehensive Breakdowns) ───────────────────
                financialSubTab === 'summary' && (() => {
                  const jobs = ledgerData.periodEntries.filter(entry => entry.type === 'job');
                  const costs = ledgerData.periodEntries.filter(entry => entry.type === 'expense' || entry.type === 'stocking');
                  const totalWork = jobs.reduce((sum, entry) => sum + Number(entry.orderTotal || 0), 0);
                  const directReceived = jobs.reduce((sum, entry) => sum + Number(entry.crAmount || 0), 0);
                  const creditReceivedEntries = ledgerData.periodEntries.filter(entry => entry.type === 'payment');
                  const creditReceived = creditReceivedEntries.reduce((sum, entry) => sum + Number(entry.receivedCredit || entry.crAmount || 0), 0);
                  const creditRemainingJobs = jobs.filter(entry => Number(entry.outstandingCredit || 0) > 0);
                  const creditRemaining = creditRemainingJobs.reduce((sum, entry) => sum + Number(entry.outstandingCredit || 0), 0);
                  const totalCost = costs.reduce((sum, entry) => sum + Number(entry.drAmount || 0), 0);
                  const amountToPayCosts = costs.filter(entry => Number(entry.outstandingCredit || 0) > 0);
                  const amountToPay = amountToPayCosts.reduce((sum, entry) => sum + Number(entry.outstandingCredit || 0), 0);
                  const receivedTotal = directReceived + creditReceived;
                  const partyGroupMap = new Map();
                  [...jobs, ...costs, ...creditReceivedEntries, ...ledgerData.periodEntries.filter(entry=>entry.type==='credit-paid')].forEach(entry => {
                    const party = String(entry.partyName || 'Unknown Party').trim();
                    const key = party.toLowerCase();
                    if (!partyGroupMap.has(key)) partyGroupMap.set(key, { party, roles:new Set(), entries:[], moneyIn:0, moneyOut:0, receivable:0, payable:0 });
                    const group = partyGroupMap.get(key);
                    group.roles.add(['job','payment'].includes(entry.type) ? 'Client' : 'Vendor');
                    group.entries.push(entry);
                    group.moneyIn += Number(entry.crAmount || 0);
                    group.moneyOut += Number(entry.cashDrAmount || 0);
                    group.receivable += entry.type === 'job' ? Number(entry.outstandingCredit || 0) : 0;
                    group.payable += ['expense','stocking'].includes(entry.type) ? Number(entry.outstandingCredit || 0) : 0;
                  });
                  const summaryPartyGroups = Array.from(partyGroupMap.values()).map(group=>({
                    ...group,
                    role:Array.from(group.roles).join(' / '),
                    entries:[...group.entries].sort((a,b)=>String(a.timestamp||a.date||'').localeCompare(String(b.timestamp||b.date||'')))
                  })).sort((a,b)=>a.party.localeCompare(b.party));

                  // Search query filter for summary breakdown
                  const sq = (financialSummarySearch || '').trim().toLowerCase();

                  // 1. Credit Still to Receive items (Filtered)
                  const filteredReceivables = creditRemainingJobs.filter(job => {
                    if (!sq) return true;
                    return [job.partyName, job.jobNo, job.details, job.payment, String(job.outstandingCredit)].some(v => String(v || '').toLowerCase().includes(sq));
                  });

                  // 2. Amount Still to Pay items (Filtered)
                  const filteredPayables = amountToPayCosts.filter(item => {
                    if (!sq) return true;
                    return [item.partyName, item.jobNo, item.details, item.category, String(item.outstandingCredit)].some(v => String(v || '').toLowerCase().includes(sq));
                  });

                  // 3. Credit Received items (Filtered)
                  const filteredCreditReceived = creditReceivedEntries.filter(item => {
                    if (!sq) return true;
                    return [item.partyName, item.jobNo, item.details, item.payment, String(item.receivedCredit || item.crAmount)].some(v => String(v || '').toLowerCase().includes(sq));
                  });

                  // 4. Total Expenses / Purchase items (Filtered)
                  const filteredCosts = costs.filter(item => {
                    if (!sq) return true;
                    return [item.partyName, item.jobNo, item.details, item.category, item.payment, item.type, String(item.drAmount)].some(v => String(v || '').toLowerCase().includes(sq));
                  });

                  const summarySectionTabs = [
                    { id: 'ALL', label: "All Breakdowns" },
                    { id: 'RECEIVABLE', label: `1. Credit Still to Receive (${creditRemainingJobs.length})`, tone: 'amber' },
                    { id: 'PAYABLE', label: `2. Amount Still to Pay (${amountToPayCosts.length})`, tone: 'orange' },
                    { id: 'CREDIT_REC', label: `3. Credit Received (${creditReceivedEntries.length})`, tone: 'cyan' },
                    { id: 'EXPENSES', label: `4. Total Expenses / Purchase (${costs.length})`, tone: 'rose' }
                  ];

                  return h("div", { className: "space-y-6 animate-fade-in" }, [
                    // Breakdown View Toolbar (Search + Section Filter Tabs + Download Full Summary PDF Button)
                    h("div", { className: "bg-white rounded-2xl border border-slate-200 p-3.5 shadow-xs flex flex-col lg:flex-row lg:items-center justify-between gap-3" }, [
                      // Section Switcher Tabs
                      h("div", { className: "flex items-center gap-1.5 overflow-x-auto" }, summarySectionTabs.map(tab => {
                        const isTabActive = financialSummarySection === tab.id;
                        return h("button", {
                          key: tab.id,
                          type: "button",
                          onClick: () => setFinancialSummarySection(tab.id),
                          className: `px-3 py-1.5 rounded-xl text-xs font-black whitespace-nowrap cursor-pointer transition-all ${
                            isTabActive
                              ? 'bg-slate-900 text-white shadow-xs'
                              : 'bg-slate-100 hover:bg-slate-200 text-slate-700'
                          }`
                        }, tab.label);
                      })),

                      // Right Controls: Search + PDF Download
                      h("div", { className: "flex flex-wrap items-center gap-2" }, [
                        // Search Input
                        h("div", { className: "relative min-w-[220px]" }, [
                          h("input", {
                            type: "text",
                            value: financialSummarySearch,
                            onChange: (e) => setFinancialSummarySearch(e.target.value),
                            placeholder: "Filter client, vendor, title, ref...",
                            className: "w-full pl-8 pr-7 py-1.5 rounded-xl border border-slate-200 text-xs font-semibold focus:ring-2 focus:ring-indigo-500 focus:outline-none"
                          }),
                          h("span", { className: "absolute left-2.5 top-2 text-slate-400" }, h(Icon, { name: "search", className: "w-3.5 h-3.5" })),
                          financialSummarySearch && h("button", {
                            type: "button",
                            onClick: () => setFinancialSummarySearch(''),
                            className: "absolute right-2 top-1.5 text-slate-400 hover:text-slate-600 text-xs font-bold cursor-pointer"
                          }, "×")
                        ]),

                        // Download Full Summary PDF Button
                        h("button", {
                          type: "button",
                          onClick: () => {
                            try {
                              const res = storageService.createFinancialSummaryPdf({
                                month: financialLedgerMonth,
                                fromDate: ledgerData.fromDate,
                                toDate: ledgerData.toDate,
                                dateMode: ledgerData.dateMode || settings.dateMode
                              });
                              openPdfPreview(res);
                            } catch (err) {
                              alert(err.message || 'Unable to create PDF summary.');
                            }
                          },
                          className: "inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-black shadow-xs transition-all cursor-pointer whitespace-nowrap"
                        }, [
                          h(Icon, { name: "download", className: "w-3.5 h-3.5" }),
                          "Download Full Summary PDF"
                        ])
                      ])
                    ]),

                    h("section", { className:"relative overflow-visible rounded-3xl border border-indigo-200 bg-white shadow-xs" }, [
                      h("div", { className:"flex items-center justify-between gap-3 rounded-t-3xl border-b border-indigo-100 bg-indigo-50/60 p-4 sm:p-5" }, [
                        h("div", {}, [
                          h("h3", { className:"text-base font-black text-slate-900" }, "Party-wise Financial Summary"),
                          h("p", { className:"mt-0.5 text-xs font-semibold text-slate-500" }, "Clients and vendors are grouped once. Open the transaction menu to see every linked job and payment.")
                        ]),
                        h("span", { className:"rounded-full border border-indigo-200 bg-white px-3 py-1 text-[10px] font-black text-indigo-700" }, `${summaryPartyGroups.length} Parties`)
                      ]),
                      h("div", { className:"overflow-visible" }, h("table", { className:"w-full min-w-[980px] text-left text-xs" }, [
                        h("thead", { className:"bg-slate-50 text-[10px] font-black uppercase tracking-wide text-slate-500" }, h("tr", {}, [
                          ...["S.N.","Party / Client / Vendor","Role","Transactions","Money In","Money Out","Receivable","Payable"].map((label,index)=>h("th",{key:label,className:`px-3 py-3 ${index>=4?'text-right':''}`},label))
                        ])),
                        h("tbody", { className:"divide-y divide-slate-100" }, summaryPartyGroups.filter(group=>!sq || [group.party,group.role,...group.entries.map(entry=>`${entry.jobNo} ${entry.details}`)].join(' ').toLowerCase().includes(sq)).map((group,index)=>h("tr",{key:group.party,className:"hover:bg-indigo-50/30"},[
                          h("td",{className:"px-3 py-3 text-center font-mono text-slate-400"},index+1),
                          h("td",{className:"px-3 py-3 font-black text-slate-900"},group.party),
