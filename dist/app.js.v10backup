          key: "teamprofilemodal",
          className: "w-full animate-fade-in",
        }, [
          h("div", {
            role: "dialog", "aria-modal": "true", "aria-label": member.name + " profile",
            className: "w-full rounded-3xl border border-slate-200 bg-slate-50 shadow-sm flex flex-col overflow-hidden"
          }, [
            // ── HEADER ──────────────────────────────────────────────────
            h("div", { className: "relative z-10 bg-gradient-to-r from-slate-950 via-indigo-950 to-indigo-800 px-5 py-4 text-white rounded-t-3xl sm:rounded-t-3xl shrink-0" }, [
              h("div", { className: "flex items-start justify-between gap-3" }, [
                h("div", { className: "flex items-center gap-3" }, [
                  h("div", { className: "flex h-11 w-11 items-center justify-center rounded-2xl bg-white/15 text-base font-black ring-1 ring-white/20 shrink-0" }, member.name.slice(0,2).toUpperCase()),
                  h("div", {}, [
                    h("h2", { className: "text-lg font-black leading-tight" }, member.name),
                    h("p", { className: "text-xs text-indigo-200 font-semibold" }, member.jobTitle),
                    h("div", { className: "mt-1 flex items-center gap-2 flex-wrap" }, [
                      h("span", { className: `inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-black ${isInactive ? 'bg-slate-600 text-slate-200' : 'bg-emerald-500/30 text-emerald-200'}` }, isInactive ? 'Inactive' : 'Active'),
                      member.createdAt && h("span", { className: "text-[10px] text-indigo-300 font-semibold" }, `Joined: ${storageService.displayDate(member.createdAt.slice(0,10))}`)
                    ])
                  ])
                ]),
                h("div", { className: "flex items-center gap-1.5 shrink-0" }, [
                  h("button", { type: "button", onClick: () => { setSelectedTeam(null); setTeamMemberEditMode(false); }, className: "inline-flex h-8 items-center gap-1.5 rounded-xl bg-white/10 px-3 text-xs font-bold text-white hover:bg-white/20 cursor-pointer" }, [h(Icon, { name: "arrowLeft", className: "w-3.5 h-3.5" }), "Back"])
                ])
              ]),
              // TABS
              h("div", { className: "mt-3 flex gap-1 overflow-x-auto" },
                tabList.map(tab =>
                  h("button", {
                    key: tab.id, type: "button",
                    onClick: () => setTeamProfileTab(tab.id),
                    className: `px-3.5 py-1.5 rounded-xl text-xs font-black whitespace-nowrap cursor-pointer transition-all ${teamProfileTab === tab.id ? 'bg-white text-indigo-700 shadow-xs' : 'text-indigo-200 hover:bg-white/10'}`
                  }, tab.label)
                )
              )
            ]),

            // ── TAB CONTENT ─────────────────────────────────────────────
            h("div", { className: "flex-1 p-4 space-y-4 overflow-y-auto min-h-0" }, [

              // ── PROFILE INFO TAB ────────────────────────────────────
              teamProfileTab === 'info' && h("div", { className: "space-y-4" }, [
                h("div", { className: "bg-white rounded-xl border border-slate-200 shadow-2xs overflow-hidden" }, [
                  h("div", { className: "flex items-center justify-between px-4 py-3 border-b border-slate-100" }, [
                    h("h3", { className: "font-black text-slate-900 text-sm" }, "Profile Information"),
                    !teamMemberEditMode
                      ? h("button", { type: "button", onClick: () => setTeamMemberEditMode(true), className: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-bold text-slate-700 hover:bg-slate-50 cursor-pointer" }, [h(Icon, { name: "edit", className: "w-3.5 h-3.5" }), "Edit"])
                      : null
                  ]),
                  teamMemberEditMode
                    ? h("form", {
                        onSubmit: e => {
                          e.preventDefault();
                          const f = e.currentTarget;
                          const pin = f.editPin.value.replace(/\D/g, '');
                          if (pin.length !== 6) { alert('PIN must be exactly 6 digits.'); return; }
                          const nextSalary = Math.max(0, Number(f.editSalary.value || 0));
                          const oldSalary = Number(member.salary || 0);
                          const nextRecords = [...(member.records || [])];
                          if (nextSalary !== oldSalary) nextRecords.push({ id: createId('teamrec'), type: 'Salary Updated', date: todayStr, amount: nextSalary, note: `Changed from ${storageService.formatCurrency(oldSalary)}`, createdAt: new Date().toISOString() });
                          const updates = { name: f.editName.value.trim(), jobTitle: f.editTitle.value.trim(), phone: f.editPhone.value.replace(/\D/g, ''), pin, salary: nextSalary, status: f.editStatus.value, records: nextRecords };
                          if (window._tempCitizenship) { updates.citizenshipDoc = window._tempCitizenship; window._tempCitizenship = null; }
                          saveMember(updates);
                          setTeamMemberEditMode(false);
                          showFeedback('✓ Profile updated.');
                        },
                        className: "p-4 space-y-3 text-xs"
                      }, [
                        h("div", { className: "grid grid-cols-1 sm:grid-cols-2 gap-3" }, [
                          h("div", {}, [h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Full Name *"), h("input", { name: "editName", required: true, defaultValue: member.name, className: "w-full p-2.5 border border-slate-200 rounded-xl text-xs font-bold focus:ring-2 focus:ring-indigo-500 focus:outline-none" })]),
                          h("div", {}, [h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Job Title *"), h("input", { name: "editTitle", required: true, defaultValue: member.jobTitle, className: "w-full p-2.5 border border-slate-200 rounded-xl text-xs font-bold focus:ring-2 focus:ring-indigo-500 focus:outline-none" })]),
                          h("div", {}, [h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Phone Number"), h("input", { name: "editPhone", type: "tel", inputMode: "numeric", defaultValue: member.phone || '', onInput: e => { e.currentTarget.value = e.currentTarget.value.replace(/\D/g, ''); }, className: "w-full p-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none" })]),
                          h("div", {}, [h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Monthly Salary (Rs.)"), h("input", { name: "editSalary", type: "number", min: "0", defaultValue: Number(member.salary || 0), className: "w-full p-2.5 border border-slate-200 rounded-xl text-xs font-mono focus:ring-2 focus:ring-indigo-500 focus:outline-none" })]),
                          h("div", {}, [h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Security PIN (6 digits)"), h("input", { name: "editPin", type: "password", inputMode: "numeric", maxLength: 6, defaultValue: member.pin || '', className: "w-full p-2.5 border border-slate-200 rounded-xl text-xs font-mono focus:ring-2 focus:ring-indigo-500 focus:outline-none" })]),
                          h("div", {}, [h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Status"), h("select", { name: "editStatus", defaultValue: member.status || 'active', className: "w-full p-2.5 border border-slate-200 rounded-xl text-xs font-bold bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none cursor-pointer" }, [h("option", { value: "active" }, "Active"), h("option", { value: "inactive" }, "Inactive")])]),
                          h("div", { className: "col-span-1 sm:col-span-2" }, [
                            h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Citizenship Document"),
                            h("input", {
                              type: "file",
                              accept: "image/*,.pdf",
                              onChange: e => {
                                const file = e.target.files[0];
                                if (file) {
                                  const reader = new FileReader();
                                  reader.onload = (ev) => { window._tempCitizenship = ev.target.result; };
                                  reader.readAsDataURL(file);
                                } else {
                                  window._tempCitizenship = null;
                                }
                              },
                              className: "w-full p-2 border border-slate-200 rounded-xl text-xs bg-white file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer"
                            }),
                            member.citizenshipDoc && !window._tempCitizenship && h("p", { className: "text-[10px] text-emerald-600 mt-1 font-semibold" }, "✓ Document already uploaded. Select a new file to replace it.")
                          ])
                        ]),
                        h("div", { className: "flex gap-2 pt-1 border-t border-slate-100" }, [
                          h("button", { type: "button", onClick: () => setTeamMemberEditMode(false), className: "flex-1 px-4 py-2 rounded-xl border border-slate-200 bg-white text-xs font-bold text-slate-600 hover:bg-slate-50 cursor-pointer" }, "Cancel"),
                          h("button", { type: "submit", className: "flex-1 px-4 py-2 rounded-xl bg-indigo-600 text-xs font-black text-white hover:bg-indigo-700 cursor-pointer" }, "Save Changes")
                        ])
                      ])
                    : h("div", { className: "p-4 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-xs" }, [
                        ...[
                          ['Full Name', member.name],
                          ['Job Title', member.jobTitle],
                          ['Phone Number', member.phone || 'Not set'],
                          ['Security PIN', member.pin ? '••••••' : 'Not set'],
                          ['Account Status', isInactive ? 'Inactive' : 'Active'],
                          ['Join Date', member.createdAt ? storageService.displayDate(member.createdAt.slice(0,10)) : 'Unknown'],
                          ['Citizenship', member.citizenshipDoc ? h('a', { href: member.citizenshipDoc, target: '_blank', className: 'text-indigo-600 hover:underline inline-flex items-center gap-1' }, [h(Icon, { name: "file", className: "w-3 h-3" }), 'View Document']) : 'Not uploaded']
                        ].map(([label, value]) =>
                          h("div", { key: label, className: "flex flex-col gap-0.5 border-b border-slate-100 pb-2" }, [
                            h("span", { className: "text-[9px] font-black uppercase tracking-wider text-slate-400" }, label),
                            h("span", { className: "font-bold text-slate-800" }, value)
                          ])
                        )
                      ])
                ]),

                // Delete button inside profile
                h("div", { className: "pt-2" }, [
                  h("button", {
                    type: "button",
                    onClick: () => setTeamDeleteConfirm(member),
                    className: "inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-rose-200 bg-rose-50 text-rose-600 text-xs font-black hover:bg-rose-100 cursor-pointer"
                  }, [h(Icon, { name: "trash", className: "w-3.5 h-3.5" }), "Delete Member"])
                ])
              ]),

              // ── SALARY & RECORDS TAB (PROFESSIONAL REAL-LIFE UI) ────────────────
              teamProfileTab === 'salary' && h("div", { className: "space-y-4 animate-fade-in" }, [
                // Top Financial KPI Summary Cards
                h("div", { className: "grid grid-cols-2 sm:grid-cols-4 gap-3" }, [
                  h("div", { className: "rounded-2xl border border-emerald-200 bg-emerald-50/60 p-4 shadow-2xs" }, [
                    h("span", { className: "text-[10px] font-black uppercase tracking-wider text-emerald-700 block" }, "Monthly Salary"),
                    h("div", { className: "mt-1.5 font-mono text-xl font-black text-emerald-900" }, storageService.formatCurrency(member.salary || 0)),
                    h("p", { className: "mt-0.5 text-[10px] font-semibold text-emerald-700" }, "Agreed monthly rate")
                  ]),
                  h("div", { className: "rounded-2xl border border-rose-200 bg-rose-50/60 p-4 shadow-2xs" }, [
                    h("span", { className: "text-[10px] font-black uppercase tracking-wider text-rose-700 block" }, "Outstanding Advance"),
                    h("div", { className: "mt-1.5 font-mono text-xl font-black text-rose-800" }, storageService.formatCurrency(borrowedAmt)),
                    h("p", { className: "mt-0.5 text-[10px] font-semibold text-rose-600" }, borrowedAmt > 0 ? "Pending deduction" : "Cleared / No advance")
                  ]),
                  h("div", { className: "rounded-2xl border border-indigo-200 bg-indigo-50/60 p-4 shadow-2xs" }, [
                    h("span", { className: "text-[10px] font-black uppercase tracking-wider text-indigo-700 block" }, "Net Payable"),
                    h("div", { className: "mt-1.5 font-mono text-xl font-black text-indigo-900" }, storageService.formatCurrency(salaryAfterBorrow)),
                    h("p", { className: "mt-0.5 text-[10px] font-semibold text-indigo-600" }, "Salary after advance")
                  ]),
                  h("div", { className: "rounded-2xl border border-slate-200 bg-white p-4 shadow-2xs" }, [
                    h("span", { className: "text-[10px] font-black uppercase tracking-wider text-slate-500 block" }, "Last Paid Record"),
                    h("div", { className: "mt-1.5 font-mono text-base font-black text-slate-800 truncate" }, lastSalaryRecord ? storageService.formatCurrency(lastSalaryRecord.amount) : "—"),
                    h("p", { className: "mt-0.5 text-[10px] font-semibold text-slate-400" }, lastSalaryRecord ? storageService.displayDate(lastSalaryRecord.date) : "No payment yet")
                  ])
                ]),

                // Quick Action Module (Salary Disbursal, Advance Issue, Repayment)
                h("div", { className: "rounded-2xl border border-slate-200 bg-white p-4 sm:p-5 shadow-xs space-y-4" }, [
                  h("div", { className: "flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-3" }, [
                    h("div", {}, [
                      h("h3", { className: "text-sm font-black text-slate-900" }, "Staff Transaction Entry"),
                      h("p", { className: "text-xs text-slate-500" }, "Disburse monthly salary, issue advance loans, or record repayments.")
                    ]),
                    h("span", { className: "text-[10px] font-bold uppercase text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-full border border-indigo-100 w-fit" }, "Instant Slip Generated")
                  ]),

                  h("form", {
                    onSubmit: e => {
                      e.preventDefault();
                      const f = e.currentTarget;
                      const type = f.recType.value;
                      const amount = Math.max(0, Number(f.recAmount.value || 0));
                      if (amount <= 0) { alert('Please enter a valid amount.'); return; }
                      const date = f.recDate.value || todayStr;
                      const note = f.recNote.value.trim();
                      const method = f.recMethod ? f.recMethod.value : 'Cash';
                      const record = {
                        id: createId('teamrec'),
                        type,
                        date,
                        amount,
                        method,
                        note,
                        createdAt: new Date().toISOString()
                      };
                      let borrowed = Number(member.borrowed || 0);
                      if (type === 'Borrowed') borrowed += amount;
                      if (type === 'Repayment') borrowed = Math.max(0, borrowed - amount);
                      const saved = saveMember({ borrowed, records: [...(member.records || []), record] });
                      if (saved) {
                        f.reset();
                        showFeedback(`✓ ${type} of ${storageService.formatCurrency(amount)} recorded.`);
                      }
                    },
                    className: "space-y-3"
                  }, [
                    h("div", { className: "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3" }, [
                      h("div", {}, [
                        h("label", { className: "block text-[10px] font-black uppercase text-slate-500 mb-1" }, "Transaction Type *"),
                        h("select", { name: "recType", defaultValue: "Salary Payment", className: "w-full p-2.5 rounded-xl border border-slate-200 bg-white text-xs font-bold focus:ring-2 focus:ring-indigo-500 focus:outline-none cursor-pointer" }, [
                          h("option", { value: "Salary Payment" }, "💵 Salary Payment"),
                          h("option", { value: "Borrowed" }, "🤝 Advance / Borrow"),
                          h("option", { value: "Repayment" }, "📥 Advance Repayment")
                        ])
                      ]),
                      h("div", {}, [
                        h("label", { className: "block text-[10px] font-black uppercase text-slate-500 mb-1" }, "Date *"),
                        h("input", { name: "recDate", type: "date", defaultValue: todayStr, required: true, className: "w-full p-2.5 rounded-xl border border-slate-200 text-xs font-bold focus:ring-2 focus:ring-indigo-500 focus:outline-none cursor-pointer" })
                      ]),
                      h("div", {}, [
                        h("label", { className: "block text-[10px] font-black uppercase text-slate-500 mb-1" }, "Amount (Rs.) *"),
                        h("input", { name: "recAmount", type: "number", min: "1", step: "1", required: true, placeholder: String(member.salary || 30000), className: "w-full p-2.5 rounded-xl border border-slate-200 text-xs font-mono font-bold focus:ring-2 focus:ring-indigo-500 focus:outline-none" })
                      ]),
                      h("div", {}, [
                        h("label", { className: "block text-[10px] font-black uppercase text-slate-500 mb-1" }, "Payment Method"),
                        h("select", { name: "recMethod", defaultValue: "Cash", className: "w-full p-2.5 rounded-xl border border-slate-200 bg-white text-xs font-bold focus:ring-2 focus:ring-indigo-500 focus:outline-none cursor-pointer" }, [
                          h("option", { value: "Cash" }, "Cash"),
                          h("option", { value: "Online / eSewa" }, "Online / eSewa"),
                          h("option", { value: "Bank Transfer" }, "Bank Transfer")
                        ])
                      ]),
                      h("div", {}, [
                        h("label", { className: "block text-[10px] font-black uppercase text-slate-500 mb-1" }, "Notes / Remarks"),
                        h("input", { name: "recNote", placeholder: "e.g. Bhadra salary", className: "w-full p-2.5 rounded-xl border border-slate-200 text-xs font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none" })
                      ])
                    ]),
                    h("div", { className: "flex justify-end pt-1" }, [
                      h("button", {
                        type: "submit",
                        className: "inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-black shadow-xs transition-all cursor-pointer"
                      }, [
                        h(Icon, { name: "plus", className: "w-4 h-4" }),
                        "Save Record"
                      ])
                    ])
                  ])
                ]),

                // Transaction Records Ledger Table
                h("div", { className: "rounded-2xl border border-slate-200 bg-white shadow-xs overflow-hidden" }, [
                  h("div", { className: "px-4 py-3.5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2" }, [
                    h("div", {}, [
                      h("h4", { className: "text-xs font-black text-slate-900" }, "Salary & Advance Ledger"),
                      h("p", { className: "text-[10px] text-slate-400 mt-0.5" }, "Chronological statement of all pay disbursements, advances, and adjustments.")
                    ]),
                    h("div", { className: "flex items-center gap-2" }, [
                      h("button", {
                        type: "button",
                        onClick: () => {
                          try {
                            const res = storageService.createTeamMemberStatementPdf(member, records, { dateMode: settings.dateMode });
                            openPdfPreview(res);
                          } catch (err) {
                            alert(err.message || 'Unable to generate team member ledger PDF.');
                          }
                        },
                        className: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-xs cursor-pointer transition-all"
                      }, [h(Icon, { name: "download", className: "w-3.5 h-3.5" }), "Download Full Ledger PDF"]),
                      h("span", { className: "text-[10px] font-bold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-lg" }, `${records.length} Record${records.length !== 1 ? 's' : ''}`)
                    ])
                  ]),

                  records.length === 0
                    ? h("div", { className: "py-14 text-center text-xs text-slate-400 font-semibold" }, "No salary or advance transactions recorded yet.")
                    : h("div", { className: "overflow-x-auto" }, [
                        h("table", { className: "w-full text-left text-xs border-collapse min-w-[620px]" }, [
                          h("thead", { className: "bg-slate-50 border-b border-slate-100 text-[10px] font-black uppercase tracking-wider text-slate-500 select-none" }, [
                            h("tr", { className: "h-9" }, [
                              h("th", { className: "px-4 py-2.5 w-12 text-center" }, "S.N."),
                              h("th", { className: "px-3 py-2.5 whitespace-nowrap" }, "Date"),
                              h("th", { className: "px-3 py-2.5" }, "Transaction Type"),
                              h("th", { className: "px-3 py-2.5" }, "Payment Method"),
                              h("th", { className: "px-3 py-2.5 min-w-[160px]" }, "Details & Note"),
                              h("th", { className: "px-3 py-2.5 text-right whitespace-nowrap" }, "Amount"),
                              h("th", { className: "px-4 py-2.5 text-center w-28 whitespace-nowrap" }, "Voucher / Slip")
                            ])
                          ]),
                          h("tbody", { className: "divide-y divide-slate-100" },
                            salaryPaging.items.map((record, rIdx) => {
                              const isSalary = record.type === 'Salary Payment' || record.type === 'Salary Updated';
                              const isBorrow = record.type === 'Borrowed';
                              const isRepay = record.type === 'Repayment';
                              const typeBadgeClass = isSalary
                                ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
                                : isBorrow
                                ? 'bg-rose-50 text-rose-700 border-rose-200'
                                : isRepay
                                ? 'bg-indigo-50 text-indigo-700 border-indigo-200'
                                : 'bg-slate-100 text-slate-700 border-slate-200';
                              const amountClass = isBorrow
                                ? 'text-rose-600'
                                : isRepay
                                ? 'text-indigo-600'
                                : 'text-slate-900';

                              return h("tr", { key: record.id || rIdx, className: "hover:bg-slate-50/80 transition-colors" }, [
                                h("td", { className: "px-4 py-3 text-center text-slate-400 font-mono font-bold" }, String((salaryPaging.start ?? 0) + rIdx + 1)),
                                h("td", { className: "px-3 py-3 font-semibold text-slate-700 whitespace-nowrap" }, storageService.displayDate(record.date)),
                                h("td", { className: "px-3 py-3" }, [
                                  h("span", { className: `inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-black border ${typeBadgeClass}` }, record.type)
                                ]),
                                h("td", { className: "px-3 py-3 text-slate-600 font-medium" }, record.method || 'Cash'),
                                h("td", { className: "px-3 py-3 text-slate-600 max-w-[200px] truncate", title: record.note || '—' }, record.note || '—'),
                                h("td", { className: `px-3 py-3 text-right font-mono font-black ${amountClass} whitespace-nowrap` }, storageService.formatCurrency(record.amount || 0)),
                                h("td", { className: "px-4 py-3 text-center" }, [
                                  h("div", { className: "flex items-center justify-center gap-1.5" }, [
                                    h("button", {
                                      type: "button",
                                      title: "Download Salary / Advance Slip PDF",
                                      onClick: () => {
                                        try {
                                          const slip = storageService.exportSalarySlipPdf(member, record);
                                          if (slip?.blob) {
                                            const link = document.createElement('a');
                                            link.href = URL.createObjectURL(slip.blob);
                                            link.download = slip.filename || `Slip_${member.name.replace(/\s+/g, '_')}_${record.date}.pdf`;
                                            document.body.appendChild(link);
                                            link.click();
                                            document.body.removeChild(link);
                                            URL.revokeObjectURL(link.href);
                                            showFeedback('✓ Slip PDF downloaded.');
                                          }
                                        } catch (err) {
                                          alert('Error generating slip: ' + err.message);
                                        }
                                      },
                                      className: "inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-[10px] font-bold border border-indigo-200 cursor-pointer transition-all"
                                    }, [
                                      h(Icon, { name: "download", className: "w-3 h-3" }),
                                      "Slip"
                                    ]),
                                    h("button", {
                                      type: "button",
                                      title: "Delete this record",
                                      onClick: () => {
                                        if (confirm(`Delete record of ${storageService.formatCurrency(record.amount)} on ${record.date}?`)) {
                                          let borrowed = Number(member.borrowed || 0);
                                          if (record.type === 'Borrowed') borrowed = Math.max(0, borrowed - Number(record.amount || 0));
                                          if (record.type === 'Repayment') borrowed = borrowed + Number(record.amount || 0);
                                          saveMember({
                                            borrowed,
                                            records: (member.records || []).filter(r => r.id !== record.id)
                                          });
                                          showFeedback('✓ Record deleted.');
                                        }
                                      },
                                      className: "p-1 rounded-lg text-slate-300 hover:text-rose-600 hover:bg-rose-50 cursor-pointer transition-colors"
                                    }, h(Icon, { name: "trash", className: "w-3 h-3" }))
                                  ])
                                ])
                              ]);
                            })
                          )
                        ]),
                        renderAppPagination({ ...salaryPaging, setPageSize: setTeamSalaryPageSize, setPage: setTeamSalaryPage })
                      ])
                ])
              ])

            ]) // end tab content
          ]) // end dialog div
        ]); // end return
      })();
                return innerBlock;
              }

              const activeTeamMembers = team.filter(m => m.status !== 'inactive');
              const inactiveTeamMembers = team.filter(m => m.status === 'inactive');
              const totalMonthlyPayroll = team.reduce((s, m) => s + Number(m.salary || 0), 0);
              const totalStaffAdvances = team.reduce((s, m) => s + Number(m.borrowed || 0), 0);

              const filteredTeam = team.filter(m => {
                if (teamRoleFilter !== 'ALL' && (m.jobTitle || '').toLowerCase() !== teamRoleFilter.toLowerCase()) return false;
                if (!teamSearch.trim()) return true;
                const q = teamSearch.toLowerCase();
                return (m.name || '').toLowerCase().includes(q)
                  || (m.jobTitle || '').toLowerCase().includes(q)
                  || (m.phone || '').includes(q);
              });
              const teamListPaging = paginateCollection(filteredTeam, teamListPage, teamListPageSize);

              return h("div", { className: "space-y-6 animate-fade-in" }, [
                // Header
                h("div", { className: "flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-200 pb-5" }, [
                  h("div", { className: "space-y-1.5" }, [
                    h("div", { className: "flex items-center gap-2" }, [
                      h("button", {
                        type: "button",
                        onClick: () => setProfileTopic(null),
                        className: "inline-flex items-center gap-1.5 text-xs font-black text-indigo-600 hover:text-indigo-800 bg-indigo-50 hover:bg-indigo-100 px-3 py-1.5 rounded-xl transition-all cursor-pointer shadow-2xs"
                      }, [
                        h(Icon, { name: "chevronLeft", className: "w-3.5 h-3.5" }),
                        "Back to Profile & Business"
                      ]),
                      h("span", { className: "text-slate-300" }, "•"),
                      h("span", { className: "text-xs font-semibold text-slate-400" }, "Settings / Team Management")
                    ]),
                    h("h1", { className: "text-2xl font-black tracking-tight text-slate-950 flex items-center gap-2.5 pt-1" }, [
                      h(Icon, { name: "users", className: "w-6 h-6 text-indigo-600" }),
                      "Team Management"
                    ]),
                    h("p", { className: "text-xs text-slate-500 mt-0.5" }, "Manage staff roles, salary disbursements, advances and permissions.")
                  ]),
                  h("div", { className: "flex items-center gap-2" }, [
                    h("button", {
                      type: "button",
                      onClick: () => setTeamExportModal(true),
                      className: "inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-slate-200 bg-white text-xs font-bold text-slate-700 hover:bg-slate-50 shadow-2xs transition-all cursor-pointer"
                    }, [h(Icon, { name: "download", className: "w-3.5 h-3.5" }), "Export Records PDF"]),
                    h("button", {
                      type: "button",
                      onClick: () => setTeamAddModalOpen(true),
                      className: "inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-black shadow-xs transition-all cursor-pointer whitespace-nowrap"
                    }, [h(Icon, { name: "plus", className: "w-3.5 h-3.5" }), "Add Member"])
                  ])
                ]),

                // 4 Executive Team KPI Cards
                h("div", { className: "grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3.5" }, [
                  h("div", { className: "p-4 rounded-2xl border border-slate-200 bg-white shadow-2xs relative" }, [
                    h("div", { className: "flex items-center justify-between" }, [
                      h("span", { className: "text-[10px] font-black uppercase tracking-wider text-slate-400" }, "Total Staff"),
                      h("span", { className: "w-2 h-2 rounded-full bg-indigo-500" })
                    ]),
                    h("div", { className: "mt-1.5 font-mono text-2xl font-black text-slate-900" }, `${team.length}`),
                    h("p", { className: "text-[11px] text-slate-400 mt-0.5" }, `${activeTeamMembers.length} active • ${inactiveTeamMembers.length} inactive`)
                  ]),
                  h("div", { className: "p-4 rounded-2xl border border-emerald-200 bg-emerald-50/40 shadow-2xs relative" }, [
                    h("div", { className: "flex items-center justify-between" }, [
                      h("span", { className: "text-[10px] font-black uppercase tracking-wider text-emerald-700" }, "Active Production"),
                      h("span", { className: "w-2 h-2 rounded-full bg-emerald-500" })
                    ]),
                    h("div", { className: "mt-1.5 font-mono text-2xl font-black text-emerald-900" }, `${activeTeamMembers.length}`),
                    h("p", { className: "text-[11px] text-emerald-600 mt-0.5" }, "Ready for job assignments")
                  ]),
                  h("div", { className: "p-4 rounded-2xl border border-indigo-200 bg-indigo-50/40 shadow-2xs relative" }, [
                    h("div", { className: "flex items-center justify-between" }, [
                      h("span", { className: "text-[10px] font-black uppercase tracking-wider text-indigo-700" }, "Monthly Payroll"),
                      h("span", { className: "w-2 h-2 rounded-full bg-indigo-500" })
                    ]),
                    h("div", { className: "mt-1.5 font-mono text-xl font-black text-indigo-950 truncate" }, storageService.formatCurrency(totalMonthlyPayroll)),
                    h("p", { className: "text-[11px] text-indigo-600 mt-0.5" }, "Agreed monthly salaries")
                  ]),
                  h("div", { className: "p-4 rounded-2xl border border-rose-200 bg-rose-50/40 shadow-2xs relative" }, [
                    h("div", { className: "flex items-center justify-between" }, [
                      h("span", { className: "text-[10px] font-black uppercase tracking-wider text-rose-700" }, "Staff Advances"),
                      h("span", { className: "w-2 h-2 rounded-full bg-rose-500" })
                    ]),
                    h("div", { className: "mt-1.5 font-mono text-xl font-black text-rose-900 truncate" }, storageService.formatCurrency(totalStaffAdvances)),
                    h("p", { className: "text-[11px] text-rose-600 mt-0.5" }, totalStaffAdvances > 0 ? "Pending loan deductions" : "All advances cleared")
                  ])
                ]),

                // Search & Filter Toolbar
                h("div", { className: "flex flex-col sm:flex-row items-center justify-between gap-3 bg-white p-3 rounded-2xl border border-slate-200 shadow-2xs" }, [
                  // Role Filter Pills
                  h("div", { className: "flex items-center gap-1.5 overflow-x-auto w-full sm:w-auto" }, [
                    h("button", {
                      type: "button",
                      onClick: () => setTeamRoleFilter('ALL'),
                      className: `px-3 py-1.5 rounded-xl text-xs font-black whitespace-nowrap cursor-pointer transition-all ${
                        teamRoleFilter === 'ALL'
                          ? 'bg-slate-900 text-white shadow-xs'
                          : 'bg-slate-100 hover:bg-slate-200 text-slate-600'
                      }`
                    }, `All Staff (${team.length})`),
                    ...roleList.map(([role, count]) =>
                      h("button", {
                        key: role,
                        type: "button",
                        onClick: () => setTeamRoleFilter(role),
                        className: `px-3 py-1.5 rounded-xl text-xs font-black whitespace-nowrap cursor-pointer transition-all ${
                          teamRoleFilter.toLowerCase() === role.toLowerCase()
                            ? 'bg-indigo-600 text-white shadow-xs'
                            : 'bg-slate-100 hover:bg-slate-200 text-slate-600'
                        }`
                      }, `${role} (${count})`)
                    )
                  ]),

                  // Search Bar
                  h("div", { className: "relative w-full sm:w-72" }, [
                    h("input", {
                      type: "text",
                      value: teamSearch,
                      onChange: e => setTeamSearch(e.target.value),
                      placeholder: "Search staff name or phone...",
                      className: "w-full pl-8 pr-3 py-1.5 border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 placeholder-slate-400 focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-slate-50 focus:bg-white"
                    }),
                    h("span", { className: "absolute left-2.5 top-2 text-slate-400" }, h(Icon, { name: "search", className: "w-3.5 h-3.5" }))
                  ])
                ]),

                // Member Table
                h("div", { className: "bg-white rounded-2xl border border-slate-200 shadow-2xs overflow-hidden" }, [
                  teamActionMenuId && h("div", { className: "fixed inset-0 z-10 cursor-default", onClick: () => setTeamActionMenuId(null) }),
                  filteredTeam.length === 0
                    ? h("div", { className: "p-12 text-center text-slate-400 text-xs font-semibold" }, teamSearch ? "No members match your search." : "No team members found. Click + Add Member to get started.")
                    : h("div", { className: "overflow-x-auto" }, [
                        h("table", { className: "w-full text-left text-xs border-collapse min-w-[700px]" }, [
                          h("thead", { className: "bg-slate-50 border-b border-slate-200 text-[10px] font-black uppercase tracking-wider text-slate-500 select-none" }, [
                            h("tr", { className: "h-10" }, [
                              h("th", { className: "px-4 py-3 font-bold" }, "Team Member"),
                              h("th", { className: "px-3 py-3 font-bold" }, "Role"),
                              h("th", { className: "px-3 py-3 font-bold" }, "Monthly Salary"),
                              h("th", { className: "px-3 py-3 font-bold" }, "Advance Due"),
                              h("th", { className: "px-3 py-3 font-bold text-center" }, "Status"),
                              h("th", { className: "px-4 py-3 font-bold text-right" }, "Actions")
                            ])
                          ]),
                          h("tbody", { className: "divide-y divide-slate-100" },
                            teamListPaging.items.map(member => {
                              const isInactive = member.status === 'inactive';
                              const borrowed = Number(member.borrowed || 0);
                              return h("tr", {
                                key: member.id,
                                className: `h-14 transition-colors ${isInactive ? 'opacity-50 bg-slate-50/50' : 'hover:bg-slate-50/70'}`
                              }, [
                                // Member cell
                                h("td", { className: "px-4 py-3" }, [
                                  h("div", { className: "flex items-center gap-3" }, [
                                    h("div", {
                                      className: `w-9 h-9 rounded-2xl flex items-center justify-center text-xs font-black text-white shrink-0 uppercase shadow-2xs ${isInactive ? 'bg-slate-400' : 'bg-gradient-to-tr from-indigo-600 to-indigo-800'}`
                                    }, member.name.slice(0, 2)),
                                    h("div", { className: "min-w-0" }, [
                                      h("div", { className: "font-black text-slate-900 truncate max-w-[180px]" }, member.name),
                                      h("div", { className: "text-[11px] text-slate-400 font-semibold" }, member.phone || "No phone added")
                                    ])
                                  ])
                                ]),
                                // Role cell
                                h("td", { className: "px-3 py-3" }, [
                                  h("span", { className: "inline-flex items-center px-2.5 py-1 rounded-lg bg-indigo-50 border border-indigo-100 text-indigo-700 text-[10px] font-black" }, member.jobTitle || 'Staff')
                                ]),
                                // Salary cell
                                h("td", { className: "px-3 py-3 font-mono font-bold text-slate-800" }, storageService.formatCurrency(member.salary || 0)),
                                // Advance cell
                                h("td", { className: "px-3 py-3" }, [
                                  borrowed > 0
                                    ? h("span", { className: "inline-flex items-center px-2 py-0.5 rounded-md font-mono text-xs font-black bg-rose-50 text-rose-700 border border-rose-200" }, storageService.formatCurrency(borrowed))
                                    : h("span", { className: "text-slate-400 text-[11px]" }, "None")
                                ]),
                                // Status cell
                                h("td", { className: "px-3 py-3 text-center" }, [
                                  h("span", {
                                    className: `inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-black border ${isInactive ? 'bg-slate-100 text-slate-600 border-slate-200' : 'bg-emerald-50 text-emerald-700 border-emerald-200'}`
                                  }, isInactive ? 'Inactive' : 'Active')
                                ]),
                                // Actions cell
                                h("td", { className: "px-4 py-3 text-right whitespace-nowrap relative" }, [
                                  h("div", { className: "inline-flex items-center gap-1.5" }, [
                                    h("button", {
                                      type: "button",
                                      onClick: () => { setSelectedTeam(member); setTeamProfileTab('salary'); setTeamMemberEditMode(false); },
                                      className: "px-2.5 py-1 rounded-xl border border-indigo-200 bg-indigo-50 text-indigo-700 text-xs font-bold hover:bg-indigo-100 cursor-pointer transition-all"
                                    }, "Ledger / Slip"),
                                    h("button", {
                                      type: "button",
                                      onClick: () => { setSelectedTeam(member); setTeamProfileTab('info'); setTeamMemberEditMode(false); },
                                      className: "px-2.5 py-1 rounded-xl border border-slate-200 bg-white text-slate-700 text-xs font-bold hover:bg-slate-50 cursor-pointer transition-all"
                                    }, "Profile"),
                                    // ••• action menu
                                    h("div", { className: "relative" }, [
                                      h("button", {
                                        type: "button",
                                        onClick: e => { e.stopPropagation(); setTeamActionMenuId(teamActionMenuId === member.id ? null : member.id); },
                                        className: "inline-flex items-center justify-center w-7 h-7 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-500 hover:text-slate-800 cursor-pointer"
                                      }, h(Icon, { name: "moreHorizontal", className: "w-3.5 h-3.5" })),
                                      teamActionMenuId === member.id && h("div", {
                                        className: "absolute right-0 top-8 w-44 rounded-2xl bg-white border border-slate-200 shadow-xl z-20 p-1.5 text-left animate-fade-in",
                                        onClick: e => e.stopPropagation()
                                      }, [
                                        h("button", { type: "button", onClick: () => { setTeamActionMenuId(null); setSelectedTeam(member); setTeamProfileTab('info'); setTeamMemberEditMode(false); }, className: "w-full text-left px-2.5 py-1.5 rounded-lg text-xs font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 flex items-center gap-2 cursor-pointer" }, [h(Icon, { name: "eye", className: "w-3 h-3" }), "View Profile"]),
                                        h("button", { type: "button", onClick: () => { setTeamActionMenuId(null); setSelectedTeam(member); setTeamProfileTab('info'); setTeamMemberEditMode(true); }, className: "w-full text-left px-2.5 py-1.5 rounded-lg text-xs font-semibold text-slate-700 hover:bg-slate-50 flex items-center gap-2 cursor-pointer" }, [h(Icon, { name: "edit", className: "w-3 h-3" }), "Edit Member"]),
                                        h("button", {
                                          type: "button",
                                          onClick: () => {
                                            setTeamActionMenuId(null);
                                            const updated = { ...member, status: isInactive ? 'active' : 'inactive' };
                                            storageService.saveTeamMember(updated);
                                            refresh();
                                            showFeedback(`${member.name} ${isInactive ? 'activated' : 'deactivated'}.`);
                                          },
                                          className: "w-full text-left px-2.5 py-1.5 rounded-lg text-xs font-semibold text-slate-700 hover:bg-amber-50 hover:text-amber-700 flex items-center gap-2 cursor-pointer"
                                        }, [h(Icon, { name: isInactive ? "check" : "pause", className: "w-3 h-3" }), isInactive ? "Activate" : "Deactivate"]),
                                        h("div", { className: "my-1 border-t border-slate-100" }),
                                        h("button", {
                                          type: "button",
                                          onClick: () => { setTeamActionMenuId(null); setTeamDeleteConfirm(member); },
                                          className: "w-full text-left px-2.5 py-1.5 rounded-lg text-xs font-semibold text-rose-600 hover:bg-rose-50 flex items-center gap-2 cursor-pointer"
                                        }, [h(Icon, { name: "trash", className: "w-3 h-3" }), "Delete"])
                                      ])
                                    ])
                                  ])
                                ])
                              ]);
                            })
                          )
                        ])
                      ]),
                  renderAppPagination({ ...teamListPaging, setPageSize: setTeamListPageSize, setPage: setTeamListPage })
                ]),

                // ADD MEMBER MODAL
                teamAddModalOpen && h("div", { className: "fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm p-4" }, [
                  h("div", { className: "w-full max-w-md rounded-2xl bg-white border border-slate-200 shadow-2xl overflow-hidden" }, [
                    h("div", { className: "flex items-center justify-between px-5 py-4 border-b border-slate-100" }, [
                      h("h3", { className: "text-base font-black text-slate-900" }, "Add Team Member"),
                      h("button", { type: "button", onClick: () => setTeamAddModalOpen(false), className: "rounded-lg border border-slate-200 p-1.5 hover:bg-slate-50 cursor-pointer" }, h(Icon, { name: "x", className: "w-4 h-4 text-slate-500" }))
                    ]),
                    h("form", {
                      onSubmit: e => {
                        e.preventDefault();
                        const f = e.currentTarget;
                        const name = f.addMemberName.value.trim();
                        const jobTitle = f.addMemberTitle.value.trim();
                        const pin = f.addMemberPin.value.replace(/\D/g, '');
                        const salary = Number(f.addMemberSalary.value || 0);
                        if (!name || !jobTitle) { alert('Name and Job Title are required.'); return; }
                        if (pin.length !== 6) { alert('Security PIN must be exactly 6 digits.'); return; }
                        if (salary < 0) { alert('Salary cannot be negative.'); return; }
                        storageService.saveTeamMember({
                          name,
                          jobTitle,
                          phone: f.addMemberPhone.value.replace(/\D/g, ''),
                          salary,
                          pin,
                          status: f.addMemberStatus.value || 'active',
                          records: [], notes: [], attendance: []
                        });
                        setTeamAddModalOpen(false);
                        refresh();
                        showFeedback(`✓ ${name} added to team!`);
                        f.reset();
                      },
                      className: "p-5 space-y-3.5 text-xs"
                    }, [
                      h("div", { className: "grid grid-cols-2 gap-3" }, [
                        h("div", { className: "col-span-2" }, [
                          h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Full Name *"),
                          h("input", { name: "addMemberName", required: true, placeholder: "e.g. Ramesh Thapa", className: "w-full p-2.5 border border-slate-200 rounded-xl text-xs font-bold focus:ring-2 focus:ring-indigo-500 focus:outline-none" })
                        ]),
                        h("div", { className: "col-span-2" }, [
                          h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Job Title *"),
                          h("input", { name: "addMemberTitle", required: true, placeholder: "e.g. Designer, Printer, Logistics", className: "w-full p-2.5 border border-slate-200 rounded-xl text-xs font-bold focus:ring-2 focus:ring-indigo-500 focus:outline-none" })
                        ]),
                        h("div", {}, [
                          h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Phone Number"),
                          h("input", { name: "addMemberPhone", type: "tel", inputMode: "numeric", placeholder: "98XXXXXXXX", onInput: e => { e.currentTarget.value = e.currentTarget.value.replace(/\D/g, ''); }, className: "w-full p-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none" })
                        ]),
                        h("div", {}, [
                          h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Monthly Salary (Rs.)"),
                          h("input", { name: "addMemberSalary", type: "number", min: "0", placeholder: "35000", className: "w-full p-2.5 border border-slate-200 rounded-xl text-xs font-mono focus:ring-2 focus:ring-indigo-500 focus:outline-none" })
                        ]),
                        h("div", {}, [
                          h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "6-Digit Security PIN *"),
                          h("input", { name: "addMemberPin", type: "password", inputMode: "numeric", maxLength: 6, placeholder: "••••••", pattern: "[0-9]{6}", required: true, className: "w-full p-2.5 border border-slate-200 rounded-xl text-xs font-mono focus:ring-2 focus:ring-indigo-500 focus:outline-none" })
                        ]),
                        h("div", {}, [
                          h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Status"),
                          h("select", { name: "addMemberStatus", defaultValue: "active", className: "w-full p-2.5 border border-slate-200 rounded-xl text-xs font-bold bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none cursor-pointer" }, [
                            h("option", { value: "active" }, "Active"),
                            h("option", { value: "inactive" }, "Inactive")
                          ])
                        ])
                      ]),
                      h("div", { className: "flex gap-2 pt-2 border-t border-slate-100" }, [
                        h("button", { type: "button", onClick: () => setTeamAddModalOpen(false), className: "flex-1 px-4 py-2 rounded-xl border border-slate-200 bg-white text-xs font-bold text-slate-600 hover:bg-slate-50 cursor-pointer" }, "Cancel"),
                        h("button", { type: "submit", className: "flex-1 px-4 py-2 rounded-xl bg-indigo-600 text-xs font-black text-white hover:bg-indigo-700 shadow-sm cursor-pointer" }, "Add Member")
                      ])
                    ])
                  ])
                ]),

                // EXPORT MODAL
                teamExportModal && h("div", { className: "fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm p-4" }, [
                  h("div", { className: "w-full max-w-xs rounded-2xl bg-white border border-slate-200 shadow-2xl p-5 space-y-4" }, [
                    h("h3", { className: "text-sm font-black text-slate-900" }, "Export Team Records PDF"),
                    h("p", { className: "text-xs text-slate-500" }, "Choose which records to export."),
                    h("div", { className: "space-y-2" }, [
                      h("button", { type: "button", onClick: () => { setTeamExportModal(false); openPdfPreview(storageService.exportTeamRecordPDF()); }, className: "w-full px-4 py-2.5 rounded-xl bg-indigo-600 text-xs font-black text-white hover:bg-indigo-700 cursor-pointer" }, "All Members"),
                      h("button", { type: "button", onClick: () => { setTeamExportModal(false); openPdfPreview(storageService.exportTeamRecordPDF(null, { activeOnly: true })); }, className: "w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-xs font-bold text-slate-700 hover:bg-slate-50 cursor-pointer" }, "Active Members Only")
                    ]),
                    h("button", { type: "button", onClick: () => setTeamExportModal(false), className: "w-full text-xs font-bold text-slate-400 hover:text-slate-600 cursor-pointer pt-1" }, "Cancel")
                  ])
                ]),

                // DELETE CONFIRM MODAL
                teamDeleteConfirm && h("div", { className: "fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm p-4" }, [
                  h("div", { className: "w-full max-w-sm rounded-2xl bg-white border border-slate-200 shadow-2xl p-6 space-y-4" }, [
                    h("div", { className: "flex items-center gap-3" }, [
                      h("div", { className: "w-10 h-10 rounded-full bg-rose-100 flex items-center justify-center shrink-0" }, h(Icon, { name: "trash", className: "w-4 h-4 text-rose-600" })),
                      h("h3", { className: "text-sm font-black text-slate-900" }, "Delete Team Member?")
                    ]),
                    h("p", { className: "text-xs text-slate-600" }, [
                      h("span", { className: "font-black" }, teamDeleteConfirm.name),
                      " will be removed from the active team. Existing historical job/production records will NOT be deleted."
                    ]),
                    h("div", { className: "rounded-xl bg-amber-50 border border-amber-200 px-3 py-2 text-[10px] text-amber-800 font-semibold" }, "Historical records (jobs, designs, financial entries) are preserved and will still show the member name."),
                    h("div", { className: "flex gap-2 pt-1" }, [
                      h("button", { type: "button", onClick: () => setTeamDeleteConfirm(null), className: "flex-1 px-4 py-2 rounded-xl border border-slate-200 bg-white text-xs font-bold text-slate-600 hover:bg-slate-50 cursor-pointer" }, "Cancel"),
                      h("button", {
                        type: "button",
                        onClick: () => {
                          storageService.deleteTeamMember(teamDeleteConfirm.id);
                          setTeamDeleteConfirm(null);
                          if (selectedTeam?.id === teamDeleteConfirm.id) setSelectedTeam(null);
                          refresh();
                          showFeedback(`${teamDeleteConfirm.name} removed from team.`);
                        },
                        className: "flex-1 px-4 py-2 rounded-xl bg-rose-600 text-xs font-black text-white hover:bg-rose-700 cursor-pointer"
                      }, "Delete Member")
                    ])
                  ])
                ])
              ]);
            })(),

            // ==========================================
            // TOPIC 6: BRANDING & THEME
            // ==========================================
            profileTopic === 'branding' && (() => {
              const handleLogoFile = (file) => {
                if (!file) return;
                if (!file.type.startsWith('image/')) {
                  alert('Please choose an image file (PNG, JPG, SVG, WebP).');
                  return;
                }
                const reader = new FileReader();
                reader.onload = async (ev) => {
                  const dataUrl = ev.target.result;
                  let updated = { ...settings, shopLogo: dataUrl };
                  try {
                    const extracted = await extractPaletteFromLogo(dataUrl);
                    if (extracted && extracted.primary) {
                      updated.brandPrimary = extracted.primary;
                      updated.brandPrimaryHover = extracted.primary;
                      if (extracted.accent) updated.brandAccent = extracted.accent;
                      if (extracted.sidebar) updated.brandSidebar = extracted.sidebar;
                      if (extracted.surface) updated.brandSurface = extracted.surface;
                      applyBrandTheme(updated);
                      setLogoExtractedPalette(extracted);
                    }
                  } catch (err) {
                    console.error('Palette extraction failed', err);
                  }
                  storageService.saveSettings(updated);
                  setSettings(storageService.getSettings());
                  refresh();
                  showFeedback('✓ Store logo updated & brand theme colors auto-matched from logo!');
                };
                reader.readAsDataURL(file);
              };

              const handleAutoMatchLogo = async () => {
                if (!settings.shopLogo) {
                  alert('Please upload a store logo first.');
                  return;
                }
                try {
                  const extracted = await extractPaletteFromLogo(settings.shopLogo);
                  if (extracted && extracted.primary) {
                    const updated = {
                      ...settings,
                      brandPrimary: extracted.primary,
                      brandPrimaryHover: extracted.primary,
                      brandAccent: extracted.accent || settings.brandAccent,
                      brandSidebar: extracted.sidebar || settings.brandSidebar,
                      brandSurface: extracted.surface || settings.brandSurface
                    };
                    storageService.saveSettings(updated);
                    setSettings(storageService.getSettings());
                    applyBrandTheme(updated);
                    setLogoExtractedPalette(extracted);
                    refresh();
                    showFeedback('✓ Global interface theme matched to your logo colors!');
                  } else {
                    showFeedback('Could not detect distinct palette from logo.');
                  }
                } catch (err) {
                  showFeedback('Failed to extract colors from logo.');
                }
              };

              const handlePaste = (e) => {
                const items = e.clipboardData?.items || [];
                for (let i = 0; i < items.length; i++) {
                  if (items[i].type.indexOf('image') !== -1) {
                    const blob = items[i].getAsFile();
                    handleLogoFile(blob);
                    e.preventDefault();
                    break;
                  }
                }
              };

              const applyPreset = (preset) => {
                const updated = {
                  ...settings,
                  brandPrimary: preset.primary,
                  brandPrimaryHover: preset.primaryHover,
                  brandAccent: preset.accent,
                  brandSidebar: preset.sidebar,
                  brandSurface: preset.surface,
                  appearance: preset.appearance
                };
                storageService.saveSettings(updated);
                setSettings(storageService.getSettings());
                applyBrandTheme(updated);
                refresh();
                showFeedback(`✓ Applied theme: ${preset.name}`);
              };

              const updateLedgerThemePreview = (event, cssVariable, valueKey) => {
                const editor = event.currentTarget.closest('[data-ledger-theme-editor]');
                if (!editor) return;
                editor.style.setProperty(cssVariable, event.currentTarget.value);
                const valueNode = editor.querySelector(`[data-ledger-color-value="${valueKey}"]`);
                if (valueNode) valueNode.textContent = event.currentTarget.value.toUpperCase();
                const card=event.currentTarget.closest('[data-ledger-color-card]');
                const hex=event.currentTarget.value;
                const rgb=[parseInt(hex.slice(1,3),16)/255,parseInt(hex.slice(3,5),16)/255,parseInt(hex.slice(5,7),16)/255];
                const k=1-Math.max(...rgb);
                const c=k===1?0:(1-rgb[0]-k)/(1-k),m=k===1?0:(1-rgb[1]-k)/(1-k),y=k===1?0:(1-rgb[2]-k)/(1-k);
                [c,m,y,k].forEach((value,index)=>{const input=card?.querySelector(`[data-cmyk-index="${index}"]`);if(input)input.value=String(Math.round(value*100));});
              };
              const hexToCmyk = hex => {
                const rgb=[parseInt(hex.slice(1,3),16)/255,parseInt(hex.slice(3,5),16)/255,parseInt(hex.slice(5,7),16)/255];
                const k=1-Math.max(...rgb);
                if(k===1)return[0,0,0,100];
                return [...rgb.map(channel=>Math.round(((1-channel-k)/(1-k))*100)),Math.round(k*100)];
              };
              const updateLedgerCmykPreview=(event,name,cssVariable)=>{
                const card=event.currentTarget.closest('[data-ledger-color-card]');
                const editor=event.currentTarget.closest('[data-ledger-theme-editor]');
                if(!card||!editor)return;
                const values=[0,1,2,3].map(index=>Math.min(100,Math.max(0,Number(card.querySelector(`[data-cmyk-index="${index}"]`)?.value||0)))/100);
                const [c,m,y,k]=values;
                const rgb=[c,m,y].map(channel=>Math.round(255*(1-channel)*(1-k)));
                const hex=`#${rgb.map(channel=>channel.toString(16).padStart(2,'0')).join('')}`;
                const colorInput=card.querySelector(`input[name="${name}"]`);
                if(colorInput)colorInput.value=hex;
                editor.style.setProperty(cssVariable,hex);
                const valueNode=editor.querySelector(`[data-ledger-color-value="${name}"]`);
                if(valueNode)valueNode.textContent=hex.toUpperCase();
              };
              const ledgerColorControl = (name, label, description, value, cssVariable) => {
                const cmyk=hexToCmyk(value);
                return h('div',{'data-ledger-color-card':'',className:'group relative rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs transition-all duration-200 hover:border-indigo-400 hover:shadow-xs'},[
                  h('label',{className:'flex cursor-pointer items-center gap-3.5'},[
                    h('div',{className:'relative shrink-0'},[
                      h('input',{name,type:'color',defaultValue:value,onInput:event=>updateLedgerThemePreview(event,cssVariable,name),className:'h-11 w-11 cursor-pointer rounded-xl border border-slate-200 bg-white p-1 shadow-2xs transition-transform group-hover:scale-105'})
                    ]),
                    h('div',{className:'min-w-0 flex-1'},[
                      h('div',{className:'flex items-center justify-between gap-1.5'},[
                        h('span',{className:'text-[11px] font-black uppercase tracking-wider text-slate-800'},label),
                        h('code',{'data-ledger-color-value':name,className:'rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[9px] font-bold text-slate-600 transition group-hover:bg-indigo-50 group-hover:text-indigo-600'},value.toUpperCase())
                      ]),
                      h('span',{className:'mt-0.5 block text-[10px] font-medium text-slate-400 truncate'},description)
                    ])
                  ]),
                  h('details',{className:'group/cmyk mt-2.5 border-t border-slate-100 pt-2'},[
                    h('summary',{className:'flex cursor-pointer items-center justify-between text-[8px] font-bold text-slate-400 hover:text-indigo-600 list-none'},[
                      h('span',{},'CMYK Print Breakdown'),
                      h(Icon,{name:'chevronDown',className:'h-2.5 w-2.5 transition-transform group-open/cmyk:rotate-180'})
                    ]),
                    h('div',{className:'mt-2 grid grid-cols-4 gap-1.5'},['C','M','Y','K'].map((channel,index)=>h('label',{key:channel,className:'flex items-center gap-1 bg-slate-50 p-1 rounded-md border border-slate-100'},[
                      h('span',{className:'text-[8px] font-black text-slate-400 w-2.5 text-center'},channel),
                      h('input',{'data-cmyk-index':index,type:'number',min:0,max:100,defaultValue:cmyk[index],onInput:event=>updateLedgerCmykPreview(event,name,cssVariable),className:'w-full rounded border-0 bg-transparent text-center font-mono text-[9px] font-bold text-slate-700 outline-none focus:bg-white'})
                    ])))
                  ])
                ]);
              };
              const applyBalanceSheetScheme = (scheme, event) => {
                const section = event.currentTarget.closest('[data-ledger-theme-editor]');
                if (!section) return;
                const form = section.closest('form');
                if (form) {
                  if (form.balanceSheetHeaderColor) form.balanceSheetHeaderColor.value = scheme.header;
                  if (form.balanceSheetHeaderTextColor) form.balanceSheetHeaderTextColor.value = scheme.headerText;
                  if (form.balanceSheetFooterColor) form.balanceSheetFooterColor.value = scheme.footer;
                  if (form.balanceSheetFooterTextColor) form.balanceSheetFooterTextColor.value = scheme.footerText;
                  if (form.balanceSheetAlternateColor) form.balanceSheetAlternateColor.value = scheme.alt;
                  if (form.balanceSheetAlternateTint) {
                    form.balanceSheetAlternateTint.value = scheme.tint;
                    const out = section.querySelector('[data-balance-sheet-tint-output]');
                    if (out) out.textContent = `${scheme.tint}%`;
                  }
                }
                section.style.setProperty('--ledger-preview-header', scheme.header);
                section.style.setProperty('--ledger-preview-header-text', scheme.headerText);
                section.style.setProperty('--ledger-preview-footer', scheme.footer);
                section.style.setProperty('--ledger-preview-footer-text', scheme.footerText);
                section.style.setProperty('--ledger-preview-alt', scheme.alt);
                section.style.setProperty('--ledger-preview-tint', `${scheme.tint}%`);
                const setCardVal = (name, val) => {
                  const el = section.querySelector(`[data-ledger-color-value="${name}"]`);
                  if (el) el.textContent = val.toUpperCase();
                  const inp = section.querySelector(`input[name="${name}"]`);
                  if (inp) inp.value = val;
                };
                setCardVal('balanceSheetHeaderColor', scheme.header);
                setCardVal('balanceSheetHeaderTextColor', scheme.headerText);
                setCardVal('balanceSheetFooterColor', scheme.footer);
                setCardVal('balanceSheetFooterTextColor', scheme.footerText);
                setCardVal('balanceSheetAlternateColor', scheme.alt);
              };
              const applyAllTxScheme = (scheme, event) => {
                const section = event.currentTarget.closest('[data-ledger-theme-editor]');
                if (!section) return;
                const form = section.closest('form');
                if (form) {
                  if (form.allTransactionsHeaderColor) form.allTransactionsHeaderColor.value = scheme.header;
                  if (form.allTransactionsHeaderTextColor) form.allTransactionsHeaderTextColor.value = scheme.headerText;
                  if (form.allTransactionsFooterColor) form.allTransactionsFooterColor.value = scheme.footer;
                  if (form.allTransactionsFooterTextColor) form.allTransactionsFooterTextColor.value = scheme.footerText;
                  if (form.allTransactionsAlternateColor) form.allTransactionsAlternateColor.value = scheme.alt;
                  if (form.allTransactionsAlternateTint) {
                    form.allTransactionsAlternateTint.value = scheme.tint;
                    const out = section.querySelector('[data-alltx-tint-output]');
                    if (out) out.textContent = `${scheme.tint}%`;
                  }
                }
                section.style.setProperty('--alltx-preview-header', scheme.header);
                section.style.setProperty('--alltx-preview-header-text', scheme.headerText);
                section.style.setProperty('--alltx-preview-footer', scheme.footer);
                section.style.setProperty('--alltx-preview-footer-text', scheme.footerText);
                section.style.setProperty('--alltx-preview-alt', scheme.alt);
                section.style.setProperty('--alltx-preview-tint', `${scheme.tint}%`);
                const setCardVal = (name, val) => {
                  const el = section.querySelector(`[data-ledger-color-value="${name}"]`);
                  if (el) el.textContent = val.toUpperCase();
                  const inp = section.querySelector(`input[name="${name}"]`);
                  if (inp) inp.value = val;
                };
                setCardVal('allTransactionsHeaderColor', scheme.header);
                setCardVal('allTransactionsHeaderTextColor', scheme.headerText);
                setCardVal('allTransactionsFooterColor', scheme.footer);
                setCardVal('allTransactionsFooterTextColor', scheme.footerText);
                setCardVal('allTransactionsAlternateColor', scheme.alt);
              };
              
              return h("div", {
                onPaste: handlePaste,
                tabIndex: 0,
                className: "bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-6 outline-none animate-fade-in"
              }, [
                h("div", { className: "border-b border-slate-100 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2" }, [
                  h("div", {}, [
                    h("h3", { className: "text-base font-black text-slate-900" }, "Branding & Interface Theme"),
                    h("p", { className: "text-xs text-slate-500 mt-0.5" }, "Upload your store logo and theme colors will automatically adapt to your brand.")
                  ]),
                  h("span", { className: "text-[10px] font-bold text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-full border border-indigo-100 w-fit" }, "Real-time Live Sync")
                ]),

                // ── LOGO UPLOAD & PASTE SECTION ──
                h("div", { className: "space-y-3" }, [
                  h("h4", { className: "text-xs font-black uppercase tracking-wider text-slate-700" }, "Store Logo & Auto Color Match"),
                  h("div", { className: "p-4 rounded-2xl border border-slate-200 bg-slate-50 flex flex-col md:flex-row items-center gap-5" }, [
                    // Preview box
                    h("div", { className: "relative w-24 h-24 rounded-2xl bg-white border-2 border-dashed border-slate-300 p-2 flex items-center justify-center overflow-hidden shrink-0 shadow-2xs group" }, [
                      settings.shopLogo
                        ? h("img", { src: settings.shopLogo, alt: "Shop Logo", className: "w-full h-full object-contain" })
                        : h("div", { className: "text-center space-y-1" }, [
                            h(Icon, { name: "file", className: "w-6 h-6 text-slate-300 mx-auto" }),
                            h("span", { className: "text-[10px] font-bold text-slate-400 block" }, "No Logo")
                          ]),
                      settings.shopLogo && h("button", {
                        type: "button",
                        title: "Remove Logo",
                        onClick: () => {
                          const updated = { ...settings, shopLogo: '' };
                          storageService.saveSettings(updated);
                          setSettings(storageService.getSettings());
                          refresh();
                          showFeedback('✓ Logo removed.');
                        },
                        className: "absolute top-1 right-1 p-1 rounded-lg bg-rose-600 text-white text-[10px] shadow-sm hover:bg-rose-700 cursor-pointer"
                      }, h(Icon, { name: "x", className: "w-3 h-3" }))
                    ]),

                    // Controls & Paste Zone
                    h("div", { className: "flex-1 space-y-3 w-full" }, [
                      h("div", { className: "flex flex-wrap items-center gap-2.5" }, [
                        h("label", {
                          className: "inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-black cursor-pointer shadow-xs transition-all"
                        }, [
                          h(Icon, { name: "plus", className: "w-3.5 h-3.5" }),
                          "Upload Logo Image",
                          h("input", {
                            type: "file",
                            accept: "image/*",
                            onChange: (e) => handleLogoFile(e.target.files[0]),
                            className: "hidden"
                          })
                        ]),
                        settings.shopLogo && h("button", {
                          type: "button",
                          onClick: handleAutoMatchLogo,
                          className: "inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-indigo-200 bg-white hover:bg-indigo-50 text-indigo-700 text-xs font-black cursor-pointer shadow-2xs transition-all"
                        }, [
                          h(Icon, { name: "sparkles", className: "w-3.5 h-3.5 text-indigo-600" }),
                          "✨ Auto-Match Colors to Logo"
                        ]),
                        h("span", { className: "text-[11px] font-semibold text-slate-400" }, "or paste directly with Ctrl+V")
                      ]),

                      // Paste / Drop Zone Card
                      h("div", {
                        onDragOver: (e) => { e.preventDefault(); e.stopPropagation(); },
                        onDrop: (e) => {
                          e.preventDefault();
                          e.stopPropagation();
                          if (e.dataTransfer.files?.[0]) handleLogoFile(e.dataTransfer.files[0]);
                        },
                        className: "p-3 rounded-xl border border-dashed border-indigo-200 bg-indigo-50/50 flex items-center justify-between text-xs text-indigo-900 font-medium"
                      }, [
                        h("div", { className: "flex items-center gap-2" }, [
                          h(Icon, { name: "paperclip", className: "w-4 h-4 text-indigo-500" }),
                          h("span", {}, "Paste image anywhere on this page (Ctrl+V) or drop file here")
                        ]),
                        h("span", { className: "text-[10px] font-mono font-bold text-indigo-600 bg-white px-2 py-0.5 rounded border border-indigo-100" }, "PNG / JPG / SVG / WebP")
                      ])
                    ])
                  ])
                ]),

                // ── 6 PRESET LOGO-MATCHED THEMES ──
                h("div", { className: "space-y-3 pt-2" }, [
                  h("div", { className: "flex items-center justify-between" }, [
                    h("h4", { className: "text-xs font-black uppercase tracking-wider text-slate-700" }, settings.shopLogo ? "Logo-Matched Preset Themes (6 Adaptive Styles)" : "Select Preset Theme (6 Curated Styles)"),
                    h("span", { className: "text-[10px] font-semibold text-slate-400" }, settings.shopLogo ? "Auto-adapted from store logo" : "1-click global styling")
                  ]),

                  h("div", { className: "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3" },
                    generateLogoPresets(settings.shopLogo, logoExtractedPalette).map(preset => {
                      const isActive = (settings.brandPrimary === preset.primary && settings.appearance === preset.appearance);
                      return h("button", {
                        key: preset.id,
                        type: "button",
                        onClick: () => applyPreset(preset),
                        className: `text-left p-3.5 rounded-2xl border-2 transition-all cursor-pointer relative flex flex-col justify-between gap-3 ${
                          isActive
                            ? 'border-indigo-600 bg-indigo-50/40 shadow-xs ring-2 ring-indigo-500/20'
                            : 'border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50/50'
                        }`
                      }, [
                        h("div", { className: "flex items-start justify-between gap-2" }, [
                          h("div", {}, [
                            h("h5", { className: "text-xs font-black text-slate-900" }, preset.name),
                            h("p", { className: "text-[10px] text-slate-500 mt-0.5" }, preset.tagline)
                          ]),
                          isActive && h("span", { className: "inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-600 text-white shadow-2xs" },
                            h(Icon, { name: "check", className: "w-3 h-3" })
                          )
                        ]),
                        h("div", { className: "flex items-center gap-1.5 pt-1 border-t border-slate-100" }, [
                          ...preset.swatch.map((color, cIdx) =>
                            h("span", {
                              key: cIdx,
                              style: { backgroundColor: color },
                              className: "w-5 h-5 rounded-lg shadow-2xs border border-white/50"
                            })
                          ),
                          h("span", { className: "text-[9px] font-bold uppercase text-slate-400 ml-auto" }, preset.appearance === 'dark' ? 'Dark' : 'Light')
                        ])
                      ]);
                    })
                  )
                ]),

                // ── CUSTOM THEME FINE-TUNING FORM ──
                h("form", {
                  onSubmit: (e) => {
                    e.preventDefault();
                    const f = e.currentTarget;
                    const primary = f.brandColor.value;
                    const appearance = f.themeMode.value;
                    const updated = {
                      ...settings,
                      brandPrimary: primary,
                      appearance,
                      balanceSheetHeaderColor: f.balanceSheetHeaderColor.value,
                      balanceSheetHeaderTextColor: f.balanceSheetHeaderTextColor.value,
                      balanceSheetFooterColor: f.balanceSheetFooterColor.value,
                      balanceSheetFooterTextColor: f.balanceSheetFooterTextColor.value,
                      balanceSheetAlternateColor: f.balanceSheetAlternateColor.value,
                      balanceSheetAlternateTint: Number(f.balanceSheetAlternateTint.value),
                      allTransactionsHeaderColor: f.allTransactionsHeaderColor ? f.allTransactionsHeaderColor.value : (settings.allTransactionsHeaderColor || '#1e293b'),
                      allTransactionsHeaderTextColor: f.allTransactionsHeaderTextColor ? f.allTransactionsHeaderTextColor.value : (settings.allTransactionsHeaderTextColor || '#ffffff'),
                      allTransactionsFooterColor: f.allTransactionsFooterColor ? f.allTransactionsFooterColor.value : (settings.allTransactionsFooterColor || '#1e293b'),
