            h("div", {}, [h("h3", { className: "font-black text-lg text-slate-900" }, editingExpense ? "Edit Expense" : "Record Shop Expense"), h("p", {className:"mt-1 text-xs text-slate-500"}, "Add the expense details. Stock fields appear only for stocking categories.")]),
            h("button", { type: "button", onClick: () => setIsExpenseModalOpen(false), className: "text-slate-400 hover:text-slate-700 cursor-pointer" }, h(Icon, { name: "x" }))
          ]),

          h("form", {
            onSubmit: async (e) => {
              e.preventDefault();
              const f = e.target;
              const title = f.expTitle.value.trim();
              const amount = parseFloat(f.expAmount.value) || 0;
              if (!title || amount <= 0) { alert('Please enter expense title and valid amount.'); return; }
              const expenseDate = storageService.dateInputToAD(f.expDate.value);
              if (!expenseDate) { alert('Please enter a valid expense date.'); return; }
              const vendor = storageService.getVendorById(f.expVendor.value);
              const paymentMethod = f.expPaymentMethod.value;
              const category = f.expCategory.value;
              const isStockingExpense = /material\s*stock|ink\s*&?\s*toner|raw\s*material|stocking|purchase/i.test(category);
              const linkedStockItemId = String(f.expStockItem?.value || '');
              const stockQuantity = Math.max(0, Number(f.expStockQuantity?.value || 0));
              if (isStockingExpense && (!linkedStockItemId || stockQuantity <= 0)) {
                alert('For a stocking expense, choose the stock product and enter the received quantity.');
                return;
              }

              let receipt = editingExpense?.receipt;
              const receiptFileInput = f.expReceipt?.files?.[0];
              if (receiptFileInput) {
                const rId = createId('rec');
                const rRecord = { id: rId, name: receiptFileInput.name, type: receiptFileInput.type, size: receiptFileInput.size, blob: receiptFileInput };
                await mediaStore.putMany([rRecord]);
                receipt = { id: rId, name: receiptFileInput.name, type: receiptFileInput.type, size: receiptFileInput.size };
              }

              storageService.saveExpense({
                id: editingExpense?.id,
                expenseNumber: editingExpense?.expenseNumber,
                title: title,
                category,
                vendorId: vendor?.id || '',
                vendor: vendor?.name || '',
                paymentMethod: paymentMethod,
                paidBy: f.expPaidBy?.value?.trim() || '',
                amount: amount,
                date: expenseDate,
                notes: f.expNotes.value.trim(),
                receipt: receipt,
                paymentHistory: editingExpense?.paymentHistory || [],
                linkedPurchaseId: isStockingExpense ? linkedStockItemId : undefined,
                stockQuantity: isStockingExpense ? stockQuantity : undefined
              });

              refresh();
              setIsExpenseModalOpen(false);
            },
            className: "space-y-3.5 text-xs"
          }, [
            h("div", {}, [
              h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Expense Title *"),
              h("input", { type: "text", name: "expTitle", required: true, defaultValue: editingExpense?.title || '', placeholder: "e.g. Vinyl Roll Stock (54 inch)", className: "w-full p-2.5 border border-slate-200 rounded-xl text-sm font-semibold focus:ring-2 focus:ring-indigo-500 focus:outline-none" })
            ]),
            h("div", { className: "grid grid-cols-2 gap-3" }, [
              h("div", {}, [
                h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Category"),
                h("select", { name: "expCategory", value:expenseCategoryDraft, onChange:event=>setExpenseCategoryDraft(event.target.value), className: "w-full p-2.5 border border-slate-200 rounded-xl text-sm font-semibold bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none cursor-pointer" }, EXPENSE_CATEGORIES.map(c => h("option", { key: c, value: c }, c)))
              ]),
              h("div", {}, [
                h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Vendor"),
