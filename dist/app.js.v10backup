              h("label", { className: "block text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1" }, stockParentId ? "Entry Name *" : "Stock Product Name *"),
              h("input", { name: "stockName", required: true, defaultValue:editingStockItem?.name || '', placeholder: stockParentId ? "e.g. New lot, Red, 20mm" : "e.g. Dori, Flex Banner, Eco Ink", className: "w-full p-2.5 rounded-xl border border-slate-200 bg-slate-50/50 text-xs font-bold text-slate-900 focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all" })
            ]),
            h("div", {}, [
