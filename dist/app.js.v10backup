              h("div", {}, [
              h("h2", { className: "font-black text-slate-900 text-lg" }, editingStockItem ? (editingStockItem.parentId ? "Edit Stock Entry" : "Edit Stock Product") : stockParentId ? "Add Stock Entry" : "Add Stock Product"),
                h("p", { className: "text-xs font-semibold text-slate-500 mt-0.5" }, editingStockItem ? "Update the saved stock details." : stockParentId ? `Create an entry inside ${stock.find(item=>item.id===stockParentId)?.name || 'this stock product'}.` : "Create a stock product. Open it afterwards to manage its entries.")
              ])
            ]),
            h("button", {
              type: "button",
              onClick:()=>{setEditingStockItem(null);setStockParentId('');setIsAddStockOpen(false);},
              "aria-label":"Close stock product popup",
              className: "inline-flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 bg-slate-50 text-slate-500 hover:bg-slate-100"
            }, [
