                    h("span", { className: "block text-[10px] text-slate-500 mt-0.5" }, "Prompt to open WhatsApp message when order status advances or ready for pickup")
                  ]),
                  h("input", { name: "notificationsEnabled", type: "checkbox", defaultChecked: settings.whatsappNotificationsEnabled !== false, className: "w-5 h-5 rounded accent-emerald-600 cursor-pointer" })
                ]),

                h("div", {}, [
                  h("label", { className: "block font-bold uppercase text-slate-600 mb-1" }, "Sender WhatsApp Number"),
                  h("input", { name: "senderNumber", type: "tel", inputMode: "numeric", pattern: "[0-9]*", onInput: e => { e.currentTarget.value = e.currentTarget.value.replace(/\D/g, ''); }, defaultValue: settings.whatsappSenderNumber || settings.shopPhone || '9800000000', className: "w-full p-2.5 border border-slate-200 rounded-xl text-sm font-mono focus:ring-2 focus:ring-emerald-500 focus:outline-none" })
                ]),

