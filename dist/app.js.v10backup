                                    h("span", { className: `px-2 py-0.5 rounded-md text-[9px] font-black uppercase tracking-wider ${isStocking ? 'bg-violet-50 text-violet-700 border border-violet-200' : 'bg-slate-100 text-slate-700 border border-slate-200'}` }, isStocking ? "Stocking" : "Expense")
                                  ]),
                                  h("td", { className: "p-3 text-center whitespace-nowrap" }, [
                                    h("span", { className: `px-2 py-0.5 rounded-full text-[9px] font-bold ${item.status === 'Paid' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : item.status === 'Credit' || item.status === 'Unpaid' ? 'bg-rose-50 text-rose-700 border border-rose-200' : 'bg-orange-50 text-orange-700 border border-orange-200'}` }, `${item.payment || 'Cash'} • ${item.status || 'Paid'}`)
                                  ]),
                                  h("td", { className: "p-3 text-right font-mono font-black text-rose-700 text-sm bg-rose-50/40" }, storageService.formatCurrency(costAmt))
                                ]);
                              }))
                            ])
                          ])
                    ])
                  ]);
                })(),

                // SUB-TAB 1: LEDGER (DEFAULT)
                financialSubTab === 'ledger' && h("div", { className: "space-y-4" }, [
                  // Toolbar: Search, Payment Method, Date Range, Opening Balance, Export
                  h("div", { className: "bg-white rounded-xl border border-slate-200 p-2.5 shadow-2xs" }, [
                    h("div", { className: "flex flex-col sm:flex-row sm:items-center justify-between gap-2" }, [
                      // Search
                      h("div", { className: "relative flex-1 sm:max-w-xs lg:max-w-sm" }, [
                        h("input", {
                          type: "text",
                          value: financialSearch,
                          onChange: (e) => setFinancialSearch(e.target.value),
                          placeholder: "Search ref no, party name, details...",
                          className: "w-full pl-8 pr-3 py-1.5 border border-slate-200 rounded-lg text-xs font-semibold text-slate-800 placeholder-slate-400 focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all"
                        }),
                        h("span", { className: "absolute left-2.5 top-2 text-slate-400" }, h(Icon, { name: "search", className: "w-3.5 h-3.5" }))
                      ]),

                      // Filters & Buttons
                      h("div", { className: "flex flex-wrap items-center gap-2 shrink-0" }, [
                        // Payment Method Filter
                        h("select", {
                          value: financialPaymentFilter,
                          onChange: (e) => setFinancialPaymentFilter(e.target.value),
                          className: "px-2.5 py-1.5 border border-slate-200 rounded-lg text-xs font-bold bg-white text-slate-700 focus:ring-2 focus:ring-indigo-500 focus:outline-none cursor-pointer shadow-2xs"
                        }, [
                          h("option", { value: "ALL" }, "All Payment Methods"),
                          h("option", { value: "Cash" }, "Cash"),
                          h("option", { value: "Online" }, "Online"),
                          h("option", { value: "Credit" }, "Credit"),
                          h("option", { value: "Bank" }, "Bank"),
                          h("option", { value: "Partial" }, "Partial")
                        ]),

                        // Date Range Filter
                        h("select", {
                          value: financialDateRange,
                          onChange: (e) => setFinancialDateRange(e.target.value),
                          className: "px-2.5 py-1.5 border border-slate-200 rounded-lg text-xs font-bold bg-white text-slate-700 focus:ring-2 focus:ring-indigo-500 focus:outline-none cursor-pointer shadow-2xs"
                        }, [
                          h("option", { value: "ALL" }, "Date Range"),
                          h("option", { value: "FIRST_HALF" }, "1st–15th"),
                          h("option", { value: "SECOND_HALF" }, "16th–End")
                        ]),

                        // Edit Opening Balance Button
                        h("button", {
                          type: "button",
                          onClick: () => {
                            setOpeningBalanceInput(String(settings.openingCashBalance == null ? Number(settings.openingBalance || 0) : Number(settings.openingCashBalance || 0)));
                            setOpeningBankBalanceInput(String(settings.openingBankBalance == null ? 0 : Number(settings.openingBankBalance || 0)));
                            setIsEditingOpeningBalance(true);
                          },
                          className: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold shadow-2xs transition-all cursor-pointer"
                        }, [
                          h(Icon, { name: "edit", className: "w-3.5 h-3.5 text-slate-500" }),
                          "Opening Balance"
                        ]),

                        // Export Button
                        h("button", {
                          type: "button",
                          onClick: () => openFinancialExportModal(financialTypeFilter || 'ALL'),
                          className: "inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-black shadow-2xs transition-all cursor-pointer"
                        }, [
                          h(Icon, { name: "download", className: "w-3.5 h-3.5" }),
                          financialTypeFilter === 'JOB' ? "Export Jobs PDF" :
                          financialTypeFilter === 'PAYMENT' ? "Export Receipts PDF" :
                          financialTypeFilter === 'CREDIT_PAID' ? "Export Payments PDF" :
                          "Export PDF"
                        ])
                      ])
                    ])
                  ]),


                  // Table Container
                  h("div", { className: "bg-white rounded-xl border border-slate-200 shadow-2xs overflow-hidden relative" }, [
                    // Backdrop for action menu
                    financialLedgerActionMenu && h("div", {
                      className: "fixed inset-0 z-20 cursor-default",
                      onClick: () => setFinancialLedgerActionMenu(null)
                    }),

                    financialTypeFilter === 'ALL' ? renderAllTransactionsTable() : h("div", { className: "financial-desktop-ledger overflow-visible" }, [
                      h("table", { className: "w-full table-fixed text-left border-collapse text-[10px]" }, [
                        h("colgroup", {}, [
                          h("col", { style: { width: "3%" } }),
                          h("col", { style: { width: "7%" } }),
                          h("col", { style: { width: "7%" } }),
                          h("col", { style: { width: "8%" } }),
                          h("col", { style: { width: "9%" } }),
                          h("col", { style: { width: "10%" } }),
                          h("col", { style: { width: "4%" } }),
                          h("col", { style: { width: "7%" } }),
                          h("col", { style: { width: "8%" } }),
                          h("col", { style: { width: "6%" } }),
                          showBilledOutflow && h("col", { style: { width: "8%" } }),
                          h("col", { style: { width: "8%" } }),
                          h("col", { style: { width: "8%" } }),
                          showFinancialOutstanding && (financialTypeFilter === 'CREDIT_PAID' ? h("col", { style: { width: "10%" } }) : h("col", { style: { width: "6%" } })),
                          showFinancialOutstanding && financialTypeFilter !== 'CREDIT_PAID' && h("col", { style: { width: "6%" } }),
                          h("col", { style: { width: "5%" } })
                        ]),
                        // Thead: Outstanding is split by money we pay vs money we receive.
                        h("thead", {
                          style: settings.allTransactionsHeaderColor ? {
                            backgroundColor: settings.allTransactionsHeaderColor,
                            color: settings.allTransactionsHeaderTextColor || '#ffffff'
                          } : undefined,
                          className: `${settings.allTransactionsHeaderColor ? '' : 'bg-slate-50 text-slate-500'} sticky top-0 z-10 text-[10px] font-bold uppercase tracking-wider border-b border-slate-200 select-none`
                        }, [
                          h("tr", { className: "h-8" }, [
                            ...[
                              ["S.N.", "py-2 px-2 text-center w-10 shrink-0"], ["Date", "py-2 px-2 text-left whitespace-nowrap w-24"], ["Ref No.", "py-2 px-2 text-left whitespace-nowrap w-24"], ["Type", "py-2 px-2 text-center whitespace-nowrap w-32"], ["Party Name", "py-2 px-2.5 text-left w-44"], ["Details", "py-2 px-2.5 text-left"], ["PCS", "py-2 px-2 text-right whitespace-nowrap"], ["Amount (Rs.)", "py-2 px-2 text-right whitespace-nowrap"], ["Payment Method", "py-2 px-2 text-center whitespace-nowrap w-28"], ["Status", "py-2 px-2 text-center whitespace-nowrap w-20"], showBilledOutflow && [financialTypeFilter === 'CREDIT_PAID' ? "Credit Bill Amount" : "Billed / Outflow", "py-2 px-2.5 text-right text-rose-600 whitespace-nowrap w-28"], [financialTypeFilter === 'CREDIT_PAID' ? "Paid Amount" : "Paid / Received", "py-2 px-2.5 text-right text-emerald-600 whitespace-nowrap w-28"], ["Balance (Rs.)", "py-2 px-2.5 text-right text-slate-900 whitespace-nowrap w-32"]
                            ].filter(Boolean).map(([label,classes])=>h("th",{key:label,rowSpan:showFinancialOutstanding?2:1,className:`${classes} font-bold align-middle`},label)),
                            showFinancialOutstanding && h("th", { colSpan: financialTypeFilter === 'CREDIT_PAID' ? 1 : 2, className: "pt-2 pb-1 px-1 text-center font-black text-slate-700 whitespace-nowrap border-x border-slate-300" }, financialTypeFilter === 'CREDIT_PAID' ? "Credit to Pay (Rs.)" : "Outstanding (Rs.)"),
                            h("th", { rowSpan: showFinancialOutstanding ? 2 : 1, className: "py-2 px-1 text-center w-[56px] min-w-[56px] pr-3 shrink-0 font-bold align-middle" }, "Action")
                          ]),
                          showFinancialOutstanding && (financialTypeFilter === 'CREDIT_PAID' ? h("tr", { className: "h-7 border-t border-slate-200/80" }, [
                            h("th", { className: "pb-2 pt-1 px-1 text-center font-black text-rose-600 whitespace-nowrap border-x border-slate-300 bg-rose-50/50" }, "Due to Pay")
                          ]) : h("tr", { className: "h-7 border-t border-slate-200/80" }, [
                            h("th", { className: "pb-2 pt-1 px-1 text-center font-black text-rose-600 whitespace-nowrap border-l border-slate-300 bg-rose-50/50" }, "Paying"),
                            h("th", { className: "pb-2 pt-1 px-1 text-center font-black text-rose-700 whitespace-nowrap border-x border-slate-300 bg-rose-100/70" }, "Receiving")
                          ]))
                        ]),

                        // Tbody
                        h("tbody", { className: "divide-y divide-slate-100 bg-white" }, [
                          pagedLedgerEntries.length === 0
                            ? h("tr", {}, [
                                h("td", { colSpan: showFinancialOutstanding ? (financialTypeFilter === 'CREDIT_PAID' ? 15 : 16) : (showBilledOutflow ? 14 : 13), className: "text-center py-12 text-slate-400 font-medium" }, "No financial ledger records found for the selected criteria.")
                              ])
                            : pagedLedgerEntries.map((entry, idx) => {
                                const isUnpaidSupplierCredit = (entry.type === 'stocking' || entry.type === 'expense') && entry.payment === 'Credit' && Number(entry.outstandingCredit || 0) > 0;
                                const isOpening = entry.type === 'opening';
                                const rowSn = pageStart + idx + 1;

                                return h("tr", {
                                  key: entry.id,
                                  style: (!isUnpaidSupplierCredit && !isOpening && (idx % 2 === 1)) ? {
                                    backgroundColor: `color-mix(in srgb, ${settings.allTransactionsAlternateColor || '#f8fafc'} ${settings.allTransactionsAlternateTint ?? 100}%, white)`
                                  } : undefined,
                                  className: `h-10 transition-colors ${
                                    isUnpaidSupplierCredit
                                      ? 'bg-amber-50/40 hover:bg-amber-50/70 border-l-2 border-l-amber-400'
                                      : isOpening
                                      ? 'bg-slate-50/50 hover:bg-slate-50'
                                      : 'hover:bg-slate-50/70'
                                  }`
                                }, [
                                  // 1. S.N.
                                  h("td", { className: "py-2 px-2 text-center font-mono text-[10px] text-slate-400" }, rowSn),

                                  // 2. Date
                                  h("td", { className: "py-2 px-2 font-bold text-slate-700 whitespace-nowrap text-[11px]" },
                                    storageService.formatDateForMode(entry.date, settings.dateMode)
                                  ),

                                  // 3. Ref No.
                                  h("td", { className: "py-2 px-2 font-mono font-bold text-indigo-600 whitespace-nowrap text-[11px]" },
                                    isOpening
                                      ? h("span", { className: "text-slate-300 font-normal" }, "—")
                                      : entry.type === 'job'
                                      ? h("button", {
                                          type: "button",
                                          onClick: () => {
                                            const job = orders.find(order => order.orderNumber === entry.jobNo);
                                            if (job) setSelectedOrder(job);
                                          },
                                          className: "hover:underline cursor-pointer"
                                        }, entry.jobNo)
                                      : entry.jobNo
                                  ),

                                  // 4. Type
                                  h("td", { className: "py-2 px-2 text-center whitespace-nowrap" }, renderTypeBadge(entry.type)),

                                  // 5. Party Name
                                  h("td", { className: "py-2 px-2.5 font-bold text-slate-900 truncate max-w-[160px] text-[11px]" },
                                    isOpening ? h("span", { className: "text-slate-300 font-normal" }, "—") : entry.partyName
                                  ),

                                  // 6. Details
                                  h("td", { className: "py-2 px-2.5 text-slate-600 truncate max-w-[240px] text-[11px]", title: entry.details }, entry.details),

                                  // 7. PCS
                                  h("td", { className: "py-2 px-2 text-right font-mono font-bold text-slate-700 whitespace-nowrap text-[11px]" },
                                    Number(entry.pcs || 0) > 0 ? Number(entry.pcs || 0).toLocaleString('en-IN') : h("span", { className: "text-slate-300 font-normal" }, "—")
                                  ),

                                  // 8. Total Amount
                                  h("td", { className: "py-2 px-2 text-right font-mono font-bold text-slate-900 whitespace-nowrap text-[11px]" },
                                    Number(entry.amount || 0) > 0 ? formatMoneyNPR(entry.amount) : h("span", { className: "text-slate-300 font-normal" }, "—")
                                  ),

                                  // 9. Payment Method
                                  h("td", { className: "py-2 px-2 text-center whitespace-nowrap" },
                                    isOpening ? h("span", { className: "text-slate-300 font-normal" }, "—") : renderPaymentBadge(entry.payment)
                                  ),

                                  // 10. Status
                                  h("td", { className: "py-2 px-2 text-center whitespace-nowrap" },
                                    isOpening ? h("span", { className: "text-slate-300 font-normal" }, "—") : renderStatusBadge(entry.status)
                                  ),

                                  // 11. Billed / Outflow
                                  showBilledOutflow && h("td", { className: "py-2 px-2.5 text-right font-mono font-bold text-rose-600 whitespace-nowrap text-[11px]" },
                                    Number(entry.type === 'credit-paid' ? entry.creditOriginalAmount : (entry.billedAmount || entry.drAmount || 0)) > 0
                                      ? formatMoneyNPR(entry.type === 'credit-paid' ? entry.creditOriginalAmount : (entry.billedAmount || entry.drAmount))
                                      : h("span", { className: "text-slate-300 font-normal" }, "—")
                                  ),

                                  // 12. Paid / Received
                                  h("td", { className: "py-2 px-2.5 text-right font-mono font-bold text-emerald-600 whitespace-nowrap text-[11px]" },
                                    Number(entry.receivedAmount || entry.crAmount || 0) > 0 ? formatMoneyNPR(entry.receivedAmount || entry.crAmount) : h("span", { className: "text-slate-300 font-normal" }, "—")
                                  ),

                                  // 11. Balance (Rs.)
                                  h("td", { className: "py-2 px-2.5 text-right font-mono font-black text-slate-900 whitespace-nowrap text-[11px]" },
                                    formatMoneyNPR(entry.runningBalance)
                                  ),

                                  // 12. Outstanding (Paying / Receiving or Credit to Pay)
                                  showFinancialOutstanding && (financialTypeFilter === 'CREDIT_PAID'
                                    ? h("td", { className: "py-2 px-2.5 text-right font-mono whitespace-nowrap text-[11px] border-x border-slate-100 bg-rose-50/20" },
                                        !isOpening && Number(entry.outstandingCredit || 0) > 0
                                          ? h("span", { className: "font-black text-rose-600" }, formatMoneyNPR(entry.outstandingCredit))
                                          : h("span", { className: "text-slate-300 font-normal" }, "—")
                                      )
                                    : [
                                        h("td", { key: "paying", className: "py-2 px-2.5 text-right font-mono whitespace-nowrap text-[11px] border-l border-slate-100 bg-rose-50/20" },
                                          !isOpening && ['expense', 'stocking', 'credit-paid'].includes(entry.type) && Number(entry.outstandingCredit || 0) > 0
                                            ? h("span", { className: "font-black text-rose-600" }, formatMoneyNPR(entry.outstandingCredit))
                                            : h("span", { className: "text-slate-300 font-normal" }, "—")
                                        ),
                                        h("td", { key: "receiving", className: "py-2 px-1 text-right font-mono whitespace-nowrap text-[10px] border-x border-slate-100" },
                                          !isOpening && entry.type === 'job' && Number(entry.outstandingCredit || 0) > 0
                                            ? h("span", { className: "inline-block max-w-full overflow-hidden text-ellipsis rounded-md bg-rose-600 px-1.5 py-1 font-black text-white shadow-xs", title: formatMoneyNPR(entry.outstandingCredit) }, formatMoneyNPR(entry.outstandingCredit))
                                            : h("span", { className: "text-slate-300 font-normal" }, "—")
                                        )
                                      ]
                                  ),

                                  // 14. Action
                                  h("td", { className: "py-2 px-1 text-center w-[56px] min-w-[56px] pr-3 whitespace-nowrap relative" },
                                    isOpening
                                      ? h("span", { className: "text-slate-300" }, "—")
                                      : h("div", { className: "inline-block" }, [
                                          h("button", {
                                            type: "button",
                                            onClick: (e) => {
                                              e.stopPropagation();
                                              setFinancialLedgerActionMenu(financialLedgerActionMenu?.id === entry.id ? null : entry);
                                            },
                                            className: "inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 hover:border-slate-300 text-slate-500 hover:text-slate-800 shadow-2xs transition-colors cursor-pointer",
                                            title: "Actions"
                                          }, [
                                            h(Icon, { name: "moreHorizontal", className: "w-4 h-4" })
                                          ]),

                                          financialLedgerActionMenu?.id === entry.id && h("div", {
                                            className: "absolute right-2 top-8 w-40 rounded-xl bg-white p-1 text-left shadow-lg border border-slate-200 z-30 animate-fade-in"
                                          }, [
                                            // Job actions
                                            entry.type === 'job' && h("button", {
                                              type: "button",
                                              onClick: () => {
                                                setFinancialLedgerActionMenu(null);
                                                const job = orders.find(order => order.orderNumber === entry.jobNo);
                                                if (job) setSelectedOrder(job);
                                              },
                                              className: "w-full text-left px-2.5 py-1.5 rounded-lg text-xs font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors flex items-center gap-2 cursor-pointer"
                                            }, [
                                              h(Icon, { name: "eye", className: "w-3.5 h-3.5" }),
                                              "View Details"
                                            ]),

                                            // Expense actions
                                            entry.type === 'expense' && [
                                              Number(entry.outstandingCredit || 0) > 0 && h("button", {
                                                key: "pay",
                                                type: "button",
                                                onClick: () => {
                                                  setFinancialLedgerActionMenu(null);
                                                  const exp = expenses.find(e => e.id === entry.sourceId) || {
                                                    id: entry.sourceId || entry.id,
                                                    title: entry.details,
                                                    amount: entry.grossAmount,
                                                    outstandingAmount: entry.outstandingCredit,
                                                    vendor: entry.partyName,
                                                    paymentMethod: 'Credit',
                                                    paymentStatus: entry.status
                                                  };
                                                  openExpensePayment(exp);
                                                },
                                                className: "w-full text-left px-2.5 py-1.5 rounded-lg text-xs font-bold text-indigo-600 hover:bg-indigo-50 transition-colors flex items-center gap-2 cursor-pointer"
                                              }, [
                                                h(Icon, { name: "creditCard", className: "w-3.5 h-3.5" }),
                                                "Pay Credit"
                                              ]),
                                              entry.paymentHistory && entry.paymentHistory.length > 0 && h("button", {
                                                key: "history",
                                                type: "button",
                                                onClick: () => {
                                                  setFinancialLedgerActionMenu(null);
                                                  const exp = expenses.find(e => e.id === entry.sourceId) || {
                                                    id: entry.sourceId || entry.id,
                                                    title: entry.details,
                                                    amount: entry.grossAmount,
                                                    paidAmount: entry.grossAmount - Number(entry.outstandingCredit || 0),
                                                    outstandingAmount: Number(entry.outstandingCredit || 0),
                                                    vendor: entry.partyName,
                                                    paymentMethod: 'Credit',
                                                    paymentStatus: entry.status,
                                                    paymentHistory: entry.paymentHistory
                                                  };
                                                  setFinancialExpenseDetails(exp);
                                                },
                                                className: "w-full text-left px-2.5 py-1.5 rounded-lg text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors flex items-center gap-2 cursor-pointer"
                                              }, [
                                                h(Icon, { name: "history", className: "w-3.5 h-3.5" }),
                                                "Payment History"
                                              ]),
                                              h("button", {
                                                key: "details",
                                                type: "button",
                                                onClick: () => {
                                                  setFinancialLedgerActionMenu(null);
                                                  const exp = expenses.find(e => e.id === entry.sourceId) || {
                                                    id: entry.sourceId || entry.id,
                                                    title: entry.details,
                                                    amount: entry.grossAmount,
                                                    outstandingAmount: Number(entry.outstandingCredit || 0),
                                                    vendor: entry.partyName,
                                                    paymentMethod: entry.payment,
                                                    paymentStatus: entry.status
                                                  };
                                                  setFinancialExpenseDetails(exp);
                                                },
                                                className: "w-full text-left px-2.5 py-1.5 rounded-lg text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors flex items-center gap-2 cursor-pointer"
                                              }, [
                                                h(Icon, { name: "fileText", className: "w-3.5 h-3.5" }),
                                                "View Details"
                                              ])
                                            ],

                                            // Stocking actions
                                            entry.type === 'stocking' && [
                                              Number(entry.outstandingCredit || 0) > 0 && h("button", {
                                                key: "pay-stock",
                                                type: "button",
                                                onClick: () => {
                                                  setFinancialLedgerActionMenu(null);
                                                  const exp = expenses.find(e => e.id === entry.sourceId || e.linkedPurchaseId === entry.jobNo) || {
                                                    id: entry.sourceId || entry.id,
                                                    title: entry.details,
                                                    amount: entry.grossAmount,
                                                    outstandingAmount: entry.outstandingCredit,
                                                    vendor: entry.partyName,
                                                    paymentMethod: 'Credit',
                                                    paymentStatus: entry.status
                                                  };
                                                  openExpensePayment(exp);
                                                },
                                                className: "w-full text-left px-2.5 py-1.5 rounded-lg text-xs font-bold text-indigo-600 hover:bg-indigo-50 transition-colors flex items-center gap-2 cursor-pointer"
                                              }, [
                                                h(Icon, { name: "creditCard", className: "w-3.5 h-3.5" }),
                                                "Pay Credit"
                                              ]),
                                              h("button", {
                                                key: "details-stock",
                                                type: "button",
                                                onClick: () => {
                                                  setFinancialLedgerActionMenu(null);
                                                  const exp = expenses.find(e => e.id === entry.sourceId || e.linkedPurchaseId === entry.jobNo) || {
                                                    id: entry.sourceId || entry.id,
                                                    title: entry.details,
                                                    amount: entry.grossAmount,
                                                    outstandingAmount: Number(entry.outstandingCredit || 0),
                                                    vendor: entry.partyName,
                                                    paymentMethod: entry.payment,
                                                    paymentStatus: entry.status
                                                  };
                                                  setFinancialExpenseDetails(exp);
                                                },
                                                className: "w-full text-left px-2.5 py-1.5 rounded-lg text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors flex items-center gap-2 cursor-pointer"
                                              }, [
                                                h(Icon, { name: "fileText", className: "w-3.5 h-3.5" }),
                                                "View Details"
                                              ])
                                            ],

                                            // Credit Payment actions
                                            entry.type === 'credit-paid' && [
                                              entry.receipt && h("button", {
                                                key: "receipt",
                                                type: "button",
                                                onClick: () => {
                                                  setFinancialLedgerActionMenu(null);
                                                  openExpenseReceipt(entry.receipt, `Voucher: ${entry.jobNo}`);
                                                },
