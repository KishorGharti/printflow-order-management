              if (productMaterialsEnabled && unlinkedMaterial) { alert('Every material row must be linked to an existing Inventory item.'); return; }
              if (productMaterialsEnabled && invalidAuto) { alert('Every AUTO material needs an inventory item and a quantity greater than zero.'); return; }
              if (productMaterialsEnabled && invalidVariantMaterial) { alert('A stock link points to a sub-option that no longer exists. Choose another Applies To option.'); return; }

