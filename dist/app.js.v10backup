                      h("td", { className: "px-4 py-3.5 text-center font-mono font-black text-rose-600 text-xs" }, [
                        h("span", { className: "px-2 py-0.5 rounded bg-rose-50 border border-rose-100" }, `≤ ${threshold}`)
                      ]),

                      // 8. Notes
                      h("td", { className: "px-4 py-3.5 text-slate-500 max-w-[180px] truncate text-[11px]", title: item.notes || '' }, item.notes || '—'),

                      // 9. Action Buttons
                      h("td", { className: "px-4 py-3.5 text-center" }, [
                        h("div", { className: "flex items-center justify-center gap-1" }, [
                          h("button", {
                            type:"button",
                            onClick:()=>{setEditingStockItem(item);setStockParentId('');setIsAddStockOpen(true);},
                            className:"flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-500 hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700",
                            title:`Edit ${item.name}`
                          }, h(Icon,{name:"edit",className:"h-3.5 w-3.5"})),
                          h("button", {
                            type:"button",
                            onClick:()=>setSelectedStockProductId(item.id),
                            className:"whitespace-nowrap px-2 py-1 rounded-lg border border-slate-200 bg-white hover:border-indigo-300 hover:bg-indigo-50 text-indigo-700 font-bold text-[10px] transition-all cursor-pointer",
                            title:`Open entries for ${item.name}`
                          }, `Entries (${stock.filter(entry=>entry.parentId===item.id).length})`),
                          // Quick +10 restock
                          h("button", {
                            type: "button",
                            onClick: () => {
                              const cur = Number(item.quantity || 0);
                              storageService.saveStockItem({ ...item, quantity: cur + 10 });
                              setStockSavedId(item.id);
                              setTimeout(() => setStockSavedId(null), 2000);
                              refresh();
                            },
                            className: "px-2 py-1 rounded-lg border border-indigo-200 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold text-[10px] shadow-2xs transition-all cursor-pointer",
                            title: "Quick restock +10 units"
                          }, "+10"),

                          // Delete item
                          h("button", {
                            type: "button",
                            onClick: () => {
                              if (confirm(`Delete material "${item.name}" from stock inventory?`)) {
                                if (!storageService.deleteStockItem(item.id)) alert('This material is used by a Master Product recipe or stock allocation and cannot be deleted.');
                                else refresh();
                              }
                            },
                            className: "p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-all cursor-pointer",
                            title: "Delete material"
                          }, h(Icon, { name: "trash", className: "w-4 h-4" }))
                        ])
                      ])
