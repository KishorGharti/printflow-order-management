                      allTransactionsAlternateTint: f.allTransactionsAlternateTint ? Number(f.allTransactionsAlternateTint.value) : (settings.allTransactionsAlternateTint ?? 100)
                    };
                    storageService.saveSettings(updated);
                    setSettings(storageService.getSettings());
                    applyBrandTheme(updated);
                    refresh();
                    showFeedback("✓ Custom branding preferences saved!");
