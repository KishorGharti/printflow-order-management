              h("button", { type: "button", onClick: finishBackwardTransition, className: "rounded-xl bg-gradient-to-r from-amber-600 to-rose-600 px-5 py-2.5 text-xs font-black text-white shadow-md hover:from-amber-700 hover:to-rose-700 cursor-pointer flex items-center gap-1.5" }, [
                h(Icon, { name: "check", className: "w-4 h-4" }),
                "Confirm Move Backward"
              ])
            ])
          ])
        ])
      ]),

      // 6-DIGIT PIN CODE VERIFICATION MODAL FOR TEAM SECURITY
      teamPinModal && h("div", { key: "teampinmodal", className: "fixed inset-0 z-[110] flex items-center justify-center p-4 bg-slate-950/75 backdrop-blur-sm", onMouseDown: (e) => { if (e.target === e.currentTarget) setTeamPinModal(null); } }, [
        h("div", { className: "w-full max-w-sm overflow-hidden rounded-3xl border border-indigo-200 bg-white shadow-2xl" }, [
          h("div", { className: "bg-gradient-to-r from-slate-950 via-indigo-950 to-indigo-800 px-5 py-4 text-white" }, [
            h("div", { className: "flex items-start justify-between gap-3" }, [
              h("div", {}, [
                h("div", { className: "text-[10px] font-black uppercase tracking-[.18em] text-indigo-200 flex items-center gap-1.5" }, [
                  h(Icon, { name: "lock", className: "w-3.5 h-3.5 text-amber-300" }),
                  "Team Security Verification"
                ]),
                h("h3", { className: "mt-1 text-base font-black text-white" }, "Enter 6-Digit PIN"),
                h("p", { className: "mt-0.5 text-xs text-indigo-100" }, `${teamPinModal.actionTitle} • ${teamPinModal.member.name}`)
              ]),
              h("button", { type: "button", onClick: () => setTeamPinModal(null), className: "rounded-lg p-1 text-indigo-200 hover:bg-white/10 hover:text-white cursor-pointer" }, h(Icon, { name: "x", className: "w-4 h-4" }))
            ])
          ]),
          h("form", {
            onSubmit: (e) => {
              e.preventDefault();
              const entered = String(teamPinModal.enteredPin || '').trim();
              const targetPin = String(teamPinModal.member.pin || '123456').trim();
              if (entered !== targetPin) {
                setTeamPinModal(prev => ({ ...prev, error: `❌ Incorrect PIN for ${teamPinModal.member.name}. Please enter correct 6 digits.`, enteredPin: '' }));
                return;
              }
              const successCb = teamPinModal.onSuccess;
              setTeamPinModal(null);
              if (typeof successCb === 'function') successCb();
            },
            className: "p-5 space-y-4"
          }, [
            h("div", { className: "flex items-center gap-3 p-3 rounded-2xl border border-indigo-100 bg-indigo-50/50" }, [
              h("div", { className: "flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-indigo-600 font-black text-white" }, teamPinModal.member.name.slice(0, 2).toUpperCase()),
              h("div", { className: "min-w-0 flex-1" }, [
                h("div", { className: "text-sm font-black text-slate-900 truncate" }, teamPinModal.member.name),
                h("div", { className: "text-xs font-semibold text-slate-500 truncate" }, teamPinModal.member.jobTitle || 'Team Member')
              ])
            ]),
            h("div", {}, [
              h("label", { className: "text-[10px] font-black uppercase tracking-wider text-slate-500 block mb-1.5" }, "6-Digit Security PIN:"),
              h("input", {
                autoFocus: true,
                type: "password",
                inputMode: "numeric",
                maxLength: 6,
                pattern: "[0-9]{6}",
                required: true,
                value: teamPinModal.enteredPin,
                onChange: (e) => {
                  const val = e.target.value.replace(/\D/g, '').slice(0, 6);
                  setTeamPinModal(prev => ({ ...prev, enteredPin: val, error: '' }));
                },
                placeholder: "••••••",
                className: "w-full text-center text-2xl font-mono font-black tracking-[0.4em] py-3 rounded-xl border-2 border-slate-200 focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-100 bg-slate-50"
              }),
              teamPinModal.error && h("div", { className: "mt-2 p-2.5 rounded-xl bg-rose-50 border border-rose-200 text-xs font-bold text-rose-700 text-center" }, teamPinModal.error)
            ]),
            h("div", { className: "flex items-center justify-between gap-2 pt-2 border-t border-slate-100" }, [
              h("button", { type: "button", onClick: () => setTeamPinModal(null), className: "px-4 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-800 cursor-pointer" }, "Cancel"),
              h("button", { type: "submit", className: "px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-black text-xs shadow-md cursor-pointer transition-all" }, "Verify & Proceed")
            ])
          ])
        ])
      ]),

      // PRINT OPERATOR SELECTION MODAL — required when downloading design files
      downloadPendingPrint && h("div", { key: "printermodal", className: "fixed inset-0 z-[95] flex items-center justify-center p-4 bg-slate-950/65 backdrop-blur-sm", onMouseDown: (e) => { if (e.target === e.currentTarget) setDownloadPendingPrint(null); } }, [
        h("div", { className: "w-full max-w-md overflow-hidden rounded-3xl border border-indigo-200 bg-white shadow-2xl" }, [
          h("div", { className: "bg-gradient-to-r from-indigo-700 via-indigo-800 to-slate-900 px-5 py-4 text-white" }, [
            h("div", { className: "flex items-start justify-between gap-3" }, [
              h("div", {}, [
                h("div", { className: "text-[10px] font-black uppercase tracking-[.16em] text-indigo-200" }, "Print Operator Assignment"),
                h("h3", { className: "mt-1 text-lg font-black" }, "Who is printing this job?"),
                h("p", { className: "mt-0.5 text-xs font-semibold text-indigo-100" }, `${downloadPendingPrint.order?.orderNumber || 'Order'} • Select team member to download and assign printing`)
              ]),
              h("button", { type: "button", onClick: () => setDownloadPendingPrint(null), className: "rounded-lg p-1 text-indigo-100 hover:bg-white/10 hover:text-white cursor-pointer" }, h(Icon, { name: "x", className: "w-4 h-4" }))
            ])
          ]),
          h("div", { className: "p-5 space-y-3" }, [
            h("div", { className: "text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1" }, "Choose Operator (1-Click Download):"),
            h("div", { className: "space-y-2 max-h-[260px] overflow-y-auto" }, team.map(member => {
              const isPreviousPrinter = downloadPendingPrint.order?.printerId === member.id;
              return h("button", {
                key: member.id,
                type: "button",
                onClick: () => confirmDownloadWithPrinter(member),
                className: `flex w-full items-center gap-3 rounded-2xl border p-3 text-left transition-all hover:border-indigo-500 hover:bg-indigo-50 cursor-pointer ${isPreviousPrinter ? 'border-indigo-400 bg-indigo-50/50 shadow-xs' : 'border-slate-200 bg-white'}`
              }, [
                h("div", { className: `flex h-10 w-10 shrink-0 items-center justify-center rounded-xl font-black ${isPreviousPrinter ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-700'}` }, member.name.slice(0, 2).toUpperCase()),
                h("div", { className: "min-w-0 flex-1" }, [
                  h("div", { className: "font-black text-sm text-slate-900 truncate" }, member.name),
                  h("div", { className: "text-xs font-semibold text-slate-400 truncate" }, member.jobTitle || 'Print Operator')
                ]),
                h("span", { className: "rounded-xl bg-indigo-600 px-3 py-1.5 text-xs font-bold text-white shadow-2xs shrink-0 flex items-center gap-1" }, [
                  h(Icon, { name: "download", className: "w-3.5 h-3.5" }),
                  "Print"
                ])
              ]);
            })),
            h("div", { className: "flex items-center justify-end border-t border-slate-100 pt-3" }, [
              h("button", { type: "button", onClick: () => setDownloadPendingPrint(null), className: "px-5 py-2.5 rounded-xl border border-slate-200 bg-white text-xs font-bold text-slate-600 hover:bg-slate-50 cursor-pointer" }, "Cancel")
            ])
          ])
        ])
      ]),

      priceOverrideOpen && selectedCustomer && (()=>{
        const pricingMap = storageService.getCustomerPricingMap(selectedCustomer.id);
        const customProductIds = new Set(pricingMap.keys());
        const activeItemIds = new Set([...customProductIds, ...(editingPriceProductId ? [editingPriceProductId] : [])]);
        const customProducts = masterProducts.filter(p => activeItemIds.has(p.id));
        const categories = ['ALL', ...new Set(masterProducts.map(p => p.category || 'General').filter(Boolean))];
        
        const closePricing = () => {
          setPriceOverrideOpen(false);
          setIsAddProductModalOpen(false);
          setEditingPriceProductId('');
          setPriceOverrideErrors({});
          setPriceOverrideFeedback('');
        };

        const handleOpenAddProduct = () => {
          setAddProductSearch('');
          setAddProductCategory('ALL');
          setIsAddProductModalOpen(true);
        };

        const handleSelectProductToAdd = (product) => {
          if (pricingMap.has(product.id)) {
            setIsAddProductModalOpen(false);
            setEditingPriceProductId(product.id);
            setPriceOverrideDrafts(drafts => ({
              ...drafts,
              [product.id]: drafts[product.id] !== undefined ? drafts[product.id] : String(pricingMap.get(product.id))
            }));
            return;
          }
          setIsAddProductModalOpen(false);
          setEditingPriceProductId(product.id);
          setPriceOverrideDrafts(drafts => ({
            ...drafts,
            [product.id]: drafts[product.id] !== undefined ? drafts[product.id] : String(product.defaultPrice || '')
          }));
          setPriceOverrideFeedback(`Added "${product.name}". Set custom price and click Save.`);
        };

        const savePrice = (product) => {
          const raw = Object.prototype.hasOwnProperty.call(priceOverrideDrafts, product.id)
            ? String(priceOverrideDrafts[product.id]).trim()
            : (pricingMap.has(product.id) ? String(pricingMap.get(product.id)) : '');
          const value = Number(raw);
          if (raw === '' || !Number.isFinite(value) || value < 0) {
            setPriceOverrideErrors(errors => ({ ...errors, [product.id]: 'Enter a valid price of zero or more.' }));
            return;
          }
          storageService.setCustomerPrice(selectedCustomer.id, product.id, value);
          setPriceOverrideErrors(errors => { const next = { ...errors }; delete next[product.id]; return next; });
          setEditingPriceProductId('');
          setPriceOverrideFeedback(`✓ ${product.name}: ${storageService.formatCurrency(value)} saved for ${selectedCustomer.businessName || selectedCustomer.name}`);
          refresh();
        };

        const resetPrice = (product) => {
          storageService.removeCustomerPrice(selectedCustomer.id, product.id);
          setPriceOverrideDrafts(drafts => { const next = { ...drafts }; delete next[product.id]; return next; });
          setPriceOverrideErrors(errors => { const next = { ...errors }; delete next[product.id]; return next; });
          if (editingPriceProductId === product.id) {
            setEditingPriceProductId('');
          }
          setPriceOverrideFeedback(`✓ ${product.name} reset to the master price.`);
          refresh();
        };

        const cancelEdit = (product) => {
          if (!pricingMap.has(product.id)) {
            setPriceOverrideDrafts(drafts => { const next = { ...drafts }; delete next[product.id]; return next; });
            setPriceOverrideErrors(errors => { const next = { ...errors }; delete next[product.id]; return next; });
          }
          setEditingPriceProductId('');
          setPriceOverrideFeedback('');
        };

        const addProductQuery = addProductSearch.trim().toLowerCase();
        const availableMasterProducts = masterProducts.filter(product => {
          if (addProductCategory !== 'ALL' && (product.category || 'General') !== addProductCategory) return false;
          if (!addProductQuery) return true;
          return [product.name, product.category, product.productionType, product.unit].some(v => String(v || '').toLowerCase().includes(addProductQuery));
        });

        return h('div', {
          key: 'custom-pricing-modal',
          className: 'fixed inset-0 z-[130] flex items-center justify-center bg-slate-950/65 p-2 backdrop-blur-sm sm:p-4',
          onMouseDown: event => { if (event.target === event.currentTarget) closePricing(); }
        }, [
          h('div', { className: 'flex max-h-[85vh] w-full max-w-3xl flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl relative' }, [
            h('div', { className: 'flex shrink-0 items-start justify-between gap-3 border-b border-slate-200 bg-slate-50 px-4 py-4 sm:px-5' }, [
              h('div', {}, [
                h('div', { className: 'text-[9px] font-bold uppercase tracking-[.16em] text-indigo-600' }, 'Client-Specific Rates'),
                h('h3', { className: 'mt-1 text-lg font-black text-slate-900' }, 'Custom Price Override'),
                h('p', { className: 'mt-0.5 text-xs font-semibold text-slate-600' }, `Client: ${selectedCustomer.businessName || selectedCustomer.name}`)
              ]),
              h('div', { className: 'flex items-center gap-2' }, [
                h('button', {
                  type: 'button',
                  onClick: handleOpenAddProduct,
                  className: 'inline-flex items-center gap-1.5 rounded-xl bg-indigo-600 px-3.5 py-2 text-xs font-bold text-white shadow-sm hover:bg-indigo-700 cursor-pointer'
                }, [
                  h(Icon, { name: 'plus', className: 'h-3.5 w-3.5' }),
                  'Add Product'
                ]),
                h('button', {
                  type: 'button',
                  onClick: closePricing,
                  className: 'rounded-lg p-1.5 text-slate-400 hover:bg-slate-200 hover:text-slate-700 cursor-pointer',
                  'aria-label': 'Close custom pricing'
                }, h(Icon, { name: 'x', className: 'h-4 w-4' }))
              ])
            ]),

            priceOverrideFeedback && h('div', { className: 'shrink-0 border-b border-emerald-200 bg-emerald-50 px-4 py-2 text-xs font-semibold text-emerald-800 flex items-center justify-between', role: 'status' }, [
              h('span', {}, priceOverrideFeedback),
              h('button', { type: 'button', onClick: () => setPriceOverrideFeedback(''), className: 'text-emerald-700 hover:text-emerald-900 text-xs font-bold cursor-pointer' }, '✕')
            ]),

            h('div', { className: 'min-h-0 flex-1 overflow-y-auto' }, [
              customProducts.length === 0 ? h('div', { className: 'flex flex-col items-center justify-center py-16 px-4 text-center' }, [
                h('div', { className: 'flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600 mb-3 border border-indigo-100' }, h(Icon, { name: 'tag', className: 'h-6 w-6' })),
                h('p', { className: 'text-sm font-bold text-slate-700' }, 'No custom prices set for this client.'),
                h('p', { className: 'mt-1 text-xs text-slate-400 max-w-sm' }, 'This client currently pays standard Master Product catalog rates.'),
                h('button', {
                  type: 'button',
                  onClick: handleOpenAddProduct,
                  className: 'mt-4 inline-flex items-center gap-1.5 rounded-xl bg-indigo-600 px-4 py-2.5 text-xs font-bold text-white shadow-sm hover:bg-indigo-700 cursor-pointer'
                }, [
                  h(Icon, { name: 'plus', className: 'h-4 w-4' }),
                  'Add Product'
                ])
              ]) : h('div', {}, [
                h('div', { className: 'sticky top-0 z-10 grid grid-cols-[minmax(180px,1fr)_120px_160px_130px] gap-3 border-b border-slate-200 bg-slate-50 px-5 py-2.5 text-[9px] font-bold uppercase tracking-wide text-slate-500' }, [
                  h('span', {}, 'Product'),
                  h('span', {}, 'Default'),
                  h('span', {}, 'Custom'),
                  h('span', { className: 'text-right' }, 'Action')
                ]),
                customProducts.map(product => {
                  const hasCustom = pricingMap.has(product.id);
                  const currentCustomPrice = pricingMap.get(product.id);
                  const isEditing = editingPriceProductId === product.id || (!hasCustom && Object.prototype.hasOwnProperty.call(priceOverrideDrafts, product.id));
                  const draft = Object.prototype.hasOwnProperty.call(priceOverrideDrafts, product.id)
                    ? priceOverrideDrafts[product.id]
                    : (hasCustom ? String(currentCustomPrice) : String(product.defaultPrice || ''));

                  return h('div', {
                    key: product.id,
                    className: `grid grid-cols-[minmax(180px,1fr)_120px_160px_130px] items-center gap-3 border-b border-slate-100 px-5 py-3.5 last:border-0 transition-colors ${isEditing ? 'bg-indigo-50/40' : 'hover:bg-slate-50/70'}`
                  }, [
                    h('div', { className: 'min-w-0 pr-2' }, [
                      h('div', { className: 'truncate text-xs font-bold text-slate-900', title: product.name }, product.name),
                      h('div', { className: 'mt-0.5 text-[10px] text-slate-400' }, [product.category || 'General', product.unit ? `Unit: ${product.unit}` : ''].filter(Boolean).join(' • '))
                    ]),
                    h('div', { className: 'font-mono text-xs font-semibold text-slate-500' }, `${storageService.formatCurrency(product.defaultPrice || 0)}${product.unit ? ` / ${product.unit}` : ''}`),
                    h('div', {}, [
                      isEditing ? h('div', { className: 'relative' }, [
                        h('span', { className: 'absolute left-2.5 top-1/2 -translate-y-1/2 text-[11px] font-bold text-slate-400' }, settings.currencySymbol || 'Rs.'),
                        h('input', {
                          autoFocus: true,
                          type: 'number',
                          min: '0',
                          step: '0.01',
                          value: draft,
                          onChange: event => {
                            const val = event.target.value;
                            setPriceOverrideDrafts(values => ({ ...values, [product.id]: val }));
                            setPriceOverrideErrors(errors => { const next = { ...errors }; delete next[product.id]; return next; });
                          },
                          onKeyDown: event => {
                            if (event.key === 'Enter') { event.preventDefault(); savePrice(product); }
                            if (event.key === 'Escape') { event.preventDefault(); cancelEdit(product); }
                          },
                          placeholder: '0.00',
                          className: `w-full rounded-lg border bg-white py-1.5 pl-8 pr-2 font-mono text-xs font-bold outline-none focus:ring-2 ${priceOverrideErrors[product.id] ? 'border-rose-300 focus:ring-rose-100' : 'border-indigo-300 focus:ring-indigo-100'}`
                        }),
                        priceOverrideErrors[product.id] && h('span', { className: 'mt-1 block text-[9px] font-semibold text-rose-600' }, priceOverrideErrors[product.id])
                      ]) : h('span', { className: 'inline-block font-mono text-xs font-black text-indigo-700 bg-indigo-50 border border-indigo-200 px-2 py-0.5 rounded-md' }, `${storageService.formatCurrency(currentCustomPrice || 0)}${product.unit ? ` / ${product.unit}` : ''}`)
                    ]),
                    h('div', { className: 'flex items-center justify-end gap-1.5' }, [
                      isEditing ? h(React.Fragment, {}, [
                        h('button', {
                          type: 'button',
                          onClick: () => savePrice(product),
                          className: 'rounded-md bg-emerald-600 px-2.5 py-1 text-[10px] font-bold text-white shadow-2xs hover:bg-emerald-700 cursor-pointer'
                        }, 'Save'),
                        h('button', {
                          type: 'button',
                          onClick: () => cancelEdit(product),
                          className: 'rounded-md border border-slate-200 bg-white px-2 py-1 text-[10px] font-bold text-slate-500 hover:bg-slate-100 cursor-pointer'
                        }, 'Cancel'),
                        hasCustom && h('button', {
                          type: 'button',
                          onClick: () => resetPrice(product),
                          className: 'rounded-md px-1.5 py-1 text-[10px] font-bold text-rose-600 hover:bg-rose-50 cursor-pointer',
                          title: 'Reset to Master Price'
                        }, 'Reset')
                      ]) : h(React.Fragment, {}, [
                        h('button', {
                          type: 'button',
                          onClick: () => {
                            setEditingPriceProductId(product.id);
                            setPriceOverrideDrafts(values => ({ ...values, [product.id]: String(currentCustomPrice) }));
                            setPriceOverrideErrors(errors => { const next = { ...errors }; delete next[product.id]; return next; });
                          },
                          className: 'rounded-md border border-indigo-200 bg-white px-2.5 py-1 text-[10px] font-bold text-indigo-700 hover:bg-indigo-50 cursor-pointer'
                        }, 'Edit'),
                        h('button', {
                          type: 'button',
                          onClick: () => resetPrice(product),
                          className: 'rounded-md border border-slate-200 bg-white px-2 py-1 text-[10px] font-bold text-slate-500 hover:border-rose-200 hover:bg-rose-50 hover:text-rose-700 cursor-pointer',
                          title: 'Reset to Master Price'
                        }, 'Reset')
                      ])
                    ])
                  ]);
                })
              ])
            ]),

            h('div', { className: 'flex shrink-0 items-center justify-between border-t border-slate-200 bg-white px-4 py-3 sm:px-5' }, [
              h('span', { className: 'text-[10px] font-semibold text-slate-500' }, `${pricingMap.size} custom price${pricingMap.size === 1 ? '' : 's'} configured for ${selectedCustomer.businessName || selectedCustomer.name}`),
              h('button', { type: 'button', onClick: closePricing, className: 'rounded-xl bg-slate-900 px-4 py-2 text-xs font-bold text-white hover:bg-slate-800 cursor-pointer' }, 'Close')
            ]),

            isAddProductModalOpen && h('div', {
              key: 'add-product-selector-modal',
              className: 'absolute inset-0 z-20 flex items-center justify-center bg-slate-950/60 p-3 backdrop-blur-xs',
              onMouseDown: e => { if (e.target === e.currentTarget) setIsAddProductModalOpen(false); }
            }, [
              h('div', { className: 'flex h-[calc(100%_-_1.5rem)] max-h-[560px] min-h-0 w-full max-w-lg flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl animate-fade-in' }, [
                h('div', { className: 'flex shrink-0 items-start justify-between border-b border-slate-200 bg-slate-50 px-4 py-3.5' }, [
                  h('div', {}, [
                    h('h4', { className: 'text-sm font-black text-slate-900' }, 'Add Product to Custom Pricing'),
                    h('p', { className: 'text-[10px] font-semibold text-slate-500' }, 'Select a product from the master catalog')
                  ]),
                  h('button', {
                    type: 'button',
                    onClick: () => setIsAddProductModalOpen(false),
                    className: 'rounded-lg p-1 text-slate-400 hover:bg-slate-200 hover:text-slate-700 cursor-pointer'
                  }, h(Icon, { name: 'x', className: 'h-4 w-4' }))
                ]),

                h('div', { className: 'shrink-0 space-y-2 border-b border-slate-100 p-3 bg-white' }, [
                  h('div', { className: 'relative' }, [
                    h(Icon, { name: 'search', className: 'absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-slate-400' }),
                    h('input', {
                      autoFocus: true,
                      type: 'search',
                      value: addProductSearch,
                      onChange: e => setAddProductSearch(e.target.value),
                      placeholder: 'Search products...',
                      className: 'w-full rounded-xl border border-slate-200 py-2 pl-9 pr-3 text-xs outline-none focus:ring-2 focus:ring-indigo-500'
                    })
                  ]),
                  categories.length > 2 && h('div', { className: 'flex flex-wrap gap-1 pt-1' }, categories.map(cat => h('button', {
                    key: cat,
                    type: 'button',
                    onClick: () => setAddProductCategory(cat),
                    className: `rounded-md px-2 py-1 text-[9px] font-bold cursor-pointer transition-colors ${addProductCategory === cat ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}`
                  }, cat === 'ALL' ? 'All' : cat)))
                ]),

                h('div', { className: 'min-h-0 flex-1 overflow-y-auto overscroll-contain divide-y divide-slate-100 p-1.5' }, [
                  availableMasterProducts.length === 0 ? h('div', { className: 'p-8 text-center text-xs text-slate-400 font-semibold' }, 'No products found.') : availableMasterProducts.map(product => {
                    const isAlreadyCustom = pricingMap.has(product.id);
                    return h('button', {
                      key: product.id,
                      type: 'button',
                      disabled: isAlreadyCustom,
                      onClick: () => handleSelectProductToAdd(product),
                      className: `flex w-full items-center justify-between p-3 text-left rounded-xl transition-all ${isAlreadyCustom ? 'opacity-40 cursor-not-allowed bg-slate-50' : 'hover:bg-indigo-50/60 cursor-pointer'}`
                    }, [
