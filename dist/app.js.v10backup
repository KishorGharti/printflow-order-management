  function PrintApp() {
    const [activeTab, setActiveTab] = useState('dashboard');
    const [appAlert, setAppAlert] = useState(null);
    const [selectedCustomer, setSelectedCustomer] = useState(null);
    const [selectedTeam, setSelectedTeam] = useState(null);
    const [selectedOrder, setSelectedOrder] = useState(null);
    const [jobDateFilter, setJobDateFilter] = useState('ALL');
    const [clientLedgerMonth, setClientLedgerMonth] = useState('');
    const [clientLedgerType, setClientLedgerType] = useState('ALL');
    const [clientLedgerFrom, setClientLedgerFrom] = useState('');
    const [clientLedgerTo, setClientLedgerTo] = useState('');
    const [clientBillingOrderIds, setClientBillingOrderIds] = useState([]);
    const [clientLedgerOpen, setClientLedgerOpen] = useState(true);
    const [clientLedgerViewMode, setClientLedgerViewMode] = useState('STATEMENT');
    const [clientLedgerSortOrder, setClientLedgerSortOrder] = useState('ASC');
    const [expandedLedgerItems, setExpandedLedgerItems] = useState({});
    const [clientProfileTab, setClientProfileTab] = useState('JOBS');
    const [clientJobsStatus, setClientJobsStatus] = useState('ALL');
    const [clientJobsPayment, setClientJobsPayment] = useState('ALL');
    const [clientJobsMonth, setClientJobsMonth] = useState('');
    const [clientJobsSearch, setClientJobsSearch] = useState('');
    const [clientListSearch, setClientListSearch] = useState('');
    const [clientLedgerPage, setClientLedgerPage] = useState(1);
    const [clientLedgerPageSize, setClientLedgerPageSize] = useState(50);
    const [clientJobsPage, setClientJobsPage] = useState(1);
    const [clientJobsPageSize, setClientJobsPageSize] = useState(50);
    const [clientListPage, setClientListPage] = useState(1);
    const [clientListPageSize, setClientListPageSize] = useState(50);
    const [ordersTablePage, setOrdersTablePage] = useState(1);
    const [ordersTablePageSize, setOrdersTablePageSize] = useState(50);
    const [productsPage, setProductsPage] = useState(1);
    const [productsPageSize, setProductsPageSize] = useState(50);
    const [stockTablePage, setStockTablePage] = useState(1);
    const [stockTablePageSize, setStockTablePageSize] = useState(50);
    const [clientStatementModal, setClientStatementModal] = useState(null);
    const [pdfPreviewModal, setPdfPreviewModal] = useState(null);
    const [clientStatementPreview, setClientStatementPreview] = useState(null);
    const [clientPaymentDetails, setClientPaymentDetails] = useState(null);
    const [clientReceiptPreview, setClientReceiptPreview] = useState(null);
    const [teamRoleFilter, setTeamRoleFilter] = useState('ALL');

    const openPdfPreview = (result, extra = {}) => {
      if (!result) return;
      const blob = result.blob || result;
      if (!blob) return;
      setPdfPreviewModal(current => {
        if (current?.url) URL.revokeObjectURL(current.url);
        const url = URL.createObjectURL(blob);
        return {
          ...result,
          ...extra,
          blob,
          filename: result.filename || extra.filename || 'document.pdf',
          title: result.title || extra.title || 'Document Preview',
          url,
          shareFallback: Boolean(extra.shareFallback || result.shareFallback)
        };
      });
    };

    const closePdfPreview = () => {
      setPdfPreviewModal(current => {
        if (current?.url) URL.revokeObjectURL(current.url);
        return null;
      });
    };

    const downloadPdfFromModal = () => {
      if (!pdfPreviewModal?.blob) return;
      const link = document.createElement('a');
      link.href = pdfPreviewModal.url;
      link.download = pdfPreviewModal.filename || 'document.pdf';
      document.body.appendChild(link);
      link.click();
      link.remove();
    };

    useEffect(() => {
      storageService.openPdfPreview = openPdfPreview;
      window.__openPdfPreview = openPdfPreview;
      return () => {
        if (pdfPreviewModal?.url) URL.revokeObjectURL(pdfPreviewModal.url);
      };
    }, [pdfPreviewModal?.url]);
    useEffect(() => {
      setClientBillingOrderIds([]);
      setClientLedgerOpen(true);
      setClientLedgerViewMode('STATEMENT');
      setClientLedgerSortOrder('ASC');
      setExpandedLedgerItems({});
      setClientProfileTab('JOBS');
      setClientJobsStatus('ALL');
      setClientJobsPayment('ALL');
      setClientJobsMonth('');
      setClientJobsSearch('');
      setClientLedgerFrom('');
      setClientLedgerTo('');
      setPriceOverrideProductToAdd('');
      setEditingPriceProductId('');
    }, [selectedCustomer?.id]);
    const [businessLedgerFilter, setBusinessLedgerFilter] = useState('DATE');
    const [orderStatusFilter, setOrderStatusFilter] = useState('ALL');
    const [orderDateFilter, setOrderDateFilter] = useState('TODAY');
    const [orderHistoryDateSearch, setOrderHistoryDateSearch] = useState('');
    const [orderHistoryMonthSearch, setOrderHistoryMonthSearch] = useState('');
    const [expandedOrderHistoryMonth, setExpandedOrderHistoryMonth] = useState('');
    const [clientView, setClientView] = useState('PROFILES');
    const [isReminderPanelOpen, setIsReminderPanelOpen] = useState(false);
    const [stockDrafts, setStockDrafts] = useState({});
    const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);
    const [showBackToTop, setShowBackToTop] = useState(false);
    const [isShortcutsOpen, setIsShortcutsOpen] = useState(false);
    const [copyToast, setCopyToast] = useState('');
    const searchInputRef = React.useRef(null);
    
    // Modals
    const [isNewOrderModalOpen, setIsNewOrderModalOpen] = useState(false);
    const [newOrderCustomerId, setNewOrderCustomerId] = useState('');
    const [newOrderProductId, setNewOrderProductId] = useState('');
    const [newOrderVariantQuantities, setNewOrderVariantQuantities] = useState({});
    const [newOrderItems, setNewOrderItems] = useState([]);
    const [newOrderErrors, setNewOrderErrors] = useState({});
    const [newOrderMedia, setNewOrderMedia] = useState([]);
    const [mediaError, setMediaError] = useState('');
