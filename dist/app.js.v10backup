                            onChange: (e) => setStockDrafts(drafts => ({ ...drafts, [item.id]: e.target.value })),
                            className: `w-16 text-center py-1 rounded-lg border font-mono font-black text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all ${
                              isLow ? 'bg-rose-50 border-rose-200 text-rose-700' : 'bg-white border-slate-200 text-slate-900'
                            }`
                          }),

                          // Increment button
                          h("button", {
                            type: "button",
                            onClick: () => {
                              const cur = parseInt(stockDrafts[item.id] ?? item.quantity, 10) || 0;
                              const next = cur + 1;
                              setStockDrafts(drafts => ({ ...drafts, [item.id]: next }));
                            },
                            className: "w-7 h-7 rounded-lg bg-white hover:bg-slate-200 text-slate-700 font-black text-sm flex items-center justify-center border border-slate-200 shadow-2xs cursor-pointer transition-all",
                            title: "Increase by 1"
                          }, "+"),

                          // Save Button
                          h("button", {
                            type: "button",
                            disabled: !isDraftDirty && !isSavedFeedback,
                            onClick: () => {
                              const next = Math.max(0, parseInt(stockDrafts[item.id], 10) || 0);
                              storageService.saveStockItem({ ...item, quantity: next });
                              setStockSavedId(item.id);
                              setTimeout(() => setStockSavedId(null), 2000);
                              setStockDrafts(drafts => {
                                const copy = { ...drafts };
                                delete copy[item.id];
                                return copy;
                              });
                              refresh();
                            },
                            className: `px-2.5 py-1 rounded-lg text-xs font-black transition-all cursor-pointer ${
                              isSavedFeedback
                                ? 'bg-emerald-600 text-white shadow-xs'
                                : isDraftDirty
                                ? 'bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs'
                                : 'bg-slate-200 text-slate-400 cursor-not-allowed opacity-40'
                            }`,
                            title: isDraftDirty ? "Save updated quantity" : "Saved"
                          }, isSavedFeedback ? "✓" : "Save")
                        ])
                      ]),

                      // 6. Unit
                      h("td", { className: "px-4 py-3.5 text-center" }, [
                        h("select", {
                          value: item.unit,
                          onChange: (e) => {
                            const next = e.target.value;
                            if (confirm(`Change unit for "${item.name}" from ${item.unit} to ${next}?`)) {
                              storageService.saveStockItem({ ...item, unit: next });
                              refresh();
                            } else {
                              e.target.value = item.unit;
                            }
                          },
                          className: "px-2 py-1 rounded-lg border border-slate-200 bg-white text-xs font-bold text-slate-700 shadow-2xs focus:ring-2 focus:ring-indigo-500 focus:outline-none cursor-pointer"
