      ]);
    };

    // Stock Inventory Tab (Professional Redesign)
    const renderStock = () => {
      const stockProducts = stock.filter(item => !item.parentId);
      const totalSkus = stockProducts.length;
      const trackableStock = stock.filter(item => item.parentId || !stock.some(entry => entry.parentId === item.id));
      const lowStockItems = trackableStock.filter(x => storageService.getStockAvailability(x.id).available <= getLowStockThreshold(x));
      const lowStock = lowStockItems.length;
      const healthyStock = trackableStock.length - lowStock;
      const entryCount = stock.filter(item => item.parentId).length;
      const availableUnits = Array.from(new Set(stock.map(x => x.unit).filter(Boolean))).sort();

      const filteredStock = stockProducts.filter(item => {
        const q = (stockSearchQuery || '').trim().toLowerCase();
        const entries = stock.filter(entry => entry.parentId === item.id);
        if (q && ![item, ...entries].some(record => [record.name, record.notes, record.unit].some(v => String(v || '').toLowerCase().includes(q)))) return false;
        const trackedItems = entries.length ? entries : [item];
        const isLow = trackedItems.some(record => storageService.getStockAvailability(record.id).available <= getLowStockThreshold(record));
        if (stockStatusFilter === 'HEALTHY' && isLow) return false;
        if (stockStatusFilter === 'LOW' && !isLow) return false;
        if (stockUnitFilter !== 'ALL' && !trackedItems.some(record => record.unit === stockUnitFilter)) return false;
        return true;
      }).sort((a,b) => a.name.localeCompare(b.name));

      const stockPaging = paginateCollection(filteredStock, stockTablePage, stockTablePageSize);
      const selectedStockProduct = stockProducts.find(item => item.id === selectedStockProductId);
