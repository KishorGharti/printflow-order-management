          h('div',{className:'min-h-[700px] p-3 sm:p-5'},livePdfUrl?h('iframe',{key:livePdfUrl,src:`${livePdfUrl}#toolbar=0&navpanes=0&scrollbar=1&view=FitH`,title:`${isChalan?'Chalan':'Bill'} PDF live preview`,className:'h-[760px] w-full rounded-2xl border border-slate-300 bg-slate-200 shadow-inner'}):h('div',{className:'grid h-[500px] place-items-center text-xs font-bold text-slate-400'},busy?'Building preview…':'Preview unavailable'))
