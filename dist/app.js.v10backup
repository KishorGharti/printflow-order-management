              h('select',{value:previewMode,onChange:e=>setPreviewMode(e.target.value),className:'rounded-xl border border-slate-200 bg-white px-3 py-2 text-[10px] font-black'},[h('option',{value:'sample'},'Sample'),h('option',{value:'real'},'Real order')]),
              previewMode==='sample'?h('select',{value:sampleCount,onChange:e=>setSampleCount(Number(e.target.value)),className:'rounded-xl border border-slate-200 bg-white px-3 py-2 text-[10px] font-black'},[1,5,10,14,15,20,28,40].map(n=>h('option',{key:n,value:n},`${n} item${n===1?'':'s'}`))):h('select',{value:previewOrderId,onChange:e=>setPreviewOrderId(e.target.value),className:'max-w-[260px] rounded-xl border border-slate-200 bg-white px-3 py-2 text-[10px] font-bold'},(orders||[]).map(o=>h('option',{key:o.id,value:o.id},`${o.orderNumber} — ${storageService.getCustomerById(o.customerId)?.businessName||o.orderContactName||'Customer'}`)))
