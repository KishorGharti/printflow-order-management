              h("input", { name: "stockQty", type: "number", step: "1", min: "0", required: true, defaultValue:editingStockItem?.quantity ?? (stockParentId ? 0 : 10), className: "w-full p-2.5 rounded-xl border border-slate-200 bg-slate-50/50 text-xs font-black font-mono text-slate-900 focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all" })
            ]),
            h("div", {}, [
              h("label", { className: "block text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1" }, "Unit *"),
              h("select", { name: "stockUnit", defaultValue:editingStockItem?.unit || stock.find(item=>item.id===stockParentId)?.unit || "Roll", className: "w-full p-2.5 rounded-xl border border-slate-200 bg-white text-xs font-bold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:outline-none cursor-pointer" },
                STOCK_UNITS.map(u => h("option", { key: u, value: u }, u))
              )
            ]),
