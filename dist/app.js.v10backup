h("div", { className: "flex items-center gap-2 sm:gap-3" }, [
  h("div", { className:"relative" }, [
    h("button", { type:"button", onClick:()=>setIsReminderPanelOpen(open=>!open), className:`relative w-10 h-10 inline-flex items-center justify-center rounded-xl border transition-all cursor-pointer ${notificationCount ? 'border-amber-300 bg-amber-50 text-amber-700 hover:bg-amber-100' : 'border-slate-200 bg-white text-slate-400 hover:border-indigo-300 hover:text-indigo-600'}`, "aria-label":notificationCount ? `${notificationCount} notifications active` : "Daily reports and notifications", title:"Daily reports & reminders" }, [
      h(Icon,{name:"bell",className:"w-5 h-5"}),
      notificationCount > 0 && h("span", { className:"absolute -right-1.5 -top-1.5 min-w-5 h-5 px-1 inline-flex items-center justify-center rounded-full bg-rose-600 text-[9px] font-black text-white ring-2 ring-white" }, notificationCount)
    ]),
    isReminderPanelOpen && (() => {
      // Determine active closing notification window:
      // Active from 6:00 PM (18:00 NPT) until 9:00 AM (09:00 NPT) the next morning.
      // At 9:00 AM, the notification for the previous day is automatically deleted / cleared.
      const nepalParts = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Kathmandu', hour: 'numeric', hour12: false }).formatToParts(new Date());
      const nepalHour = parseInt(nepalParts.find(p => p.type === 'hour')?.value || '0', 10);
      
      const isEveningWindow = nepalHour >= 18; // 6:00 PM - 11:59 PM
      const isMorningWindow = nepalHour < 9;   // 12:00 AM - 8:59 AM
      const isClosingNotificationActive = isEveningWindow || isMorningWindow;

      // Target report date: yesterday if morning before 9 AM, else today
      const activeReportDate = isMorningWindow ? (() => {
        const y = new Date();
        y.setDate(y.getDate() - 1);
        return getKathmanduDateKey(y);
      })() : todayStr;

      const activeReportData = storageService.getDailyOperationsData(activeReportDate);
      const activeReportTitle = isMorningWindow
        ? `Yesterday's EOD Report (Clears at 9:00 AM)`
        : isEveningWindow
        ? `Today's 6:00 PM Closing Statement`
        : `Daytime Work in Progress (Next at 6:00 PM)`;

      return h("div", { className:"absolute right-0 top-12 z-50 w-[min(540px,calc(100vw-24px))] sm:w-[530px] overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl" }, [
