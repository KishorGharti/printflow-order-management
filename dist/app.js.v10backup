                orderPrintDropdownOpen && h("div", {
                  className: "absolute right-0 top-full mt-1.5 z-40 w-48 rounded-xl border border-slate-200 bg-white p-1.5 shadow-xl animate-fade-in divide-y divide-slate-100",
                  onClick: (e) => e.stopPropagation()
                }, [
                  h("div", { className: "space-y-1 pb-1" }, [
                    h("button", {
                      type: "button",
                      title: "Print Bill",
                      onClick: () => { setOrderPrintDropdownOpen(false); openInvoiceModal(selectedOrder, 'print'); },
                      className: "w-full text-left flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-bold text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 cursor-pointer transition-colors"
                    }, [
                      h(Icon, { name: "receipt", className: "w-3.5 h-3.5 text-indigo-600" }),
                      h("span", {}, "Print as Bill")
                    ]),
                    h("button", {
                      type: "button",
                      onClick: () => { setOrderPrintDropdownOpen(false); openInvoiceModal(selectedOrder, 'print', 'chalan'); },
                      className: "w-full text-left flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-bold text-slate-700 hover:bg-blue-50 hover:text-blue-700 cursor-pointer transition-colors"
                    }, [
                      h(Icon, { name: "truck", className: "w-3.5 h-3.5 text-blue-600" }),
                      h("span", {}, "Print as Chalan")
                    ])
                  ])
                ])
              ]),

              // More Dropdown
              h("div", { className: "relative" }, [
                h("button", {
                  type: "button",
                  onClick: (e) => { e.stopPropagation(); setOrderPrintDropdownOpen(false); setOrderMoreDropdownOpen(v => !v); },
                  className: `inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border text-xs font-bold transition-colors cursor-pointer shadow-2xs ${orderMoreDropdownOpen ? 'border-indigo-500 bg-indigo-50 text-indigo-700' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50'}`
                }, [
                  "More",
                  h(Icon, { name: "chevronDown", className: `w-3 h-3 transition-transform ${orderMoreDropdownOpen ? 'rotate-180' : ''}` })
                ]),

                orderMoreDropdownOpen && h("div", {
                  className: "absolute right-0 top-full mt-1.5 z-40 w-52 rounded-xl border border-slate-200 bg-white p-1.5 shadow-xl animate-fade-in divide-y divide-slate-100",
                  onClick: (e) => e.stopPropagation()
                }, [
                  h("div", { className: "space-y-0.5 pb-1" }, [
                    h("button", {
                      type: "button",
                      onClick: () => { setOrderMoreDropdownOpen(false); setEditingOrderDraft(JSON.parse(JSON.stringify(selectedOrder))); setIsEditingOrder(true); },
                      className: "w-full text-left flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-bold text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 cursor-pointer transition-colors"
                    }, [
                      h(Icon, { name: "edit", className: "w-3.5 h-3.5 text-slate-400" }),
                      h("span", {}, "Edit Order")
                    ]),
                    h("button", {
                      type: "button",
                      onClick: () => handleSendWhatsAppOrder(selectedOrder),
                      className: "w-full text-left flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-bold text-emerald-700 hover:bg-emerald-50 cursor-pointer transition-colors"
                    }, [
                      h(Icon, { name: "whatsapp", className: "w-3.5 h-3.5 text-emerald-600" }),
                      h("span", {}, "Send to WhatsApp")
                    ]),
                    h("button", {
                      type: "button",
                      onClick: () => handleDuplicateOrder(selectedOrder),
                      className: "w-full text-left flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-bold text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 cursor-pointer transition-colors"
                    }, [
                      h(Icon, { name: "copy", className: "w-3.5 h-3.5 text-slate-400" }),
                      h("span", {}, "Duplicate Order")
                    ]),
                    h("button", {
                      type: "button",
                      onClick: () => { setOrderMoreDropdownOpen(false); setIsOrderActivityOpen(true); },
                      className: "w-full text-left flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-bold text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 cursor-pointer transition-colors"
                    }, [
                      h(Icon, { name: "clock", className: "w-3.5 h-3.5 text-slate-400" }),
                      h("span", {}, "View Activity / History")
                    ])
                  ]),
                  h("div", { className: "space-y-0.5 pt-1" }, [
                    selectedOrder.status === 'Cancelled' && (selectedOrder.stockAllocations || []).some(allocation=>allocation.consumedAt&&!allocation.restoredAt) && h("button", {
                      type:"button",
                      onClick:()=>{ setOrderMoreDropdownOpen(false); const authorizedMembers=team.filter(member=>/admin|owner|inventory|stock|manager/i.test(String(member.jobTitle||''))); if(!authorizedMembers.length){alert('Stock restore requires an Owner, Admin, Inventory, Stock, or Manager team role. Add an authorized member in Profile → Team.');return;} const pin=prompt('Authorized inventory PIN required:',''); if(pin===null)return; const member=authorizedMembers.find(entry=>String(entry.pin||'')===String(pin).replace(/\D/g,'')); if(!member){alert('Incorrect PIN or this team member is not authorized to restore stock.');return;} if(!confirm(`Restore previously consumed inventory for ${selectedOrder.orderNumber}? Use this only if materials were physically returned to stock.`))return; const result=storageService.restoreOrderStock(selectedOrder.id,member.name); if(result){setSelectedOrder(result.order);refresh();alert(`Restored ${result.restored} total material units.`);} },
                      className:"w-full text-left flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-bold text-emerald-700 hover:bg-emerald-50 cursor-pointer transition-colors"
                    }, [h(Icon,{name:"stock",className:"w-3.5 h-3.5 text-emerald-600"}), h("span",{},"Restore Consumed Stock")]),
                    selectedOrder.status !== 'Cancelled' && h("button", {
                      type: "button",
                      onClick: () => handleCancelOrder(selectedOrder),
                      className: "w-full text-left flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-bold text-amber-700 hover:bg-amber-50 cursor-pointer transition-colors"
                    }, [
                      h(Icon, { name: "alert", className: "w-3.5 h-3.5 text-amber-500" }),
                      h("span", {}, "Cancel Order")
                    ]),
                    h("button", {
                      type: "button",
                      onClick: () => handleDeleteOrder(selectedOrder),
                      className: "w-full text-left flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-bold text-rose-600 hover:bg-rose-50 cursor-pointer transition-colors"
                    }, [
                      h(Icon, { name: "trash", className: "w-3.5 h-3.5 text-rose-500" }),
                      h("span", {}, "Delete Order")
                    ])
                  ])
                ])
              ]),

              // Close [X] Button
              h("button", {
                type: "button",
                title: "Close Preview",
                onClick: () => { setOrderPrintDropdownOpen(false); setOrderMoreDropdownOpen(false); setSelectedOrder(null); },
                className: "flex h-8 w-8 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-400 hover:border-rose-200 hover:bg-rose-50 hover:text-rose-600 cursor-pointer transition-colors"
              }, h(Icon, { name: "x", className: "w-4 h-4" }))
            ])
          ]),

          // 2. SCROLLABLE BODY
          h("div", { className: "flex-1 overflow-y-auto p-4 sm:p-5 md:p-6 grid grid-cols-1 lg:grid-cols-[280px_minmax(0,1fr)] gap-5" }, [
            // LEFT SIDEBAR
            h("div", { className: "flex flex-col gap-4 lg:w-72 shrink-0" }, [
              // Client & Job Summary Box
              h("div", { className: "bg-white rounded-2xl border border-slate-200/90 p-4 shadow-2xs space-y-3" }, [
                h("div", { className: "flex items-center justify-between pb-3 border-b border-slate-100" }, [
                  h("h3", { className: "font-mono font-black text-base text-indigo-700 tracking-tight" }, selectedOrder.orderNumber),
                  h("button", {
                    type: "button",
                    onClick: () => copyToClipboard(selectedOrder.orderNumber, 'Job number copied'),
                    className: "inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-slate-100 hover:bg-indigo-50 text-[10px] font-bold text-slate-600 hover:text-indigo-700 cursor-pointer transition-colors",
                    title: "Copy Job Number"
                  }, [
                    h(Icon, { name: "copy", className: "w-3 h-3" }),
                    "Copy"
                  ])
                ]),
                h("div", { className: "space-y-1" }, [
                  h("div", { className: "text-base font-black text-slate-900 leading-snug" }, getOrderClientMeta(selectedOrder).clientName),
                  getOrderClientMeta(selectedOrder).companyName && getOrderClientMeta(selectedOrder).companyName !== getOrderClientMeta(selectedOrder).clientName && h("div", { className: "text-xs font-semibold text-slate-500" }, getOrderClientMeta(selectedOrder).companyName)
                ]),
                h("div", { className: "pt-2 border-t border-slate-100 space-y-1.5 text-xs text-slate-600" }, [
                  h("div", { className: "flex items-center gap-2" }, [
                    h("span", { className: "text-slate-400 font-bold" }, "Phone:"),
                    h("span", { className: "font-semibold" }, selectedOrder.orderContactPhone || selectedOrder.customerPhone || '—')
                  ]),
                  h("div", { className: "flex items-center gap-2" }, [
                    h("span", { className: "text-slate-400 font-bold" }, "Date:"),
                    h("span", { className: "font-semibold" }, `${storageService.formatDateForMode(selectedOrder.orderDate, settings.dateMode)}${selectedOrder.dueTime ? ` • ${selectedOrder.dueTime}` : ''}`)
                  ]),
                  orderCountdown(selectedOrder) && orderCountdown(selectedOrder).includes('overdue') && h("div", { className: "pt-1" }, [
                    h("span", { className: "inline-flex items-center px-2.5 py-1 rounded-lg text-[10px] font-black border bg-rose-50 text-rose-700 border-rose-200" }, orderCountdown(selectedOrder))
                  ])
                ])
              ]),

              // Workflow Status Card
              h("div", { className: "bg-white rounded-2xl border border-slate-200/90 p-4 shadow-2xs space-y-2.5" }, [
                h("div", { className: "text-[10px] font-black uppercase tracking-wider text-slate-400" }, "Workflow"),
                h("div", { className: "space-y-1.5" }, [
                  { status: 'In Design', label: '1. In Design' },
                  { status: 'Printing', label: '2. Printing' },
                  { status: 'Finishing', label: '3. Progress' },
                  { status: 'Done', label: '4. Done' },
                  { status: 'Pickup', label: '5. Pickup' },
                  { status: 'Delivery', label: '6. Delivery' },
                  { status: 'Mistake', label: '! Mistake' }
                ].map((st, idx) => {
                  const currentRank = STATUS_RANKS[selectedOrder.status] ?? 0;
                  const targetRank = STATUS_RANKS[st.status] ?? 0;
                  const isCurrent = selectedOrder.status === st.status || (st.status === 'Done' && ['Done', 'Ready'].includes(selectedOrder.status));
                  const isPast = targetRank < currentRank;
                  const isMistake = st.status === 'Mistake';
                  const isHandoff = ['Pickup', 'Delivery'].includes(st.status);
                  const isDoneLocked = ['Ready', 'Done', 'Pickup', 'Delivery'].includes(selectedOrder.status);
                  const isDisabled = isDoneLocked
                    ? !['Pickup', 'Delivery', 'Mistake'].includes(st.status)
                    : (isHandoff && !['Ready', 'Done', 'Pickup', 'Delivery'].includes(selectedOrder.status));

                  return h("button", {
                    key: st.status,
                    type: "button",
                    disabled: isDisabled,
                    onClick: () => {
                      const saveStatus = st.status === 'Done' ? 'Ready' : st.status;
                      handleQuickStatusChange(selectedOrder.id, saveStatus, st.status);
                    },
                    className: `w-full text-left px-3 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center justify-between ${
                      isDisabled ? 'opacity-35 cursor-not-allowed bg-slate-50 text-slate-400' :
                      isCurrent && isMistake ? 'bg-red-50 border border-red-300 text-red-900 font-black shadow-2xs cursor-pointer' :
                      isCurrent ? 'bg-indigo-50 border border-indigo-200 text-indigo-900 font-black shadow-2xs cursor-pointer' :
                      isMistake ? 'mt-2 border border-dashed border-red-200 text-red-700 hover:bg-red-50 cursor-pointer' :
                      isPast ? 'text-slate-700 hover:bg-slate-50 cursor-pointer' :
                      'text-slate-600 hover:bg-indigo-50/50 cursor-pointer'
                    }`
                  }, [
                    h("span", { className: "flex items-center gap-2" }, [
                      h("span", { className: `flex h-5 w-5 items-center justify-center rounded-full text-[10px] font-black ${isCurrent && isMistake ? 'bg-red-600 text-white' : isCurrent ? 'bg-indigo-600 text-white' : isMistake ? 'bg-red-100 text-red-700' : isPast ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-500'}` }, isMistake ? '!' : isCurrent ? '✓' : isPast ? '✓' : `${idx + 1}`),
                      st.label
                    ]),
                    isCurrent && h("span", { className: "text-[9px] font-black uppercase text-indigo-600" }, "Current")
                  ]);
                }))
              ])
            ]),

            // MAIN CONTENT COLUMN
            h("div", { className: "flex flex-col gap-5 min-w-0" }, [
              // 3. ORDER ITEMS SECTION
              (() => {
                const totalItemsCount = selectedOrder.items?.length || 0;
                const query = (orderItemSearch || '').trim().toLowerCase();
                const allItems = (selectedOrder.items || []).map((it, idx) => ({ ...it, originalIndex: idx }));
                const filteredItems = query
                  ? allItems.filter(it => 
                      String(it.productName || '').toLowerCase().includes(query) ||
                      String(it.itemDescription || '').toLowerCase().includes(query) ||
                      String(it.quantity || '').toLowerCase().includes(query) ||
                      String(it.unit || '').toLowerCase().includes(query)
                    )
                  : allItems;

                return h("div", { className: "bg-white rounded-2xl border border-slate-200/90 shadow-2xs overflow-hidden flex flex-col" }, [
                  // Top Header Bar with Count, Search & Add Item
                  h("div", { className: "px-4 sm:px-5 py-3 border-b border-slate-100 flex flex-wrap items-center justify-between gap-2.5 bg-slate-50/50 shrink-0" }, [
                    h("div", { className: "flex items-center gap-2" }, [
                      h("h4", { className: "text-sm font-black text-slate-900" }, "Order Items"),
                      h("span", { className: "px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 text-xs font-bold font-mono" },
                        query && filteredItems.length !== totalItemsCount
                          ? `${filteredItems.length} of ${totalItemsCount}`
                          : `${totalItemsCount}`
                      )
                    ]),
                    h("div", { className: "flex items-center gap-2 flex-1 sm:flex-initial justify-end" }, [
                      h("div", { className: "relative w-full sm:w-56" }, [
                        h(Icon, { name: "search", className: "w-3.5 h-3.5 absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none" }),
                        h("input", {
                          type: "text",
                          placeholder: "Search products...",
                          value: orderItemSearch,
                          onChange: (e) => setOrderItemSearch(e.target.value),
                          className: "w-full pl-8 pr-7 py-1.5 rounded-xl border border-slate-200 bg-white text-xs font-medium text-slate-800 placeholder-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 shadow-2xs transition-colors"
                        }),
                        orderItemSearch && h("button", {
                          type: "button",
                          onClick: () => setOrderItemSearch(''),
                          title: "Clear search",
                          className: "absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-0.5 cursor-pointer"
                        }, h(Icon, { name: "x", className: "w-3 h-3" }))
                      ]),
                      !['Printing', 'Finishing', 'Ready', 'Done', 'Pickup', 'Delivery', 'Cancelled'].includes(selectedOrder.status) && h("button", {
                        type: "button",
                        onClick: () => setIsAddItemToOrderOpen(v => !v),
                        className: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-2xs cursor-pointer transition-all shrink-0"
                      }, [
                        h(Icon, { name: "plus", className: "w-3.5 h-3.5" }),
                        isAddItemToOrderOpen ? "Close Form" : "Add Item"
                      ])
                    ])
                  ]),

                  // Inline Add Item Form
                  isAddItemToOrderOpen && h("form", {
                    onSubmit: (e) => {
                      e.preventDefault();
                      const f = e.target;
                      const selectedProductOption = resolveMasterProductOption(f.existingProduct.value);
                      const prodId = selectedProductOption.productId;
                      const prod = selectedProductOption.product;
                      if (!prod) return;
                      if (!selectedProductOption.variant && (prod.materials || []).some(material => material.variant && material.variant !== 'ALL')) {
                        alert('Choose a specific sub-option so the correct stock entry can be used.');
                        return;
                      }
                      const resolved = storageService.getEffectivePrice(prodId, selectedOrder.customerId).price;
                      const unitPrice = resolved;
                      const quantity = parseInt(f.existingQty.value, 10) || 1;
                      const newItem = {
                        id: 'item-' + Date.now(),
                        productId: prod.id,
                        productName: selectedProductOption.productName,
                        variant: selectedProductOption.variant,
                        unit: prod.unit,
                        itemDescription: f.existingDescription.value.trim(),
                        quantity,
                        unitPrice,
                        defaultPrice: prod.defaultPrice
                      };
                      newItem.lineTotal = storageService.calculateLineTotal(newItem);
                      const items = [...selectedOrder.items, newItem];
                      const updated = storageService.saveOrder({ ...selectedOrder, items, totalAmount: items.reduce((sum, it) => sum + Number(it.lineTotal || 0), 0) });
                      setSelectedOrder({ ...updated });
                      setIsAddItemToOrderOpen(false);
                      refresh();
                    },
                    className: "p-4 border-b border-indigo-100 bg-indigo-50/30 grid grid-cols-1 sm:grid-cols-2 gap-3 animate-fade-in shrink-0"
                  }, [
                    h("div", { className: "sm:col-span-2" }, [
                      h("label", { className: "block text-[10px] font-black uppercase text-slate-500 mb-1" }, "Product"),
                      h(SearchableSelect, {
                        name: "existingProduct",
                        placeholder: "Search or select product...",
                        options: [
                          { value: "", label: "-- Choose Product --" },
                          ...getMasterProductSelectOptions()
                        ],
                        required: true,
                        className: "w-full"
                      })
                    ]),
                    h("div", { className: "sm:col-span-2" }, [
                      h("label", { className: "block text-[10px] font-black uppercase text-slate-500 mb-1" }, "Description / Specifications"),
                      h(AutoGrowTextarea, { name: "existingDescription", minHeight: 48, maxHeight: 160, placeholder: "Dimensions, material, print specs...", className: "w-full p-2 border border-slate-200 rounded-xl text-xs whitespace-pre-wrap focus:ring-2 focus:ring-indigo-500 focus:outline-none" })
                    ]),
                    h("div", {}, [
                      h("label", { className: "block text-[10px] font-black uppercase text-slate-500 mb-1" }, "Quantity"),
                      h("input", { type: "number", name: "existingQty", defaultValue: 1, min: 1, required: true, className: "w-full p-2 border border-slate-200 rounded-xl text-xs font-bold bg-white" })
                    ]),
                    h("div", {}, [
                      h("label", { className: "block text-[10px] font-black uppercase text-slate-500 mb-1" }, "Pricing"),
                      h("div", { className: "w-full rounded-xl border border-slate-200 bg-slate-100 p-2 text-xs font-black text-slate-500 select-none" }, "Auto")
                    ]),
                    h("div", { className: "sm:col-span-2 flex justify-end gap-2 pt-1" }, [
                      h("button", { type: "button", onClick: () => setIsAddItemToOrderOpen(false), className: "px-3 py-1.5 text-xs font-bold text-slate-500 cursor-pointer" }, "Cancel"),
                      h("button", { type: "submit", className: "px-4 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold text-xs shadow-xs cursor-pointer" }, "+ Add to Order")
                    ])
                  ]),

                  // Fixed-height Scrollable Table Area (~5 rows height, max-h-[340px], overflow-y-auto, sticky header)
                  h("div", { className: "max-h-[340px] overflow-y-auto overflow-x-auto overscroll-contain" }, [
                    h("table", { className: "w-full min-w-[620px] text-left text-xs border-collapse" }, [
                      h("thead", { className: "sticky top-0 z-10 bg-slate-50 text-[10px] font-black uppercase tracking-wider text-slate-500 border-b border-slate-200 shadow-2xs" }, [
                        h("tr", {}, [
                          h("th", { className: "w-10 px-3 py-2.5 text-center bg-slate-50" }, "#"),
                          h("th", { className: "px-3 py-2.5 bg-slate-50" }, "Product / Description"),
                          h("th", { className: "w-24 px-3 py-2.5 text-center bg-slate-50" }, "Qty"),
                          h("th", { className: "w-28 px-3 py-2.5 text-right bg-slate-50" }, "Unit Price"),
                          h("th", { className: "w-28 px-3 py-2.5 text-right bg-slate-50" }, "Line Total"),
                          h("th", { className: "w-24 px-3 py-2.5 text-center bg-slate-50" }, "Status"),
                          h("th", { className: "w-16 px-3 py-2.5 text-center bg-slate-50" }, "Action")
                        ])
                      ]),
                      h("tbody", { className: "divide-y divide-slate-100 font-medium bg-white" },
                        filteredItems.length === 0
                          ? [
                              h("tr", { key: "empty-search" }, [
                                h("td", { colSpan: 7, className: "px-4 py-8 text-center text-xs text-slate-400 font-medium" },
                                  query
                                    ? `No products matching "${orderItemSearch}" found in this order.`
                                    : "No items in this order."
                                )
                              ])
                            ]
                          : filteredItems.map((it) => {
                              const isLocked = ['Printing', 'Finishing', 'Ready', 'Done', 'Pickup', 'Delivery', 'Cancelled'].includes(selectedOrder.status);
                              const isAfterDesign = it.knowAfterDesign || it.quantity === 0;
                              return h("tr", { key: `item-${it.id || it.originalIndex}`, className: "bg-white hover:bg-slate-50/60 transition-colors" }, [
                                h("td", { className: "px-3 py-3 text-center text-slate-400 font-mono" }, it.originalIndex + 1),
                                h("td", { className: "px-3 py-3" }, [
                                  h("div", { className: "font-bold text-slate-900" }, it.productName || "Product"),
                                  it.itemDescription && h("div", { className: "mt-0.5 text-[11px] text-slate-500 whitespace-pre-wrap leading-tight" }, it.itemDescription)
                                ]),
                                h("td", { className: "px-3 py-3 text-center" }, isAfterDesign ? h("span", { className: "rounded-md bg-amber-100 px-2 py-0.5 text-[9px] font-bold text-amber-900" }, "After Design") : h("span", { className: "font-mono font-semibold text-slate-700" }, `${it.quantity} ${it.unit || 'pcs'}`)),
                                h("td", { className: "px-3 py-3 text-right font-mono text-slate-600" }, storageService.formatCurrency(it.unitPrice)),
                                h("td", { className: "px-3 py-3 text-right font-mono font-bold text-slate-900" }, isAfterDesign ? h("span", { className: "text-[9px] font-bold text-amber-700" }, "Pending") : storageService.formatCurrency(it.lineTotal)),
                                h("td", { className: "px-3 py-3 text-center" }, isAfterDesign ? h("span", { className: "rounded-full bg-amber-50 border border-amber-200 px-2 py-0.5 text-[9px] font-bold text-amber-700" }, "Pending Specs") : h("span", { className: "rounded-full bg-emerald-50 border border-emerald-200 px-2 py-0.5 text-[9px] font-bold text-emerald-700" }, "Ready")),
                                h("td", { className: "px-3 py-3 text-center" }, [
                                  !isLocked && selectedOrder.items.length > 1 ? h("button", {
                                    type: "button",
                                    onClick: () => handleRemoveOrderItem(it.originalIndex),
                                    title: "Remove item",
                                    className: "p-1 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 cursor-pointer transition-colors"
                                  }, h(Icon, { name: "trash", className: "w-3.5 h-3.5" })) : h("span", { className: "text-slate-300 font-mono text-xs" }, "—")
                                ])
                              ]);
                            })
                      )
                    ])
                  ]),

                  // Fixed Bottom Grand Total (Always visible, outside scroll area)
                  h("div", { className: "px-5 py-3.5 bg-slate-50 border-t border-slate-200/90 flex items-center justify-between text-xs sm:text-sm font-bold shrink-0" }, [
