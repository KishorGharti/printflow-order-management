              const cleanVariants=productVariantOptions.map(value=>String(value || '').trim()).filter(Boolean).filter((value,index,list)=>list.indexOf(value)===index);
              const invalidVariantMaterial=productMaterials.find(material=>material.variant && material.variant !== 'ALL' && !cleanVariants.includes(material.variant));
