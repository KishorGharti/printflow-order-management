                  ))
                ])
          ])
        ])
      ]);
    };

    // Render Customers Tab (Featuring Explicit WhatsApp Number Field)
    // Clean client list and two-tab client workspace. Business logic remains in storageService.
    const renderCustomers = () => {
      const monthKey = (dateKey) => (settings.dateMode || 'AD') === 'BS'
        ? storageService.getADandBSDate(dateKey).bsFormatted.slice(0, 7)
        : String(dateKey || '').slice(0, 7);
      const monthLabel = (dateKey) => {
        if ((settings.dateMode || 'AD') === 'BS') {
          const parts = storageService.getADandBSDate(dateKey).bsFormatted.split('-');
          const names = ['Baisakh','Jestha','Ashadh','Shrawan','Bhadra','Ashwin','Kartik','Mangshir','Poush','Magh','Falgun','Chaitra'];
          return `${names[Math.max(0, Number(parts[1]) - 1)] || 'Nepali Month'} ${parts[0]} BS`;
        }
        const date = new Date(`${dateKey}T00:00:00`);
        return Number.isNaN(date.getTime()) ? 'Undated' : new Intl.DateTimeFormat('en-US', { month:'long', year:'numeric' }).format(date);
      };
      const paymentBadge = (method) => {
        const label = method === 'Pay' ? 'Cash' : (method || 'Pending');
        const tone = label === 'Cash' ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : label === 'Online' ? 'border-blue-200 bg-blue-50 text-blue-700' : label === 'Credit' ? 'border-amber-200 bg-amber-50 text-amber-800' : 'border-slate-200 bg-slate-50 text-slate-500';
        return h('span', { className:`inline-flex rounded-full border px-2.5 py-1 text-[10px] font-bold ${tone}` }, label);
      };

      if (selectedCustomer) {
        // Mistake orders are operational records only; exclude them from client jobs and statements.
        const custOrders = storageService.getOrdersByCustomerId(selectedCustomer.id).filter(order => order.status !== 'Mistake');
        const customerPricingMap = storageService.getCustomerPricingMap(selectedCustomer.id);
        const customPricingCount = customerPricingMap.size;
        const activeOrders = custOrders.filter(order => order.status !== 'Cancelled');
        const completedOrders = activeOrders.filter(order => ['Ready','Done','Pickup','Delivery'].includes(order.status));
        const monthGroups = [...new Map(custOrders.filter(order=>order.orderDate).sort((a,b)=>String(b.orderDate).localeCompare(String(a.orderDate))).map(order => [monthKey(order.orderDate), { key:monthKey(order.orderDate), label:monthLabel(order.orderDate) }])).values()];
        const balanceSheet = storageService.getClientBalanceSheet(selectedCustomer, custOrders, {
          fromDate:clientLedgerFrom,
          toDate:clientLedgerTo,
          ledgerType:clientLedgerType,
          dateMode:settings.dateMode
        });
        const totalBusiness = activeOrders.reduce((sum, order) => sum + Number(order.totalAmount || 0), 0);
        const sinceDate = selectedCustomer.createdAt ? String(selectedCustomer.createdAt).slice(0,10) : [...custOrders].sort((a,b)=>String(a.orderDate || '').localeCompare(String(b.orderDate || '')))[0]?.orderDate;
        const isActive = selectedCustomer.active !== false && selectedCustomer.status !== 'Inactive';
        const closingTone = balanceSheet.closingBalance > 0 ? 'text-rose-700' : balanceSheet.closingBalance < 0 ? 'text-violet-700' : 'text-emerald-700';
        const clientLedgerPaging = paginateCollection(balanceSheet.visibleEntries, clientLedgerPage, clientLedgerPageSize);
        const entryRows = clientLedgerPaging.items;
        const jobsQuery = clientJobsSearch.trim().toLowerCase();
        const filteredJobs = [...custOrders].filter(order => {
          if (clientJobsStatus !== 'ALL' && order.status !== clientJobsStatus && !(clientJobsStatus === 'Ready' && ['Ready','Done','Pickup'].includes(order.status))) return false;
          if (clientJobsPayment !== 'ALL' && (clientJobsPayment === 'Cash' ? !['Pay','Cash'].includes(order.paymentMethod) : order.paymentMethod !== clientJobsPayment)) return false;
          if (clientJobsMonth && monthKey(order.orderDate) !== clientJobsMonth) return false;
          if (!jobsQuery) return true;
          const productText = (order.items || []).map(item => `${item.productName || ''} ${item.itemDescription || ''}`).join(' ');
          return [order.orderNumber, order.customerName, order.orderContactName, order.customerPhone, productText].some(value => String(value || '').toLowerCase().includes(jobsQuery));
        }).sort((a,b)=>String(b.orderDate || '').localeCompare(String(a.orderDate || '')) || String(b.createdAt || '').localeCompare(String(a.createdAt || '')));
        const clientJobsPaging = paginateCollection(filteredJobs, clientJobsPage, clientJobsPageSize);
        const selectableVisibleJobs = clientJobsPaging.items.filter(order => order.status !== 'Cancelled');
        const allVisibleJobsSelected = selectableVisibleJobs.length > 0 && selectableVisibleJobs.every(order => clientBillingOrderIds.includes(order.id));
        const selectedBillingJobs = custOrders.filter(order => order.status !== 'Cancelled' && clientBillingOrderIds.includes(order.id));
        const selectedBillingTotal = selectedBillingJobs.reduce((sum,order)=>sum+Number(order.totalAmount||0),0);
        const jobsDue = activeOrders.reduce((sum, order) => sum + storageService.getOrderCreditAmount(order), 0);
        const jobKpis = [
          ['Total Jobs', custOrders.length, 'customers', 'text-slate-900', 'bg-slate-100 text-slate-600'],
          ['In Design', custOrders.filter(order=>['In Design','Design'].includes(order.status)).length, 'edit', 'text-violet-700', 'bg-violet-50 text-violet-600'],
          ['Printing', custOrders.filter(order=>order.status === 'Printing').length, 'printer', 'text-blue-700', 'bg-blue-50 text-blue-600'],
          ['Ready / Pickup', custOrders.filter(order=>['Ready','Done','Pickup'].includes(order.status)).length, 'check', 'text-emerald-700', 'bg-emerald-50 text-emerald-600'],
          ['Due Amount', storageService.formatCurrency(jobsDue), 'receipt', jobsDue > 0 ? 'text-rose-700' : 'text-emerald-700', jobsDue > 0 ? 'bg-rose-50 text-rose-600' : 'bg-emerald-50 text-emerald-600']
        ];
        const summaryCards = [
