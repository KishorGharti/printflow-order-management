    const getDueDayLabel = (dueDate, status) => {
      if (!dueDate || ['Ready', 'Done', 'Mistake', 'Cancelled'].includes(status)) return '';
      const today = new Date();
      today.setHours(0,0,0,0);
      const due = new Date(`${dueDate}T00:00:00`);
      if (isNaN(due.getTime())) return '';
      const days = Math.ceil((due.getTime() - today.getTime()) / 86400000);
      if (days < 0) return `${Math.abs(days)} day${Math.abs(days) === 1 ? '' : 's'} overdue`;
      if (days === 0) return 'Due today';
      return `${days} day${days === 1 ? '' : 's'} left`;
    };

    // Orders Tab
    const renderOrders = () => {
      const query = searchQuery.toLowerCase().trim();
      const monthKey = (dateKey) => (settings.dateMode || 'AD') === 'BS' ? storageService.getADandBSDate(dateKey).bsFormatted.slice(0, 7) : String(dateKey || '').slice(0, 7);
      const monthLabel = (dateKey) => {
        if ((settings.dateMode || 'AD') === 'BS') {
          const [year, month] = storageService.getADandBSDate(dateKey).bsFormatted.split('-');
          const names = ['Baisakh','Jestha','Ashadh','Shrawan','Bhadra','Ashwin','Kartik','Mangshir','Poush','Magh','Falgun','Chaitra'];
          return `${names[Math.max(0, Number(month) - 1)] || 'Nepali Month'} ${year} BS`;
        }
        const date = new Date(`${dateKey}T00:00:00`);
        return Number.isNaN(date.getTime()) ? 'Undated Orders' : new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' }).format(date);
      };
      const bsSearchComplete = /^\d{4}[-\/.]\d{1,2}[-\/.]\d{1,2}$/.test(orderHistoryDateSearch.trim());
      const historySearchAD = !orderHistoryDateSearch ? '' : (settings.dateMode || 'AD') === 'BS' ? (bsSearchComplete ? storageService.dateInputToAD(orderHistoryDateSearch) : '') : orderHistoryDateSearch;
      const groupedHistory = [...orders].sort((a,b) => String(b.orderDate || '').localeCompare(String(a.orderDate || ''))).reduce((map, order) => {
        const key = monthKey(order.orderDate);
        if (!map.has(key)) map.set(key, { key, label:monthLabel(order.orderDate), orders:[], firstDate:order.orderDate });
        map.get(key).orders.push(order);
        return map;
      }, new Map());
      const rawHistorySearch = orderHistoryMonthSearch.trim();
      const historySearchLooksLikeDate = /^\d{4}[-\/.]\d{1,2}[-\/.]\d{1,2}$/.test(rawHistorySearch);
      const monthSearch = (historySearchLooksLikeDate ? rawHistorySearch.replace(/[\/.]/g,'-').slice(0,7) : rawHistorySearch).toLowerCase();
      const historyMonthGroups = [...groupedHistory.values()].filter(group => !monthSearch || group.key.toLowerCase().includes(monthSearch) || group.label.toLowerCase().includes(monthSearch));
      const dateScopedOrders = orders.filter(o => orderDateFilter === 'TODAY' ? o.orderDate === todayStr : (!expandedOrderHistoryMonth || monthKey(o.orderDate) === expandedOrderHistoryMonth) && (!historySearchAD || o.orderDate === historySearchAD));
      const filtered = orders.filter(o => {
        const companyName = storageService.getCustomerById(o.customerId)?.businessName || '';
        const matchesQuery = String(o.orderNumber || '').toLowerCase().includes(query) ||
          String(o.customerName || '').toLowerCase().includes(query) ||
          String(o.orderContactName || '').toLowerCase().includes(query) ||
          String(companyName).toLowerCase().includes(query) ||
          String(o.customerPhone || '').toLowerCase().includes(query) ||
          String(o.orderContactPhone || '').toLowerCase().includes(query) ||
          (o.items || []).some(item => String(item.productName || '').toLowerCase().includes(query));

        if (!matchesQuery) return false;
        if (orderDateFilter === 'TODAY' && o.orderDate !== todayStr) return false;
        if (orderDateFilter === 'ALL' && expandedOrderHistoryMonth && monthKey(o.orderDate) !== expandedOrderHistoryMonth) return false;
        if (orderDateFilter === 'ALL' && historySearchAD && o.orderDate !== historySearchAD) return false;

        if (orderStatusFilter === 'ALL') return true;
        if (orderStatusFilter === 'IN_PROGRESS') return ['In Design', 'Design', 'Printing', 'Finishing'].includes(o.status);
        if (orderStatusFilter === 'READY_TO_GO') return o.status === 'Printing' || (o.media || []).some(m => m.category === 'Ready to Go');
        if (orderStatusFilter === 'Ready') return ['Ready', 'Done', 'Pickup', 'Delivery'].includes(o.status);
        return o.status === orderStatusFilter;
      }).sort((a, b) => String(b.orderDate || '').localeCompare(String(a.orderDate || '')) || String(b.createdAt || '').localeCompare(String(a.createdAt || '')));
