                h("div", { className:"rounded-xl bg-rose-50 p-3 text-center" }, [h("div", { className:"text-[8px] font-black uppercase text-rose-500" }, "Credit Left"), h("div", { className:"mt-1 font-mono text-xs font-black text-rose-700" }, storageService.formatCurrency(remainingDue))]),
                h("div", { className:"rounded-xl bg-indigo-50 p-3 text-center" }, [h("div", { className:"text-[8px] font-black uppercase text-indigo-500" }, "Advance"), h("div", { className:"mt-1 font-mono text-xs font-black text-indigo-700" }, storageService.formatCurrency(result.advanceAmount))])
              ]),
              result.allocations.length > 0 && h("div", { className:"max-h-56 overflow-y-auto rounded-2xl border border-slate-200" }, result.allocations.map((allocation,index)=>h("div", { key:allocation.orderId, className:"flex items-center justify-between gap-3 border-b border-slate-100 px-4 py-3 last:border-0" }, [
                h("div", { className:"flex items-center gap-3" }, [h("span", { className:"flex h-7 w-7 items-center justify-center rounded-lg bg-violet-100 text-[9px] font-black text-violet-700" }, index+1), h("div", {}, [h("div", { className:"font-mono text-xs font-black text-indigo-700" }, allocation.orderNumber), h("div", { className:"text-[9px] font-bold text-slate-400" }, allocation.dueAfter > 0 ? `${storageService.formatCurrency(allocation.dueAfter)} still due` : "Fully paid")])]),
                h("div", { className:"font-mono text-xs font-black text-emerald-700" }, `− ${storageService.formatCurrency(allocation.applied)}`)
              ]))),
              result.advanceAmount > 0 && h("div", { className:"rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-3 text-xs font-bold text-indigo-800" }, `${storageService.formatCurrency(result.advanceAmount)} was saved as client advance balance.`),
              h("div", { className: "space-y-2 pt-1" }, [
                h("button", {
                  type: "button",
                  onClick: async () => {
                    try {
                      const cust = storageService.getCustomerById(clientPaymentModal.customer?.id) || clientPaymentModal.customer;
                      if (!cust) return;
                      const customerOrders = storageService.getOrdersByCustomerId(cust.id);
                      const todayKey = getKathmanduDateKey();
                      const fromDate = `${todayKey.slice(0, 7)}-01`;
                      const generated = {
                        ...storageService.createClientStatementPdf(cust, customerOrders, {
                          fromDate,
                          toDate: todayKey,
                          ledgerType: 'ALL',
                          dateMode: settings.dateMode || 'AD',
                          headerColor: settings.balanceSheetHeaderColor || '#0026ff',
                          headerTextColor: settings.balanceSheetHeaderTextColor || '#ffffff',
                          footerColor: settings.balanceSheetFooterColor || '#0026ff',
                          footerTextColor: settings.balanceSheetFooterTextColor || '#ffffff',
                          alternateColor: settings.balanceSheetAlternateColor || '#f1f5f9',
                          alternateTint: settings.balanceSheetAlternateTint ?? 100
                        }),
                        dateMode: settings.dateMode || 'AD'
                      };

                      const cleanPhone = storageService.formatWhatsAppPhone(cust.whatsapp || cust.phone || '');
                      const clientName = (cust.businessName || cust.name || 'Valued Client').trim();
                      const msg = `Namaste ${clientName} 🙏\n\nWe have recorded your payment of *Rs. ${Number(result.receivedAmount).toLocaleString()}* via *${clientPaymentModal.method || 'Payment'}* on ${storageService.formatDateForMode(result.receivedAt, settings.dateMode)}.\n*Remaining Due Balance:* Rs. ${Number(remainingDue).toLocaleString()}.\n\n📄 Your full Ledger Statement PDF is attached.\n\nThank you!\n– PrintGhar`;

                      // Try Web Share API first (works on mobile — can share PDF directly into WhatsApp)
                      const pdfFile = new File([generated.blob], generated.filename, { type: 'application/pdf' });
                      const canShare = typeof navigator.share === 'function' && typeof navigator.canShare === 'function' && navigator.canShare({ files: [pdfFile] });

                      if (canShare) {
                        try {
                          await navigator.share({ files: [pdfFile], title: `${clientName} — Payment Ledger`, text: msg });
                          setClientPaymentModal(null);
                          return;
                        } catch (shareErr) {
                          if (shareErr?.name === 'AbortError') return; // user cancelled
                          // Fall through to manual method
                        }
                      }

                      // Fallback: Download PDF + open WhatsApp with customer's number
                      const link = document.createElement('a');
                      link.href = URL.createObjectURL(generated.blob);
                      link.download = generated.filename;
                      document.body.appendChild(link);
                      link.click();
                      setTimeout(() => { link.remove(); URL.revokeObjectURL(link.href); }, 2000);

                      // Open WhatsApp with customer's phone number (wa.me works for both app and web)
                      if (cleanPhone) {
                        const waUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(msg)}`;
                        const opened = window.open(waUrl, '_blank', 'noopener,noreferrer');
                        if (!opened) {
                          const a = document.createElement('a');
                          a.href = waUrl; a.target = '_blank'; a.rel = 'noopener noreferrer';
                          document.body.appendChild(a); a.click(); setTimeout(() => a.remove(), 200);
                        }
                      }

                      // Open statement preview inside Print Ghar
                      setClientPaymentModal(null);
                      openPdfPreview(generated, { allowShare: true, shareFallback: true });
                    } catch (err) {
                      console.error('Send ledger error:', err);
                      alert(err.message || 'Unable to generate ledger statement.');
                    }
                  },
                  className: "w-full flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-3 text-sm font-black text-white hover:bg-emerald-700 cursor-pointer shadow-sm transition-all"
                }, [
