            ])
          ]),

          isAddStockOpen && h("form", {
            onSubmit: (e) => {
              e.preventDefault();
              const f = e.currentTarget;
              const name = f.stockName.value.trim();
              const quantity = Math.max(0, parseInt(f.stockQty.value, 10) || 0);
              const unit = f.stockUnit.value;
              const alertValue = String(f.stockAlert.value || '').trim();
              const inheritedAlert = stock.find(item=>item.id===(stockParentId || editingStockItem?.parentId))?.lowStockThreshold ?? 5;
              const threshold = alertValue === '' ? Math.max(0, Number(inheritedAlert)) : Math.max(0, parseInt(alertValue, 10) || 0);
              const notes = f.stockNotes.value.trim();
              if (!name) return;
              const parentId = stockParentId || editingStockItem?.parentId || '';
              const parent = stock.find(item => item.id === parentId);
              storageService.saveStockItem({ ...editingStockItem, name, quantity, unit, lowStockThreshold: threshold, notes, parentId, parentName:parent?.name || '' });
              f.reset();
              setEditingStockItem(null);
              setStockParentId('');
              setIsAddStockOpen(false);
