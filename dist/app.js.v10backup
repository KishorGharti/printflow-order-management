              h("div", {}, [h("div", { className: "text-[10px] font-black uppercase tracking-[.16em] text-indigo-600" }, "New Production Job"), h("h3", { className: "font-black text-xl text-slate-950" }, "Create New Print Order"), h("p", { className: "text-xs text-slate-500 mt-0.5" }, "Client, products and delivery schedule in one job.")])
            ]),
            h("button", { type: "button", onClick: () => { setNewOrderItems([]); setNewOrderMedia([]); setMediaError(''); setNewOrderErrors({}); setNewOrderProductId(''); setNewOrderVariantQuantities({}); setIsNewOrderModalOpen(false); }, className: "w-9 h-9 flex items-center justify-center rounded-xl border border-slate-200 bg-slate-50 text-slate-400 hover:text-slate-700 cursor-pointer" }, h(Icon, { name: "x" }))
          ]),

          h("form", {
            onSubmit: async (e) => {
              e.preventDefault();
              const form = e.currentTarget;
              const errors = {};
              const custId = form.customerSelect.value;
              const cust = storageService.getCustomerById(custId);
              if (!cust) errors.customer = 'Please select a client.';

              // Only products explicitly added with “Add This Product” are saved.
              // This avoids accidental duplicate products and makes multi-product orders predictable.
              const allItems = [...newOrderItems];
              if (allItems.length === 0) {
                const selectedProductOption = resolveMasterProductOption(form.productSelect.value);
                const prodId = selectedProductOption.productId;
                const prod = selectedProductOption.product;
                if (!prod) {
                  errors.product = 'Please select a product.';
                } else {
                  const resolved = storageService.getEffectivePrice(prodId, custId).price;
                  const unitPrice = resolved;
                  const quantity = parseInt(form.quantity.value, 10) || 1;
                  if (selectedProductOption.isMixed) {
                    const allocations=(prod.variants || []).map(variant=>({variant,quantity:Math.max(0,parseInt(newOrderVariantQuantities[variant],10)||0)})).filter(entry=>entry.quantity>0);
                    const allocatedTotal=allocations.reduce((sum,entry)=>sum+entry.quantity,0);
                    if (!allocations.length) errors.product='Enter a quantity for at least one sub-option.';
                    else if (allocatedTotal !== quantity) errors.product=`Sub-option quantities total ${allocatedTotal}, but ordered quantity is ${quantity}.`;
                    else allocations.forEach(entry=>{const item={id:createId('draft'),productId:prod.id,productName:`${prod.name} — ${entry.variant}`,variant:entry.variant,unit:prod.unit,itemDescription:form.itemDesc.value.trim(),productionType:prod.productionType || 'In Store',quantity:entry.quantity,unitPrice,defaultPrice:prod.defaultPrice};item.lineTotal=storageService.calculateLineTotal(item);allItems.push(item);});
                  } else if (!selectedProductOption.variant && (prod.materials || []).some(material=>material.variant && material.variant !== 'ALL')) {
                    errors.product='Choose a specific sub-option or Mixed variants for this product.';
                  } else {
                    const item = { id: createId('draft'), productId: prod.id, productName:selectedProductOption.productName, variant:selectedProductOption.variant, unit: prod.unit, itemDescription: form.itemDesc.value.trim(), productionType: prod.productionType || 'In Store', quantity, unitPrice, defaultPrice: prod.defaultPrice };
                    item.lineTotal = storageService.calculateLineTotal(item);
                    allItems.push(item);
                  }
                }
              }
              const orderNum = storageService.generateNextOrderNumber();
              const orderDate = getKathmanduDateKey(new Date());
              const dueDate = storageService.dateInputToAD(form.dueDate.value);
              if (!dueDate) errors.dueDate = `Enter a valid ${settings.dateMode || 'AD'} due date. Day must exist in the selected month.`;
              if (orderDate && dueDate && dueDate < orderDate) errors.dueDate = 'Due date cannot be before the order date.';
              if (Object.keys(errors).length) { setNewOrderErrors(errors); return; }
              const shortageItems = storageService.calculateStockImpact(allItems).filter(impact => impact.trackingMode === 'AUTO' && impact.shortage > 0);
              if (shortageItems.length && !confirm(`Stock shortage warning:\n\n${shortageItems.map(item=>`${item.inventoryItemName}: short by ${item.shortage} ${item.unit}`).join('\n')}\n\nContinue and reserve the required stock?`)) return;
              setNewOrderErrors({});
              setIsSavingOrder(true);
              try {
                await mediaStore.putMany(newOrderMedia);
              } catch (error) {
                setMediaError(error.message || 'Unable to save the attached files.');
                setIsSavingOrder(false);
                return;
              }
              const savedOrder = storageService.saveOrder({
                orderNumber: orderNum,
                customerId: cust.id,
                customerName: cust.businessName || cust.name,
                customerPhone: cust.phone,
                customerEmail: cust.email,
                customerWhatsapp: cust.whatsapp || cust.phone,
                orderContactName: (cust.id === PROFILE_CLIENT_ID || cust.isProfileAccount) ? (form.orderContactName?.value.trim() || '') : '',
                orderContactPhone: (cust.id === PROFILE_CLIENT_ID || cust.isProfileAccount) ? (form.orderContactPhone?.value.replace(/\D/g, '') || '') : '',
                items: allItems,
                totalAmount: allItems.reduce((sum, it) => sum + Number(it.lineTotal || 0), 0),
                orderDate,
                dueDate,
                dueTime: form.dueTime.value || '17:00',
                status: 'New',
                media: newOrderMedia.map(({ id, name, type, size, extension }) => ({ id, name, type, size, extension, category: 'Client Reference', uploadedAt: new Date().toISOString() }))
              });
              const isWalkInOrder = cust.id === PROFILE_CLIENT_ID || cust.isProfileAccount;
              if (!isWalkInOrder || confirm(`Send WhatsApp order message to ${savedOrder.orderContactName || 'this walk-in customer'} now?`)) {
                storageService.sendWhatsAppStatusUpdate(savedOrder, 'New', 'new_order');
              }
              setNewOrderItems([]);
              setNewOrderMedia([]);
              setNewOrderProductId('');
              setNewOrderVariantQuantities({});
              setMediaError('');
              setIsSavingOrder(false);
              refresh();
              setIsNewOrderModalOpen(false);
            },
            className: "min-w-0 p-3 sm:p-6 grid grid-cols-1 lg:grid-cols-2 gap-x-8 gap-y-4 sm:gap-y-5 items-start text-xs"
          }, [
            h("div", { className:"min-w-0 space-y-4 sm:space-y-5" }, [
            h("div", { className: "min-w-0 lg:col-start-1 lg:row-start-1 bg-white p-3 sm:p-4 rounded-2xl border border-slate-200 space-y-2 shadow-sm" }, [
              h("div", { className: "flex flex-col items-start gap-1.5 sm:flex-row sm:justify-between sm:items-center" }, [
                h("label", { className: "font-bold uppercase text-slate-700 flex items-center gap-1" }, [
                  h(Icon, { name: "user", className: "w-4 h-4 text-indigo-600" }),
                  "Select Client *"
                ]),
                h("button", {
                  type: "button",
                  onClick: () => {
                    setEditingCustomer(null);
                    setIsCustomerModalOpen(true);
                  },
                  className: "text-indigo-600 font-bold hover:underline flex items-center gap-1 cursor-pointer"
                }, "+ Quick Add Client")
              ]),
              h(SearchableSelect, {
                name: "customerSelect",
                placeholder: "Search or select client...",
                value: newOrderCustomerId,
                onChange: (val) => {
                  setNewOrderCustomerId(val);
                  setNewOrderErrors(prev => ({...prev, customer: ''}));
                },
                options: customers.map(c => ({
                  value: c.id,
                  label: (c.id === PROFILE_CLIENT_ID || c.isProfileAccount) ? `${c.businessName || c.name} — Direct / Walk-in Client` : (c.businessName || c.name),
                  subtext: c.phone || c.email
                })),
                error: Boolean(newOrderErrors.customer),
                className: "w-full"
              }),
              newOrderCustomerId && (() => {
                const orderClient = customers.find(client => client.id === newOrderCustomerId);
                if (!orderClient || (orderClient.id !== PROFILE_CLIENT_ID && !orderClient.isProfileAccount)) return null;
                return h("div", { className:"mt-3 rounded-xl border border-indigo-200 bg-indigo-50/60 p-3" }, [
                  h("div", { className:"mb-2" }, [h("div", { className:"text-[10px] font-black uppercase tracking-wide text-indigo-700" }, "Walk-in Client"), h("div", { className:"mt-0.5 text-[10px] font-semibold text-slate-500" }, "Client details for this order only")]),
                  h("div", { className:"grid grid-cols-1 sm:grid-cols-2 gap-3" }, [
                    h("div", {}, [h("label", { className:"mb-1 block text-[10px] font-black uppercase text-slate-500" }, "Client Name *"), h("input", { name:"orderContactName", required:true, placeholder:"Client name", className:"w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-bold outline-none focus:ring-2 focus:ring-indigo-500" })]),
                    h("div", {}, [h("label", { className:"mb-1 block text-[10px] font-black uppercase text-slate-500" }, "Phone Number *"), h("input", { name:"orderContactPhone", type:"tel", inputMode:"numeric", pattern:"[0-9]*", onInput:e=>{e.currentTarget.value=e.currentTarget.value.replace(/\D/g,'');}, required:true, placeholder:"98XXXXXXXX", className:"w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-bold outline-none focus:ring-2 focus:ring-indigo-500" })])
                  ]),
                  h("div", { className:"mt-2 flex items-center gap-2 text-[10px] font-bold text-emerald-700" }, [h(Icon,{name:"whatsapp",className:"w-3.5 h-3.5"}), "After saving, you will be asked before WhatsApp opens."])
                ]);
