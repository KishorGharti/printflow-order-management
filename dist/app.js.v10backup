            h("p", { className:"mt-1 text-sm text-slate-500" }, "Open a stock product to list, add and edit its entries.")
          ]),
          h("div", { className:"flex" }, [
            h("button", { type:"button", onClick:()=>{setEditingStockItem(null);setStockParentId('');setIsAddStockOpen(true);}, className:"inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-xs font-black text-white shadow-sm hover:bg-indigo-700" }, [h(Icon,{name:"plus",className:"h-4 w-4"}), "Add Product"])
          ])
        ]),
        h("section", { className:"grid grid-cols-2 gap-3 lg:grid-cols-4" }, [
          [["Stock products",totalSkus,"text-slate-950"],["Stock entries",entryCount,"text-indigo-700"],["Healthy",healthyStock,"text-emerald-700"],["Low stock",lowStock,lowStock?'text-rose-700':'text-slate-950']].map(([label,value,color])=>
            h("div", { key:label, className:"rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-xs" }, [
              h("p", { className:"text-[10px] font-bold uppercase tracking-wider text-slate-400" }, label),
              h("p", { className:`mt-1 font-mono text-2xl font-black ${color}` }, value)
            ])
          )
        ]),

        // Low Stock Urgent Alert Bar (if any item is low)
        lowStock > 0 && h("div", { className: "flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 rounded-2xl border border-rose-200 bg-rose-50/90 p-4 text-rose-900 shadow-xs" }, [
          h("div", { className: "flex items-center gap-3" }, [
            h("div", { className: "flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-rose-100 text-rose-600 shadow-xs" }, h(Icon, { name: "alert", className: "w-5 h-5" })),
            h("div", {}, [
              h("p", { className: "text-sm font-black text-rose-950" }, `${lowStock} material${lowStock === 1 ? '' : 's'} need attention`),
              h("p", { className: "text-xs font-medium text-rose-700 mt-0.5" }, "Available stock is at or below its alert level.")
            ])
          ]),
          h("div", { className: "flex items-center gap-2 shrink-0" }, [
            h("button", {
              type: "button",
              onClick: () => {
                setStockStatusFilter(stockStatusFilter === 'LOW' ? 'ALL' : 'LOW');
                setStockTablePage(1);
              },
              className: `px-4 py-2 rounded-xl text-xs font-black shadow-xs transition-all cursor-pointer ${
                stockStatusFilter === 'LOW'
                  ? 'bg-rose-900 text-white hover:bg-rose-950'
                  : 'bg-rose-600 text-white hover:bg-rose-700'
              }`
            }, stockStatusFilter === 'LOW' ? "Show All Items" : "View Low Stock Only")
          ])
        ]),

        // Stock product / entry popup.
