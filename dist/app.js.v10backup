            profileTopic === 'date-appearance' && h("form", {
              onSubmit: (e) => {
                e.preventDefault();
                const f = e.currentTarget;
                const nextMode = f.dateMode.value;
                storageService.saveSettings({ ...settings, dateMode: nextMode });
                setDateMode(nextMode);
                const today = getKathmanduDateKey(new Date());
                setFinancialLedgerMonth(nextMode === 'BS' ? storageService.getADandBSDate(today).bsFormatted.slice(0, 7) : today.slice(0, 7));
                setSettings(storageService.getSettings());
                refresh();
                showFeedback(`✓ Calendar updated to ${nextMode === 'BS' ? 'Bikram Sambat (BS)' : 'Gregorian (AD)'}!`);
              },
              className: "bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-6"
            }, [
